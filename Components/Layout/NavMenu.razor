@inject OpensshUI.Services.Auth.UserSessionState SessionState
@inject ILocalizationService L
@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand d-inline-flex align-items-center gap-2 fw-bold" href="">
            <i class="bi bi-shield-lock-fill text-primary fs-4"></i>
            <span>OpensshUI Admin</span>
        </a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column py-2">
        <div class="nav-section-title px-3">@L["Nav.SectionOverview"]</div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <i class="bi bi-speedometer2"></i>
                <span>@L["Nav.Dashboard"]</span>
            </NavLink>
        </div>

        <div class="nav-section-title px-3 mt-3">@L["Nav.SectionAccess"]</div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="users">
                <i class="bi bi-people-fill"></i>
                <span>@L["Nav.Users"]</span>
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="groups">
                <i class="bi bi-collection-fill"></i>
                <span>@L["Nav.Groups"]</span>
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="files">
                <i class="bi bi-folder2-open"></i>
                <span>@L["Nav.Files"]</span>
            </NavLink>
        </div>

        <div class="nav-section-title px-3 mt-3">@L["Nav.SectionSystem"]</div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="service">
                <i class="bi bi-hdd-network-fill"></i>
                <span>@L["Nav.Service"]</span>
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="sessions">
                <i class="bi bi-diagram-2-fill"></i>
                <span>@L["Nav.Sessions"]</span>
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="ssh-logs">
                <i class="bi bi-terminal-split"></i>
                <span>@L["Nav.SshLogs"]</span>
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="audit">
                <i class="bi bi-journal-text"></i>
                <span>@L["Nav.AuditLogs"]</span>
            </NavLink>
        </div>

        @if (SessionState.CanManageSystem)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="web-admins">
                    <i class="bi bi-person-badge-fill"></i>
                    <span>@L["Nav.WebAdmins"]</span>
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="settings">
                    <i class="bi bi-gear-fill"></i>
                    <span>@L["Nav.Settings"]</span>
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    protected override void OnInitialized()
    {
        L.OnLanguageChanged += StateHasChanged;
    }

    public void Dispose()
    {
        L.OnLanguageChanged -= StateHasChanged;
    }
}
