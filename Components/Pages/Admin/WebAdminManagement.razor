<!-- Modal 3: Reset Password Modal (Local Admins only)               -->
<!-- ============================================================== -->
@if (showResetPassModal && editingAdmin != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0 rounded-4 overflow-hidden">
                <div class="modal-header bg-light border-bottom py-3">
                    <h6 class="modal-title fw-bold mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-key-fill text-primary"></i>
                        <span>ตั้งรหัสผ่านใหม่สำหรับ '@editingAdmin.Username'</span>
                    </h6>
                    <button type="button" class="btn-close" @onclick="() => showResetPassModal = false"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-bold mb-1">รหัสผ่านใหม่ <span class="text-danger">*</span></label>
                        <input type="password" class="form-control form-control-sm" placeholder="อย่างน้อย 8 ตัวอักษร"
                               @bind="resetNewPassword" @bind:event="oninput" />
                    </div>
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label small fw-bold mb-0">ยืนยันรหัสผ่านใหม่ <span class="text-danger">*</span></label>
                            @if (!string.IsNullOrEmpty(resetNewPassword) || !string.IsNullOrEmpty(resetConfirmPassword))
                            {
                                @if (resetNewPassword == resetConfirmPassword && resetNewPassword.Length >= 8)
                                {
                                    <span class="text-success small fw-bold" style="font-size: 0.7rem;"><i class="bi bi-check-circle-fill"></i> ตรงกัน</span>
                                }
                                else
                                {
                                    <span class="text-danger small fw-bold" style="font-size: 0.7rem;"><i class="bi bi-x-circle-fill"></i> ไม่ตรงกัน/สั้นเกินไป</span>
                                }
                            }
                        </div>
                        <input type="password" class="form-control form-control-sm" placeholder="พิมพ์รหัสผ่านอีกครั้ง"
                               @bind="resetConfirmPassword" @bind:event="oninput" />
                    </div>
                </div>
                <div class="modal-footer bg-light border-top py-2.5">
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => showResetPassModal = false">ยกเลิก</button>
                    <button type="button" class="btn btn-sm btn-primary px-3"
                            disabled="@(string.IsNullOrWhiteSpace(resetNewPassword) || resetNewPassword.Length < 8 || resetNewPassword != resetConfirmPassword || isSaving)"
                            @onclick="SaveResetPassword">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        <span>บันทึกรหัสผ่านใหม่</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<WebAdminUser>? admins;
    private bool isLoading = true;
    private string searchTerm = "";
    private string selectedFilter = "all";
    private string? alertMessage;
    private bool isAlertSuccess;
    private bool isSaving;

    // Create Modal state
    private bool showCreateModal;
    private string? modalErrorMessage;
    private WebAdminType newAccountType = WebAdminType.ActiveDirectory;
    private WebAdminRole selectedNewRole = WebAdminRole.SuperAdmin;

    // AD Search state
    private string adSearchQuery = "";
    private bool isSearchingAd;
    private List<AdUserInfo> adSearchResults = new();
    private string? selectedAdUsername;
    private string? selectedAdDisplayName;
    private string? selectedAdEmail;

    // Local form state
    private string localUsername = "";
    private string localDisplayName = "";
    private string localEmail = "";
    private string localPassword = "";
    private string localConfirmPassword = "";

    // Edit Role state
    private bool showEditRoleModal;
    private WebAdminUser? editingAdmin;
    private WebAdminRole targetEditRole;

    // Reset Password state
    private bool showResetPassModal;
    private string resetNewPassword = "";
    private string resetConfirmPassword = "";

    private List<WebAdminUser> FilteredAdmins
    {
        get
        {
            if (admins == null) return new();

            var query = admins.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var term = searchTerm.Trim().ToLower();
                query = query.Where(a =>
                    a.Username.ToLower().Contains(term) ||
                    a.DisplayName.ToLower().Contains(term) ||
                    (a.Email != null && a.Email.ToLower().Contains(term)));
            }

            if (selectedFilter == "local")
                query = query.Where(a => a.AccountType == WebAdminType.Local);
            else if (selectedFilter == "ad")
                query = query.Where(a => a.AccountType == WebAdminType.ActiveDirectory);
            else if (selectedFilter == "inactive")
                query = query.Where(a => !a.IsActive);

            return query.ToList();
        }
    }

    private bool IsCreateFormValid
    {
        get
        {
            if (newAccountType == WebAdminType.ActiveDirectory)
            {
                return !string.IsNullOrWhiteSpace(selectedAdUsername);
            }
            else
            {
                return !string.IsNullOrWhiteSpace(localUsername) &&
                       localUsername.Length >= 3 &&
                       !string.IsNullOrWhiteSpace(localDisplayName) &&
                       !string.IsNullOrWhiteSpace(localPassword) &&
                       localPassword.Length >= 8 &&
                       localPassword == localConfirmPassword;
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAdmins();
    }

    private async Task LoadAdmins()
    {
        isLoading = true;
        try
        {
            admins = await AdminService.GetAllAdminsAsync();
        }
        catch (Exception ex)
        {
            SetAlert($"ไม่สามารถโหลดรายชื่อผู้ดูแลระบบได้: {ex.Message}", false);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenCreateModal()
    {
        modalErrorMessage = null;
        newAccountType = WebAdminType.ActiveDirectory;
        selectedNewRole = WebAdminRole.SuperAdmin;
        adSearchQuery = "";
        adSearchResults.Clear();
        selectedAdUsername = null;
        selectedAdDisplayName = null;
        selectedAdEmail = null;
        localUsername = "";
        localDisplayName = "";
        localEmail = "";
        localPassword = "";
        localConfirmPassword = "";
        showCreateModal = true;
    }

    private void CloseCreateModal()
    {
        showCreateModal = false;
        modalErrorMessage = null;
    }

    private void SwitchAccountType(WebAdminType type)
    {
        newAccountType = type;
        modalErrorMessage = null;
    }

    private async Task HandleAdSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchAdUsers();
        }
    }

    private async Task SearchAdUsers()
    {
        if (string.IsNullOrWhiteSpace(adSearchQuery)) return;
        isSearchingAd = true;
        modalErrorMessage = null;
        adSearchResults.Clear();

        try
        {
            var res = await LdapAuth.SearchAdUsersAsync(adSearchQuery);
            if (res.Success)
            {
                adSearchResults = res.Users;
                if (adSearchResults.Count == 0)
                {
                    modalErrorMessage = "ไม่พบบัญชีผู้ใช้ใน Active Directory ที่ตรงกับคำค้นหา";
                }
            }
            else
            {
                modalErrorMessage = res.Message;
            }
        }
        catch (Exception ex)
        {
            modalErrorMessage = $"ค้นหา AD ผิดพลาด: {ex.Message}";
        }
        finally
        {
            isSearchingAd = false;
        }
    }

    private void SelectAdUser(AdUserInfo user)
    {
        selectedAdUsername = user.SamAccountName;
        selectedAdDisplayName = user.DisplayName;
        selectedAdEmail = user.Email;
        adSearchResults.Clear();
    }

    private void ClearSelectedAdUser()
    {
        selectedAdUsername = null;
        selectedAdDisplayName = null;
        selectedAdEmail = null;
    }

    private async Task SaveNewAdmin()
    {
        if (!IsCreateFormValid) return;
        isSaving = true;
        modalErrorMessage = null;

        var currentOp = string.IsNullOrEmpty(SessionState.CurrentUsername) ? "admin" : SessionState.CurrentUsername;

        try
        {
            WebAdminOperationResult result;
            if (newAccountType == WebAdminType.ActiveDirectory)
            {
                result = await AdminService.CreateAdAdminAsync(
                    selectedAdUsername!,
                    selectedAdDisplayName ?? selectedAdUsername!,
                    selectedAdEmail,
                    selectedNewRole,
                    currentOp);
            }
            else
            {
                result = await AdminService.CreateLocalAdminAsync(
                    localUsername,
                    localDisplayName,
                    localEmail,
                    localPassword,
                    selectedNewRole,
                    currentOp);
            }

            if (result.Success)
            {
                CloseCreateModal();
                SetAlert(result.Message, true);
                await LoadAdmins();
            }
            else
            {
                modalErrorMessage = result.Message;
            }
        }
        catch (Exception ex)
        {
            modalErrorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private void OpenEditRoleModal(WebAdminUser admin)
    {
        editingAdmin = admin;
        targetEditRole = admin.Role;
        showEditRoleModal = true;
    }

    private async Task SaveEditRole()
    {
        if (editingAdmin == null) return;
        isSaving = true;

        var currentOp = string.IsNullOrEmpty(SessionState.CurrentUsername) ? "admin" : SessionState.CurrentUsername;
        var res = await AdminService.UpdateRoleAsync(editingAdmin.Id, targetEditRole, currentOp);
        isSaving = false;
        showEditRoleModal = false;

        SetAlert(res.Message, res.Success);
        if (res.Success)
        {
            await LoadAdmins();
        }
    }

    private void OpenResetPasswordModal(WebAdminUser admin)
    {
        editingAdmin = admin;
        resetNewPassword = "";
        resetConfirmPassword = "";
        showResetPassModal = true;
    }

    private async Task SaveResetPassword()
    {
        if (editingAdmin == null) return;
        if (string.IsNullOrWhiteSpace(resetNewPassword) || resetNewPassword != resetConfirmPassword) return;

        isSaving = true;
        var currentOp = string.IsNullOrEmpty(SessionState.CurrentUsername) ? "admin" : SessionState.CurrentUsername;
        var res = await AdminService.ResetPasswordAsync(editingAdmin.Id, resetNewPassword, currentOp);
        isSaving = false;
        showResetPassModal = false;

        SetAlert(res.Message, res.Success);
    }

    private async Task ToggleAdminStatus(WebAdminUser admin)
    {
        var currentOp = string.IsNullOrEmpty(SessionState.CurrentUsername) ? "admin" : SessionState.CurrentUsername;
        var res = await AdminService.ToggleStatusAsync(admin.Id, currentOp);
        SetAlert(res.Message, res.Success);
        if (res.Success)
        {
            await LoadAdmins();
        }
    }

    private async Task ConfirmDeleteAdmin(WebAdminUser admin)
    {
        var currentOp = string.IsNullOrEmpty(SessionState.CurrentUsername) ? "admin" : SessionState.CurrentUsername;
        var res = await AdminService.DeleteAdminAsync(admin.Id, currentOp);
        SetAlert(res.Message, res.Success);
        if (res.Success)
        {
            await LoadAdmins();
        }
    }

    private void SetAlert(string msg, bool success)
    {
        alertMessage = msg;
        isAlertSuccess = success;
    }
}
