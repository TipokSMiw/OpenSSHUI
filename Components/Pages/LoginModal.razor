@inject ILdapAuthService LdapAuth
@inject UserSessionState SessionState
@inject IAuditService AuditService

@if (IsOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title d-flex align-items-center gap-2">
                        <i class="bi bi-shield-lock text-primary"></i>
                        <span>Admin Login</span>
                    </h5>
                    @if (CanClose)
                    {
                        <button type="button" class="btn-close btn-close-white" @onclick="Close"></button>
                    }
                </div>
                <div class="modal-body p-4">
                    <p class="text-muted small mb-3">
                        เข้าสู่ระบบด้วยบัญชี <strong>Active Directory (Domain)</strong> หรือ <strong>Local Admin</strong> เพื่อจัดการ SFTP Server
                    </p>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger py-2 small d-flex align-items-center gap-2">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <span>@errorMessage</span>
                        </div>
                    }

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label fw-bold small mb-0">Username <span class="text-danger">*</span></label>
                            <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle" style="font-size: 0.7rem;">AD หรือ Local</span>
                        </div>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                            <input type="text" class="form-control" @bind="username" @bind:event="oninput" @onkeyup="HandleKeyUp" placeholder="เช่น admin หรือ domain\sftp_admin" autofocus />
                        </div>
                    </div>

                    <div class="mb-2">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label fw-bold small mb-0">Password <span class="text-danger">*</span></label>
                        </div>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-key"></i></span>
                            <input type="@(showPassword ? "text" : "password")" class="form-control" @bind="password" @bind:event="oninput" @onkeyup="HandleKeyUp" placeholder="รหัสผ่านผู้ดูแลระบบ" />
                            <button class="btn btn-outline-secondary" type="button" title="@(showPassword ? "ซ่อนรหัสผ่าน" : "แสดงรหัสผ่าน")" @onclick="() => showPassword = !showPassword">
                                <i class="bi @(showPassword ? "bi-eye-slash" : "bi-eye")"></i>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light d-flex justify-content-between align-items-center">
                    <div class="small">
                        @if (IsFormValid)
                        {
                            <span class="text-success fw-semibold d-inline-flex align-items-center gap-1">
                                <i class="bi bi-check-circle-fill"></i>
                                <span>พร้อมตรวจสอบสิทธิ์</span>
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">กรอกข้อมูลให้ครบเพื่อเข้าสู่ระบบ</span>
                        }
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        @if (CanClose)
                        {
                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="Close">ยกเลิก</button>
                        }
                        <button type="button" class="btn btn-primary btn-sm px-3 d-flex align-items-center gap-2" @onclick="PerformLogin" disabled="@(isLoading || !IsFormValid)">
                            @if (isLoading)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                                <span>กำลังตรวจสอบ...</span>
                            }
                            else
                            {
                                <i class="bi bi-box-arrow-in-right"></i>
                                <span>เข้าสู่ระบบ</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public bool CanClose { get; set; } = true;
    [Parameter] public EventCallback<bool> OnLoginCompleted { get; set; }

    private string username = "";
    private string password = "";
    private string? errorMessage;
    private bool isLoading;
    private bool showPassword;

    private bool IsFormValid => !string.IsNullOrWhiteSpace(username) && !string.IsNullOrWhiteSpace(password);

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && IsFormValid && !isLoading)
        {
            await PerformLogin();
        }
    }

    private async Task PerformLogin()
    {
        if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "กรุณากรอก Username และ Password";
            return;
        }

        isLoading = true;
        errorMessage = null;

        try
        {
            var result = await LdapAuth.AuthenticateAsync(username.Trim(), password);
            if (result.IsSuccess && result.IsAdmin)
            {
                SessionState.SetUser(result.Username, result.DisplayName, result.IsAdmin);
                await AuditService.LogAsync("ADMIN_LOGIN", $"Admin login successful for '{result.Username}'", true, result.Username);
                IsOpen = false;
                await OnLoginCompleted.InvokeAsync(true);
            }
            else
            {
                errorMessage = result.ErrorMessage ?? "การยืนยันตัวตนล้มเหลว ตรวจสอบชื่อผู้ใช้หรือรหัสผ่าน";
                await AuditService.LogAsync("ADMIN_LOGIN_FAIL", $"Failed login attempt for '{username}': {errorMessage}", false, username);
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    public void Open()
    {
        IsOpen = true;
        errorMessage = null;
        password = "";
        StateHasChanged();
    }

    public void Close()
    {
        if (CanClose)
        {
            IsOpen = false;
            errorMessage = null;
            password = "";
            StateHasChanged();
        }
    }
}
