@page "/sessions"
@rendermode InteractiveServer
@inject ISftpSessionService SessionService
@inject IAuditService AuditService
@inject UserSessionState SessionState
@inject ILocalizationService L
@implements IDisposable

<PageTitle>SFTP Live Sessions - OpensshUI</PageTitle>

<div class="container-fluid p-0">
    <!-- Standardized Page Header -->
    <div class="page-header">
        <div>
            <h3 class="page-title">
                <i class="bi bi-diagram-2-fill text-primary"></i>
                <span>@L["Sessions.Title"]</span>
            </h3>
            <p class="text-muted small mb-0">@L["Sessions.Subtitle"]</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <!-- Demo Mode Toggle -->
            @if (SessionState.CanManageSftp)
            {
                <button class="btn @(isDemoMode ? "btn-warning text-dark fw-bold" : "btn-outline-secondary") btn-sm" @onclick="ToggleDemoMode" title="@L["Sessions.DemoTooltip"]">
                    <i class="bi @(isDemoMode ? "bi-check-circle-fill" : "bi-cpu")"></i>
                    <span>@(isDemoMode ? L["SshLogs.DemoActive"] : L["SshLogs.DemoInactive"])</span>
                </button>
            }

            <!-- Auto-Refresh Selector -->
            <div class="d-flex align-items-center gap-1.5 border rounded-2 px-2 py-1 bg-white shadow-sm">
                <i class="bi bi-clock-history text-muted small"></i>
                <span class="small text-muted me-1">Auto-Refresh:</span>
                <select class="form-select form-select-sm border-0 py-0 ps-1 pe-4 bg-transparent fw-semibold" style="width: auto; cursor: pointer;" @bind="autoRefreshSeconds" @bind:after="OnAutoRefreshChanged">
                    <option value="0">@L["SshLogs.AutoRefreshOff"]</option>
                    <option value="10">@L["SshLogs.AutoRefresh10s"]</option>
                    <option value="30">@L["SshLogs.AutoRefresh30s"]</option>
                </select>
            </div>

            <!-- Manual Refresh Button -->
            <button class="btn btn-outline-secondary btn-sm" @onclick="LoadSessions" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm"></span>
                    <span>@L["SshLogs.LoadingBtn"]</span>
                }
                else
                {
                    <i class="bi bi-arrow-clockwise"></i>
                    <span>@L["Home.RefreshBtn"]</span>
                }
            </button>
        </div>
    </div>

    <!-- Demo Mode Notice Banner -->
    @if (isDemoMode)
    {
        <div class="alert alert-warning border-0 shadow-sm rounded-3 py-2 px-3 mb-3 d-flex align-items-center justify-content-between" role="alert">
            <div class="d-flex align-items-center gap-2 small">
                <i class="bi bi-info-circle-fill fs-5 text-warning flex-shrink-0"></i>
                <div>
                    <strong>@L["Sessions.DemoBannerTitle"]</strong>
                    <span> @L["Sessions.DemoBannerDesc"]</span>
                </div>
            </div>
            @if (SessionState.CanManageSftp)
            {
                <button class="btn btn-sm btn-outline-dark" @onclick="ToggleDemoMode">@L["Sessions.BackToReal"]</button>
            }
        </div>
    }

    <!-- Alert Message Banner -->
    @if (!string.IsNullOrEmpty(alertMessage))
    {
        <div class="alert @(isAlertSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show py-2 small d-flex align-items-center gap-2 mb-3" role="alert">
            <i class="bi @(isAlertSuccess ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") flex-shrink-0"></i>
            <div>@alertMessage</div>
            <button type="button" class="btn-close" @onclick="() => alertMessage = null"></button>
        </div>
    }

    <!-- KPI Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="bg-primary-subtle text-primary p-3 rounded-circle d-inline-flex align-items-center justify-content-center">
                        <i class="bi bi-activity fs-3"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-semibold">Active SFTP Sessions</div>
                        <h3 class="fw-bold mb-0">@(overview?.TotalActiveSessions ?? 0)</h3>
                        <small class="text-muted">@L["Sessions.KpiActiveDesc"]</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="bg-success-subtle text-success p-3 rounded-circle d-inline-flex align-items-center justify-content-center">
                        <i class="bi bi-people-fill fs-3"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-semibold">Active SFTP Users</div>
                        <h3 class="fw-bold mb-0">@(overview?.UniqueUsersCount ?? 0)</h3>
                        <small class="text-muted">@L["Sessions.KpiUsersDesc"]</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="@(ExcessiveSessionsCount > 0 ? "bg-warning-subtle text-warning-emphasis" : "bg-light text-muted") p-3 rounded-circle d-inline-flex align-items-center justify-content-center">
                        <i class="bi @(ExcessiveSessionsCount > 0 ? "bi-exclamation-triangle-fill" : "bi-shield-check") fs-3"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-semibold">Excessive Connections</div>
                        <h3 class="fw-bold mb-0 @(ExcessiveSessionsCount > 0 ? "text-warning-emphasis" : "")">@ExcessiveSessionsCount</h3>
                        <small class="text-muted">@L["Sessions.KpiExcessiveDesc"]</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Table & Filter Card -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white border-bottom pt-3 pb-2 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="d-flex align-items-center gap-2">
                <h6 class="fw-bold mb-0 d-flex align-items-center gap-2">
                    <i class="bi bi-list-ul text-primary"></i>
                    <span>@L["Sessions.ListTitle"]</span>
                </h6>
                <span class="badge bg-secondary-subtle text-secondary border px-2 py-0.5">
                    @L.Get("Sessions.CountBadge", FilteredSessions.Count)
                </span>
                @if (autoRefreshSeconds > 0)
                {
                    <span class="badge bg-success-subtle text-success border border-success-subtle d-inline-flex align-items-center gap-1">
                        <span class="spinner-grow spinner-grow-sm" style="width: 0.5rem; height: 0.5rem;"></span>
                        <span>Auto-Refresh @(autoRefreshSeconds)s</span>
                    </span>
                }
            </div>

            <div class="d-flex align-items-center gap-2" style="max-width: 350px;">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-end-0">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text" class="form-control border-start-0" placeholder="@L["Sessions.SearchPlaceholder"]" @bind="searchQuery" @bind:event="oninput" />
                    @if (!string.IsNullOrEmpty(searchQuery))
                    {
                        <button class="btn btn-outline-secondary border-start-0" @onclick="() => searchQuery = string.Empty">
                            <i class="bi bi-x"></i>
                        </button>
                    }
                </div>
            </div>
        </div>

        <div class="card-body p-0">
            @if (isLoading && overview == null)
            {
                <div class="text-center py-5">
                    <span class="spinner-border spinner-border-sm text-primary"></span>
                    <p class="text-muted small mt-2 mb-0">@L["Sessions.Loading"]</p>
                </div>
            }
            else if (FilteredSessions.Count == 0)
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-broadcast fs-1 text-secondary opacity-50 d-block mb-2"></i>
                    <h6 class="fw-semibold">@L["Sessions.EmptyTitle"]</h6>
                    <p class="small mb-0">@(string.IsNullOrEmpty(searchQuery) ? (overview?.StatusNote ?? L["Sessions.EmptyDefault"]) : L["Sessions.EmptySearch"])</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small text-muted">
                            <tr>
                                <th class="ps-3" style="width: 220px;">@L["Sessions.ColUser"]</th>
                                <th style="width: 200px;">@L["Sessions.ColEndpoint"]</th>
                                <th style="width: 150px;">@L["Sessions.ColDuration"]</th>
                                <th style="width: 140px;">@L["Sessions.ColPid"]</th>
                                <th style="width: 120px;">@L["Sessions.ColMemory"]</th>
                                <th style="width: 130px;">@L["Sessions.ColStatus"]</th>
                                <th class="text-end pe-3">@L["Sessions.ColActions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var session in FilteredSessions)
                            {
                                var userSessionCount = overview?.Sessions.Count(s => s.Username.Equals(session.Username, StringComparison.OrdinalIgnoreCase)) ?? 1;

                                <tr>
                                    <td class="ps-3">
                                        <div class="d-flex align-items-center gap-2">
                                            @if (session.IsAuthenticating)
                                            {
                                                <div class="rounded-circle bg-warning-subtle text-warning-emphasis d-inline-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px; font-size: 0.85rem;" title="@L["Sessions.PreAuthTooltip"]">
                                                    <i class="bi bi-hourglass-split"></i>
                                                </div>
                                                <div>
                                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                                                        @L["Sessions.Authenticating"]
                                                    </span>
                                                    <div><small class="text-muted font-monospace">Port @session.LocalPort (SFTP)</small></div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="rounded-circle bg-primary-subtle text-primary d-inline-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px; font-size: 0.85rem;">
                                                    @(string.IsNullOrEmpty(session.Username) ? "?" : session.Username[..1].ToUpperInvariant())
                                                </div>
                                                <div>
                                                    <div class="fw-semibold text-dark">@session.Username</div>
                                                    <small class="text-muted">Port @session.LocalPort (SFTP)</small>
                                                </div>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <div class="font-monospace small">@session.RemoteIp</div>
                                        <small class="text-muted font-monospace">Port: @session.RemotePort</small>
                                    </td>
                                    <td>
                                        <div class="small fw-semibold text-dark">@FormatDuration(session.Duration)</div>
                                        <small class="text-muted">@L.Get("Sessions.SinceTime", session.ConnectedAt.ToString("HH:mm:ss"))</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border font-monospace">
                                            PID @session.ProcessId
                                        </span>
                                        <div class="small text-muted font-monospace">@session.ProcessName</div>
                                    </td>
                                    <td>
                                        <span class="small font-monospace text-muted">
                                            @FormatBytes(session.WorkingSetMemoryBytes)
                                        </span>
                                    </td>
                                    <td>
                                        @if (session.IsExcessiveConnection)
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle" title="@L["Sessions.ExcessiveTooltip"]">
                                                <i class="bi bi-exclamation-triangle-fill"></i>
                                                <span>@L.Get("Sessions.ExcessiveBadge", userSessionCount)</span>
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                <i class="bi bi-check-circle-fill"></i>
                                                <span>@L["Sessions.NormalBadge"]</span>
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end pe-3">
                                        @if (SessionState.CanManageSftp)
                                        {
                                            <div class="action-bar justify-content-end">
                                                <button class="btn btn-outline-danger btn-sm" @onclick="() => PromptDisconnectSingle(session)" title="@L["Sessions.DisconnectTooltip"]">
                                                    <i class="bi bi-x-circle-fill"></i>
                                                    <span>@L["Sessions.DisconnectBtn"]</span>
                                                </button>

                                                @if (userSessionCount > 1)
                                                {
                                                    <span class="action-divider"></span>
                                                    <button class="btn btn-outline-warning btn-sm text-dark" @onclick="() => PromptDisconnectUser(session.Username, userSessionCount)" title="@L["Sessions.DisconnectAllTooltip"]">
                                                        <i class="bi bi-people-fill"></i>
                                                        <span>@L.Get("Sessions.DisconnectAllBtn", userSessionCount)</span>
                                                    </button>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small fst-italic">Read-Only</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Disconnect Single Session Confirmation Modal -->
@if (confirmSessionTarget != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0 rounded-3">
                <div class="modal-header bg-danger text-white py-2.5">
                    <h6 class="modal-title fw-bold d-flex align-items-center gap-2">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <span>@L["Sessions.ModalSingleTitle"]</span>
                    </h6>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => confirmSessionTarget = null"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="alert alert-info py-2 px-3 small d-flex align-items-center gap-2 mb-3">
                        <i class="bi bi-shield-check text-info fs-4 flex-shrink-0"></i>
                        <div>
                            <strong>@L["Sessions.ModalSafetyTitle"]</strong> @L["Sessions.ModalSafetyDesc"]
                        </div>
                    </div>

                    <div class="bg-light p-3 rounded-2 border mb-3">
                        <div class="row g-2 small">
                            <div class="col-4 text-muted">@L["Sessions.ModalUser"]</div>
                            <div class="col-8 fw-bold text-dark">@confirmSessionTarget.Username</div>

                            <div class="col-4 text-muted">@L["Sessions.ModalIp"]</div>
                            <div class="col-8 font-monospace">@confirmSessionTarget.RemoteIp:@confirmSessionTarget.RemotePort</div>

                            <div class="col-4 text-muted">Process ID:</div>
                            <div class="col-8 font-monospace">PID @confirmSessionTarget.ProcessId (@confirmSessionTarget.ProcessName)</div>

                            <div class="col-4 text-muted">@L["Sessions.ModalDuration"]</div>
                            <div class="col-8 fw-semibold">@FormatDuration(confirmSessionTarget.Duration)</div>
                        </div>
                    </div>

                    <p class="small text-muted mb-0">@L["Sessions.ModalSingleConfirm"]</p>
                </div>
                <div class="modal-footer bg-light py-2">
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="() => confirmSessionTarget = null" disabled="@isTerminating">@L["Common.Cancel"]</button>
                    <button type="button" class="btn btn-danger btn-sm fw-bold" @onclick="ExecuteDisconnectSingle" disabled="@isTerminating">
                        @if (isTerminating)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                            <span>@L["Sessions.Disconnecting"]</span>
                        }
                        else
                        {
                            <i class="bi bi-power"></i>
                            <span>@L["Sessions.ConfirmDisconnect"]</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Disconnect All User Sessions Confirmation Modal -->
@if (!string.IsNullOrEmpty(confirmUserTarget))
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0 rounded-3">
                <div class="modal-header bg-danger text-white py-2.5">
                    <h6 class="modal-title fw-bold d-flex align-items-center gap-2">
                        <i class="bi bi-people-fill"></i>
                        <span>@L["Sessions.ModalAllTitle"]</span>
                    </h6>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => confirmUserTarget = null"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="alert alert-danger py-2 px-3 small d-flex align-items-center gap-2 mb-3">
                        <i class="bi bi-exclamation-octagon-fill text-danger fs-4 flex-shrink-0"></i>
                        <div>
                            @L.Get("Sessions.ModalAllWarning", confirmUserTargetCount, confirmUserTarget)
                        </div>
                    </div>
                    <p class="small text-muted mb-0">@L["Sessions.ModalAllNote"]</p>
                </div>
                <div class="modal-footer bg-light py-2">
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="() => confirmUserTarget = null" disabled="@isTerminating">@L["Common.Cancel"]</button>
                    <button type="button" class="btn btn-danger btn-sm fw-bold" @onclick="ExecuteDisconnectUser" disabled="@isTerminating">
                        @if (isTerminating)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                            <span>@L["Sessions.Disconnecting"]</span>
                        }
                        else
                        {
                            <i class="bi bi-power"></i>
                            <span>@L.Get("Sessions.ConfirmDisconnectAll", confirmUserTargetCount)</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private SftpSessionOverview? overview;
    private bool isLoading;
    private bool isTerminating;
    private bool isDemoMode;
    private string? alertMessage;
    private bool isAlertSuccess;
    private string searchQuery = string.Empty;

    private int autoRefreshSeconds = 0;
    private Timer? autoRefreshTimer;

    private SftpSessionInfo? confirmSessionTarget;
    private string? confirmUserTarget;
    private int confirmUserTargetCount;

    private int ExcessiveSessionsCount => overview?.Sessions.Count(s => s.IsExcessiveConnection) ?? 0;

    private List<SftpSessionInfo> FilteredSessions
    {
        get
        {
            if (overview == null) return new List<SftpSessionInfo>();
            if (string.IsNullOrWhiteSpace(searchQuery)) return overview.Sessions;

            var q = searchQuery.Trim().ToLowerInvariant();
            return overview.Sessions
                .Where(s => s.Username.ToLowerInvariant().Contains(q) || s.RemoteIp.Contains(q))
                .ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        L.OnLanguageChanged += StateHasChanged;
        await LoadSessions();
    }

    private async Task LoadSessions()
    {
        if (!SessionState.EnsureAuthenticated()) return;
        isLoading = true;
        try
        {
            overview = await SessionService.GetActiveSessionsAsync(forceMock: isDemoMode);
        }
        catch (Exception ex)
        {
            SetAlert(L.Get("Sessions.LoadError", ex.Message), false);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ToggleDemoMode()
    {
        if (!SessionState.CanManageSftp) return;
        isDemoMode = !isDemoMode;
        await LoadSessions();
    }

    private void OnAutoRefreshChanged()
    {
        autoRefreshTimer?.Dispose();
        autoRefreshTimer = null;

        if (autoRefreshSeconds > 0)
        {
            autoRefreshTimer = new Timer(async _ =>
            {
                await InvokeAsync(async () =>
                {
                    if (!SessionState.EnsureAuthenticated())
                    {
                        autoRefreshTimer?.Dispose();
                        autoRefreshTimer = null;
                        StateHasChanged();
                        return;
                    }

                    try
                    {
                        overview = await SessionService.GetActiveSessionsAsync(forceMock: isDemoMode);
                        StateHasChanged();
                    }
                    catch { }
                });
            }, null, TimeSpan.FromSeconds(autoRefreshSeconds), TimeSpan.FromSeconds(autoRefreshSeconds));
        }
    }

    private void PromptDisconnectSingle(SftpSessionInfo session)
    {
        if (!SessionState.CanManageSftp) return;
        confirmSessionTarget = session;
    }

    private void PromptDisconnectUser(string username, int count)
    {
        if (!SessionState.CanManageSftp) return;
        confirmUserTarget = username;
        confirmUserTargetCount = count;
    }

    private async Task ExecuteDisconnectSingle()
    {
        // Dual-Layer RBAC: Layer 2 Code-Behind Guard
        if (!SessionState.CanManageSftp || confirmSessionTarget == null) return;

        isTerminating = true;
        var op = string.IsNullOrEmpty(SessionState.CurrentUsername) ? "admin" : SessionState.CurrentUsername;
        var target = confirmSessionTarget;
        confirmSessionTarget = null;

        if (isDemoMode)
        {
            if (overview != null)
            {
                overview.Sessions.RemoveAll(s =>
                    string.Equals(s.SessionId, target.SessionId, StringComparison.Ordinal) ||
                    (target.ProcessId > 0 && s.ProcessId == target.ProcessId && string.Equals(s.Username, target.Username, StringComparison.OrdinalIgnoreCase)));
                RecalculateDemoOverviewTotals();
            }

            var msg = $"[Demo] Terminated SFTP session '{target.SessionId}' for '{target.Username}' ({target.RemoteIp}:{target.RemotePort}).";
            await AuditService.LogAsync("SESSION_TERMINATE", msg, true, op);
            isTerminating = false;
            SetAlert(msg, true);
            return;
        }

        var (ok, liveMsg) = await SessionService.TerminateSessionAsync(target, op);
        isTerminating = false;

        SetAlert(liveMsg, ok);
        await LoadSessions();
    }

    private async Task ExecuteDisconnectUser()
    {
        // Dual-Layer RBAC: Layer 2 Code-Behind Guard
        if (!SessionState.CanManageSftp || string.IsNullOrEmpty(confirmUserTarget)) return;

        isTerminating = true;
        var op = string.IsNullOrEmpty(SessionState.CurrentUsername) ? "admin" : SessionState.CurrentUsername;
        var targetUser = confirmUserTarget;
        confirmUserTarget = null;

        if (isDemoMode)
        {
            int removed = 0;
            if (overview != null)
            {
                removed = overview.Sessions.RemoveAll(s => string.Equals(s.Username, targetUser, StringComparison.OrdinalIgnoreCase));
                RecalculateDemoOverviewTotals();
            }

            var msg = $"[Demo] Terminated {removed} SFTP session(s) for user '{targetUser}'.";
            await AuditService.LogAsync("SESSION_TERMINATE_USER", msg, true, op);
            isTerminating = false;
            SetAlert(msg, true);
            return;
        }

        var (ok, liveMsg) = await SessionService.TerminateUserSessionsAsync(targetUser, op);
        isTerminating = false;

        SetAlert(liveMsg, ok);
        await LoadSessions();
    }

    private void RecalculateDemoOverviewTotals()
    {
        if (overview == null) return;
        overview.TotalActiveSessions = overview.Sessions.Count;
        overview.UniqueUsersCount = overview.Sessions
            .Where(s => !string.Equals(s.Username, "Unknown", StringComparison.OrdinalIgnoreCase))
            .Select(s => s.Username)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Count();
    }

    private void SetAlert(string message, bool isSuccess)
    {
        alertMessage = message;
        isAlertSuccess = isSuccess;
    }

    private static string FormatDuration(TimeSpan d)
    {
        if (d.TotalDays >= 1) return $"{(int)d.TotalDays}d {d.Hours}h {d.Minutes}m";
        if (d.TotalHours >= 1) return $"{(int)d.TotalHours}h {d.Minutes}m {d.Seconds}s";
        if (d.TotalMinutes >= 1) return $"{(int)d.TotalMinutes}m {d.Seconds}s";
        return $"{Math.Max(0, (int)d.TotalSeconds)}s";
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes <= 0) return "-";
        string[] sizes = { "B", "KB", "MB", "GB" };
        int order = 0;
        double len = bytes;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len /= 1024;
        }
        return $"{len:0.0} {sizes[order]}";
    }

    public void Dispose()
    {
        L.OnLanguageChanged -= StateHasChanged;
        autoRefreshTimer?.Dispose();
        autoRefreshTimer = null;
    }
}
