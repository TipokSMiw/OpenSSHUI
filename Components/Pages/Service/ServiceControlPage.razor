@page "/service"
@rendermode InteractiveServer
@inject IOpenSshServiceManager SshManager
@inject ISshdConfigService ConfigService
@inject IAuditService AuditService
@inject UserSessionState SessionState

<PageTitle>OpenSSH Service Controller - OpensshUI</PageTitle>

<div class="container-fluid p-0">
    <!-- Standardized Page Header -->
    <div class="page-header">
        <div>
            <h3 class="page-title">
                <i class="bi bi-hdd-network-fill text-primary"></i>
                <span>บริการ OpenSSH (Service Controller)</span>
            </h3>
            <p class="text-muted small mb-0">ควบคุมและตรวจสอบสถานะ Windows OpenSSH (sshd) พร้อมระบบตรวจสอบไวยากรณ์ sshd.exe -t</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-outline-secondary btn-sm" @onclick="RefreshStatus">
                <i class="bi bi-arrow-clockwise"></i>
                <span>รีเฟรชสถานะ</span>
            </button>
        </div>
    </div>

    @if (!SessionState.CanManageSystem)
    {
        <div class="alert alert-info py-2 px-3 small d-flex align-items-center gap-2 mb-3" role="alert">
            <i class="bi bi-eye-fill text-primary flex-shrink-0"></i>
            <div>โหมดอ่านอย่างเดียว (Read-Only): เฉพาะผู้ดูแลระบบระดับ <strong>SuperAdmin</strong> เท่านั้นที่สามารถสั่งควบคุมบริการ Windows Service หรือแก้ไขไฟล์ <code>sshd_config</code> ได้ (สิทธิ์ปัจจุบันของคุณ: <strong>@SessionState.Role</strong>)</div>
        </div>
    }

    @if (!string.IsNullOrEmpty(alertMessage))
    {
        <div class="alert @(isAlertSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show py-2 small d-flex align-items-center gap-2" role="alert">
            <i class="bi @(isAlertSuccess ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") flex-shrink-0"></i>
            <div>@alertMessage</div>
            <button type="button" class="btn-close" @onclick="() => alertMessage = null"></button>
        </div>
    }

    <div class="row g-4 mb-4">
        <!-- Service Status & Controls -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-white border-bottom pt-3 pb-2">
                    <h6 class="fw-bold mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-cpu-fill text-primary"></i>
                        <span>สถานะ Windows Service (sshd)</span>
                    </h6>
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-center gap-3 mb-4">
                        <div class="@(serviceInfo?.Status == "Running" ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger") p-3 rounded-circle d-inline-flex align-items-center justify-content-center">
                            <i class="bi @(serviceInfo?.Status == "Running" ? "bi-check-circle-fill" : "bi-stop-circle-fill") fs-2"></i>
                        </div>
                        <div>
                            <div class="text-muted small">Service Status</div>
                            <h3 class="fw-bold mb-0">@(serviceInfo?.Status ?? "Unknown")</h3>
                            <small class="text-muted">Service Name: <code>sshd</code></small>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="small text-muted fw-semibold mb-1">Executable Path:</div>
                        <code class="d-block p-2 bg-light border rounded text-break">@(serviceInfo?.SshdExecutablePath ?? "-")</code>
                    </div>

                    <div class="mb-4">
                        <div class="small text-muted fw-semibold mb-1">Config File Path:</div>
                        <code class="d-block p-2 bg-light border rounded text-break">@(serviceInfo?.ConfigPath ?? "-")</code>
                    </div>

                    @if (SessionState.CanManageSystem)
                    {
                        <div class="d-flex flex-wrap align-items-center gap-2 pt-2 border-top">
                            <button class="btn btn-success btn-sm" @onclick="StartService" disabled="@(!serviceInfo?.CanStart == true || isProcessing)">
                                <i class="bi bi-play-fill"></i>
                                <span>Start Service</span>
                            </button>
                            <button class="btn btn-warning btn-sm text-dark fw-semibold" @onclick="RestartService" disabled="@isProcessing">
                                <i class="bi bi-arrow-repeat"></i>
                                <span>Restart Service</span>
                            </button>
                            <span class="action-divider"></span>
                            <button class="btn btn-outline-danger btn-sm" @onclick="StopService" disabled="@(!serviceInfo?.CanStop == true || isProcessing)">
                                <i class="bi bi-stop-fill"></i>
                                <span>Stop Service</span>
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Syntax Check (sshd -t) -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-white border-bottom pt-3 pb-2 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-shield-check text-primary"></i>
                        <span>ตรวจสอบไวยากรณ์ Config (sshd.exe -t)</span>
                    </h6>
                    @if (SessionState.CanManageSystem)
                    {
                        <button class="btn btn-primary btn-sm" @onclick="RunSyntaxCheck" disabled="@isCheckingSyntax">
                            @if (isCheckingSyntax)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                                <span>กำลังตรวจสอบ...</span>
                            }
                            else
                            {
                                <i class="bi bi-check2-circle"></i>
                                <span>ตรวจสอบเดี๋ยวนี้</span>
                            }
                        </button>
                    }
                </div>
                <div class="card-body">
                    <p class="small text-muted mb-3">
                        การใช้คำสั่ง <code>sshd.exe -t</code> จะตรวจสอบความถูกต้องของไฟล์ <code>sshd_config</code> โดยระบบจะรันการตรวจสอบนี้ทุกครั้งก่อนสั่ง Restart Service เสมอเพื่อป้องกันไม่ให้บริการล่ม
                    </p>

                    @if (lastValidationResult != null)
                    {
                        <div class="mb-2">
                            @if (lastValidationResult.IsValid)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1">
                                    <i class="bi bi-check-circle-fill"></i>
                                    <span>Syntax Valid (ไวยากรณ์ถูกต้อง ปลอดภัย)</span>
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2.5 py-1">
                                    <i class="bi bi-x-circle-fill"></i>
                                    <span>Syntax Error (พบข้อผิดพลาดในไฟล์ config)</span>
                                </span>
                            }
                        </div>

                        <div class="bg-dark text-light p-3 rounded font-monospace small" style="min-height: 120px; max-height: 200px; overflow-y: auto;">
                            @if (string.IsNullOrWhiteSpace(lastValidationResult.Output))
                            {
                                <span class="text-success">[sshd -t] Configuration syntax is OK. No errors detected.</span>
                            }
                            else
                            {
                                <div>@lastValidationResult.Output</div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="bg-light border text-muted p-4 rounded text-center small font-monospace">
                            คลิกปุ่ม "ตรวจสอบเดี๋ยวนี้" เพื่อรันคำสั่ง sshd.exe -t
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- ssh-agent Service Status & Controls -->
        <div class="col-lg-12">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white border-bottom pt-3 pb-2">
                    <h6 class="fw-bold mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-key-fill text-primary"></i>
                        <span>สถานะ Windows Service (ssh-agent)</span>
                    </h6>
                </div>
                <div class="card-body">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="@(agentInfo?.Status == "Running" ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary") p-2.5 rounded-circle d-inline-flex align-items-center justify-content-center">
                                <i class="bi @(agentInfo?.Status == "Running" ? "bi-check-circle-fill" : "bi-stop-circle-fill") fs-4"></i>
                            </div>
                            <div>
                                <div class="text-muted small">Service Status</div>
                                <h4 class="fw-bold mb-0">@(agentInfo?.Status ?? "Unknown")</h4>
                                <small class="text-muted">Service Name: <code>ssh-agent</code></small>
                            </div>
                        </div>

                        @if (SessionState.CanManageSystem)
                        {
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <button class="btn btn-success btn-sm" @onclick="StartAgentService" disabled="@(!agentInfo?.CanStart == true || isProcessing)">
                                    <i class="bi bi-play-fill"></i>
                                    <span>Start Agent</span>
                                </button>
                                <button class="btn btn-warning btn-sm text-dark fw-semibold" @onclick="RestartAgentService" disabled="@isProcessing">
                                    <i class="bi bi-arrow-repeat"></i>
                                    <span>Restart Agent</span>
                                </button>
                                <span class="action-divider"></span>
                                <button class="btn btn-outline-danger btn-sm" @onclick="StopAgentService" disabled="@(!agentInfo?.CanStop == true || isProcessing)">
                                    <i class="bi bi-stop-fill"></i>
                                    <span>Stop Agent</span>
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Concurrency & Performance Tuning Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header bg-white border-bottom pt-3 pb-2 d-flex justify-content-between align-items-center">
            <h6 class="fw-bold mb-0 d-flex align-items-center gap-2">
                <i class="bi bi-speedometer text-primary"></i>
                <span>การปรับแต่งประสิทธิภาพและการเชื่อมต่อ (Concurrency & Connection Limits)</span>
            </h6>
            <span class="badge @(concurrencySettings.AppliedProfile == "HighTraffic" ? "bg-warning-subtle text-warning-emphasis border border-warning-subtle" : "bg-light text-muted border") px-2.5 py-1">
                Profile: @concurrencySettings.AppliedProfile
            </span>
        </div>
        <div class="card-body">
            <p class="small text-muted mb-3">
                กำหนดค่าขีดจำกัดการเชื่อมต่อพร้อมกันใน <code>sshd_config</code> เพื่อรองรับกรณีผู้ใช้เชื่อมต่อหรือวางไฟล์พร้อมกันปริมาณมาก ป้องกันปัญหาการปฏิเสธการเชื่อมต่อ (Connection reset by peer)
            </p>

            <!-- Quick Presets -->
            <div class="d-flex flex-wrap align-items-center gap-2 mb-4 p-2.5 bg-light rounded-2 border">
                <span class="small fw-semibold text-muted me-1">
                    <i class="bi bi-sliders"></i> พรีเซ็ตแนะนำ:
                </span>
                <button class="btn btn-outline-secondary btn-sm" @onclick="ApplyStandardPreset" disabled="@(!SessionState.CanManageSystem || isProcessing)">
                    <i class="bi bi-check-circle"></i>
                    <span>Standard (ไม่เกิน 50 ผู้ใช้)</span>
                </button>
                <button class="btn btn-outline-warning btn-sm text-dark fw-semibold" @onclick="ApplyHighTrafficPreset" disabled="@(!SessionState.CanManageSystem || isProcessing)">
                    <i class="bi bi-lightning-charge-fill"></i>
                    <span>High Traffic (100-300 ผู้ใช้)</span>
                </button>
                <button class="btn btn-outline-dark btn-sm" @onclick="ApplyDefaultPreset" disabled="@(!SessionState.CanManageSystem || isProcessing)">
                    <i class="bi bi-arrow-counterclockwise"></i>
                    <span>ค่าเริ่มต้น OpenSSH (Default)</span>
                </button>
            </div>

            <!-- Parameters Grid -->
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label small fw-semibold text-dark mb-1">
                        MaxStartups (การเชื่อมต่อพร้อมกันช่วง Handshake)
                    </label>
                    <input type="text" class="form-control form-control-sm font-monospace" @bind="concurrencySettings.MaxStartups" disabled="@(!SessionState.CanManageSystem || isProcessing)" placeholder="10:30:100 หรือ 100:30:300" />
                    <div class="form-text small text-muted">เช่น <code>100:30:300</code> (เริ่มสุ่มดร็อปที่ 100 ดร็อป 100% ที่ 300)</div>
                </div>

                <div class="col-md-4">
                    <label class="form-label small fw-semibold text-dark mb-1">
                        MaxSessions (ช่องสัญญาณต่อการเชื่อมต่อ)
                    </label>
                    <input type="number" class="form-control form-control-sm" @bind="concurrencySettings.MaxSessions" min="1" max="500" disabled="@(!SessionState.CanManageSystem || isProcessing)" />
                    <div class="form-text small text-muted">ค่าเริ่มต้น <code>10</code> (แนะนำ <code>20-50</code> หากเปิดหลายเธรด)</div>
                </div>

                <div class="col-md-4">
                    <label class="form-label small fw-semibold text-dark mb-1">
                        ClientAliveInterval (วินาทีตรวจสอบการเชื่อมต่อ)
                    </label>
                    <input type="number" class="form-control form-control-sm" @bind="concurrencySettings.ClientAliveInterval" min="0" max="3600" disabled="@(!SessionState.CanManageSystem || isProcessing)" />
                    <div class="form-text small text-muted"><code>0</code> = ปิด, แนะนำ <code>30</code> หรือ <code>60</code> วินาทีเพื่อเคลียร์เซสชันผี</div>
                </div>

                <div class="col-md-4">
                    <label class="form-label small fw-semibold text-dark mb-1">
                        ClientAliveCountMax (จำนวนครั้งที่ไม่ตอบกลับ)
                    </label>
                    <input type="number" class="form-control form-control-sm" @bind="concurrencySettings.ClientAliveCountMax" min="1" max="20" disabled="@(!SessionState.CanManageSystem || isProcessing)" />
                    <div class="form-text small text-muted">ค่าเริ่มต้น <code>3</code> ครั้งก่อนตัดการเชื่อมต่อ</div>
                </div>

                <div class="col-md-4">
                    <label class="form-label small fw-semibold text-dark mb-1">
                        LoginGraceTime (เวลารอการยืนยันตัวตน วินาที)
                    </label>
                    <input type="number" class="form-control form-control-sm" @bind="concurrencySettings.LoginGraceTime" min="5" max="600" disabled="@(!SessionState.CanManageSystem || isProcessing)" />
                    <div class="form-text small text-muted">ค่าเริ่มต้น <code>120</code> (แนะนำ <code>30-60</code> เมื่อทราฟฟิกสูง)</div>
                </div>
            </div>

            @if (SessionState.CanManageSystem)
            {
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-4 pt-3 border-top">
                    <div class="small text-muted d-flex align-items-center gap-1">
                        <i class="bi bi-info-circle text-primary"></i>
                        <span>การปรับค่าจะมีผลสมบูรณ์เมื่อสั่ง <strong>Restart Service (sshd)</strong> ด้านบน</span>
                    </div>
                    <button class="btn btn-primary btn-sm fw-semibold" @onclick="SaveConcurrencySettings" disabled="@isProcessing">
                        @if (isProcessing)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                            <span>กำลังตรวจสอบและบันทึก...</span>
                        }
                        else
                        {
                            <i class="bi bi-check2-circle"></i>
                            <span>ตรวจสอบไวยากรณ์และบันทึกค่า (Apply & Validate)</span>
                        }
                    </button>
                </div>
            }
        </div>
    </div>

    <!-- Zero-Config Group Block Setup -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white border-bottom pt-3 pb-2 d-flex justify-content-between align-items-center">
            <h6 class="fw-bold mb-0 d-flex align-items-center gap-2">
                <i class="bi bi-lightning-charge-fill text-primary"></i>
                <span>โครงสร้าง Zero-Config Reload (Match Group SFTP-Users)</span>
            </h6>
            @if (serviceInfo?.HasZeroConfigBlock == true)
            {
                <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>ติดตั้งแล้ว</span>
                </span>
            }
            else if (SessionState.CanManageSystem)
            {
                <button class="btn btn-warning btn-sm fw-bold text-dark" @onclick="InstallZeroConfig">
                    <i class="bi bi-plus-circle-fill"></i>
                    <span>ติดตั้งลง sshd_config</span>
                </button>
            }
        </div>
        <div class="card-body">
            <p class="small text-muted mb-3">
                ด้วยบล็อกการตั้งค่านี้ เมื่อผู้ใช้ใหม่อยู่ใน Windows Local Group <code>SFTP-Users</code> ระบบ OpenSSH จะบังคับ Chroot และอ่าน Public Key จากโฟลเดอร์กลาง <code>C:\ProgramData\ssh\keys\%u</code> โดยอัตโนมัติ ทำให้ไม่ต้องเปิดไฟล์ config แก้ไข หรือ Restart Service อีกเลย
            </p>

            <pre class="bg-dark text-code-warning p-3 rounded font-monospace small mb-0"><code>@zeroConfigPreview</code></pre>
        </div>
    </div>
</div>

@code {
    private ServiceStatusInfo? serviceInfo;
    private ServiceStatusInfo? agentInfo;
    private ConfigValidationResult? lastValidationResult;
    private SshdConcurrencySettings concurrencySettings = new();
    private string zeroConfigPreview = "";
    private bool isProcessing;
    private bool isCheckingSyntax;
    private string? alertMessage;
    private bool isAlertSuccess;

    protected override void OnInitialized()
    {
        zeroConfigPreview = SshManager.GetZeroConfigBlockTemplate(SshManager.SftpRoot, SshManager.KeysPath);
        concurrencySettings = ConfigService.GetConcurrencySettings();
        RefreshStatus();
    }

    private void ApplyStandardPreset()
    {
        concurrencySettings.MaxStartups = "20:30:100";
        concurrencySettings.MaxSessions = 15;
        concurrencySettings.ClientAliveInterval = 60;
        concurrencySettings.ClientAliveCountMax = 3;
        concurrencySettings.LoginGraceTime = 60;
        concurrencySettings.AppliedProfile = "Standard";
    }

    private void ApplyHighTrafficPreset()
    {
        concurrencySettings.MaxStartups = "100:30:300";
        concurrencySettings.MaxSessions = 30;
        concurrencySettings.ClientAliveInterval = 30;
        concurrencySettings.ClientAliveCountMax = 3;
        concurrencySettings.LoginGraceTime = 30;
        concurrencySettings.AppliedProfile = "HighTraffic";
    }

    private void ApplyDefaultPreset()
    {
        concurrencySettings.MaxStartups = "10:30:100";
        concurrencySettings.MaxSessions = 10;
        concurrencySettings.ClientAliveInterval = 0;
        concurrencySettings.ClientAliveCountMax = 3;
        concurrencySettings.LoginGraceTime = 120;
        concurrencySettings.AppliedProfile = "Default";
    }

    private async Task SaveConcurrencySettings()
    {
        if (!SessionState.CanManageSystem) return;
        isProcessing = true;
        var op = string.IsNullOrEmpty(SessionState.CurrentUsername) ? "admin" : SessionState.CurrentUsername;

        var (ok, msg) = await ConfigService.UpdateConcurrencySettingsAsync(concurrencySettings);
        isProcessing = false;
        SetAlert(msg, ok);

        await AuditService.LogAsync("SSHD_CONCURRENCY_UPDATED", msg, ok, op);

        if (ok)
        {
            concurrencySettings = ConfigService.GetConcurrencySettings();
        }
    }

    private void RefreshStatus()
    {
        serviceInfo = SshManager.GetStatus();
        agentInfo = SshManager.GetAgentStatus();
    }

    private async Task StartAgentService()
    {
        if (!SessionState.CanManageSystem) return;
        isProcessing = true;
        var op = string.IsNullOrEmpty(SessionState.CurrentUsername) ? "admin" : SessionState.CurrentUsername;
        var res = await SshManager.StartServiceAsync("ssh-agent");
        isProcessing = false;
        SetAlert(res.Message, res.Success);
        await AuditService.LogAsync("AGENT_SERVICE_START", res.Message, res.Success, op);
        RefreshStatus();
    }

    private async Task StopAgentService()
    {
        if (!SessionState.CanManageSystem) return;
        isProcessing = true;
        var op = string.IsNullOrEmpty(SessionState.CurrentUsername) ? "admin" : SessionState.CurrentUsername;
        var res = await SshManager.StopServiceAsync("ssh-agent");
        isProcessing = false;
        SetAlert(res.Message, res.Success);
        await AuditService.LogAsync("AGENT_SERVICE_STOP", res.Message, res.Success, op);
        RefreshStatus();
    }

    private async Task RestartAgentService()
    {
        if (!SessionState.CanManageSystem) return;
        isProcessing = true;
        var op = string.IsNullOrEmpty(SessionState.CurrentUsername) ? "admin" : SessionState.CurrentUsername;
        var res = await SshManager.RestartServiceAsync("ssh-agent");
        isProcessing = false;
        SetAlert(res.Message, res.Success);
        await AuditService.LogAsync("AGENT_SERVICE_RESTART", res.Message, res.Success, op);
        RefreshStatus();
    }

    private async Task RunSyntaxCheck()
    {
        if (!SessionState.CanManageSystem) return;
        isCheckingSyntax = true;
        try
        {
            lastValidationResult = await Task.Run(() => SshManager.ValidateConfigSyntax());
        }
        finally
        {
            isCheckingSyntax = false;
        }
    }

    private async Task StartService()
    {
        if (!SessionState.CanManageSystem) return;
        isProcessing = true;
        var op = string.IsNullOrEmpty(SessionState.CurrentUsername) ? "admin" : SessionState.CurrentUsername;
        var res = await SshManager.StartServiceAsync();
        isProcessing = false;
        SetAlert(res.Message, res.Success);
        await AuditService.LogAsync("SERVICE_START", res.Message, res.Success, op);
        RefreshStatus();
    }

    private async Task StopService()
    {
        if (!SessionState.CanManageSystem) return;
        isProcessing = true;
        var op = string.IsNullOrEmpty(SessionState.CurrentUsername) ? "admin" : SessionState.CurrentUsername;
        var res = await SshManager.StopServiceAsync();
        isProcessing = false;
        SetAlert(res.Message, res.Success);
        await AuditService.LogAsync("SERVICE_STOP", res.Message, res.Success, op);
        RefreshStatus();
    }

    private async Task RestartService()
    {
        if (!SessionState.CanManageSystem) return;
        isProcessing = true;
        var op = string.IsNullOrEmpty(SessionState.CurrentUsername) ? "admin" : SessionState.CurrentUsername;
        var res = await SshManager.RestartServiceAsync();
        isProcessing = false;
        SetAlert(res.Message, res.Success);
        await AuditService.LogAsync("SERVICE_RESTART", res.Message, res.Success, op);
        RefreshStatus();
    }

    private async Task InstallZeroConfig()
    {
        if (!SessionState.CanManageSystem) return;
        isProcessing = true;
        var op = string.IsNullOrEmpty(SessionState.CurrentUsername) ? "admin" : SessionState.CurrentUsername;
        var res = await SshManager.ApplyZeroConfigBlockAsync();
        isProcessing = false;
        SetAlert(res.Message, res.Success);
        await AuditService.LogAsync("ZEROCONFIG_INSTALL", res.Message, res.Success, op);
        RefreshStatus();
    }

    private void SetAlert(string msg, bool success)
    {
        alertMessage = msg;
        isAlertSuccess = success;
    }
}
