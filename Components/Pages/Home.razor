@page "/"
@rendermode InteractiveServer
@inject ISftpUserService UserService
@inject ISftpGroupService GroupService
@inject IOpenSshServiceManager SshManager
@inject ISecureFileBrowserService FileBrowser
@inject IAuditService AuditService
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>SFTP Dashboard - OpensshUI</PageTitle>

<div class="container-fluid p-0">
    <!-- Standardized Page Header -->
    <div class="page-header">
        <div>
            <h3 class="page-title">
                <i class="bi bi-speedometer2 text-primary"></i>
                <span>ภาพรวมระบบ (SFTP Server Dashboard)</span>
            </h3>
            <p class="text-muted small mb-0">บริหารจัดการผู้ใช้, กลุ่มแชร์ไฟล์, สิทธิ์ NTFS ACL และสถานะบริการ Windows OpenSSH</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-outline-secondary btn-sm" @onclick="LoadDashboardData">
                <i class="bi bi-arrow-clockwise"></i>
                <span>รีเฟรชข้อมูล</span>
            </button>
            <button class="btn btn-primary btn-sm" @onclick='() => Navigation.NavigateTo("users")'>
                <i class="bi bi-person-plus-fill"></i>
                <span>จัดการผู้ใช้งาน SFTP</span>
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert alert-info alert-dismissible fade show py-2 small d-flex align-items-center gap-2" role="alert">
            <i class="bi bi-info-circle-fill flex-shrink-0"></i>
            <div>@statusMessage</div>
            <button type="button" class="btn-close" @onclick="() => statusMessage = null"></button>
        </div>
    }

    <!-- Stat Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 h-100" role="button" @onclick='() => Navigation.NavigateTo("users")'>
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="bg-primary-subtle text-primary p-3 rounded-circle d-inline-flex align-items-center justify-content-center">
                        <i class="bi bi-people-fill fs-3"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-semibold">SFTP Users</div>
                        <h3 class="fw-bold mb-0">@usersCount</h3>
                        <small class="text-success d-inline-flex align-items-center gap-1">
                            <i class="bi bi-check-circle-fill"></i>
                            <span>@activeUsersCount บัญชีใช้งานอยู่</span>
                        </small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 h-100" role="button" @onclick='() => Navigation.NavigateTo("users")'>
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="bg-warning-subtle text-warning-emphasis p-3 rounded-circle d-inline-flex align-items-center justify-content-center">
                        <i class="bi bi-key-fill fs-3"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-semibold">SSH Public Keys</div>
                        <h3 class="fw-bold mb-0">@keysCount</h3>
                        <small class="text-muted font-monospace">C:\ProgramData\ssh\keys</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 h-100" role="button" @onclick='() => Navigation.NavigateTo("files")'>
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="bg-info-subtle text-info-emphasis p-3 rounded-circle d-inline-flex align-items-center justify-content-center">
                        <i class="bi bi-hdd-fill fs-3"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-semibold">Storage Usage</div>
                        <h4 class="fw-bold mb-0">@FormatBytes(totalStorageBytes)</h4>
                        <small class="text-muted font-monospace text-truncate d-block" style="max-width: 170px;" title="SFTP Root: @SshManager.SftpRoot">@SshManager.SftpRoot</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 h-100" role="button" @onclick='() => Navigation.NavigateTo("service")'>
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="@(serviceStatus?.Status == "Running" ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger") p-3 rounded-circle d-inline-flex align-items-center justify-content-center">
                        <i class="bi bi-shield-check fs-3"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-semibold">OpenSSH Service</div>
                        <h4 class="fw-bold mb-0">@(serviceStatus?.Status ?? "Unknown")</h4>
                        <small class="@(serviceStatus?.HasZeroConfigBlock == true ? "text-success" : "text-danger") d-inline-flex align-items-center gap-1">
                            <i class="bi @(serviceStatus?.HasZeroConfigBlock == true ? "bi-lightning-charge-fill" : "bi-exclamation-circle-fill")"></i>
                            <span>@(serviceStatus?.HasZeroConfigBlock == true ? "Zero-Config พร้อม" : "ยังไม่ลง Zero-Config")</span>
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Zero-Config Setup Alert (if not installed) -->
    @if (serviceStatus != null && !serviceStatus.HasZeroConfigBlock)
    {
        <div class="card border-warning bg-warning-subtle mb-4 shadow-sm">
            <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="d-flex align-items-center gap-3">
                    <i class="bi bi-exclamation-triangle-fill text-warning fs-2"></i>
                    <div>
                        <h6 class="fw-bold text-dark mb-1">ยังไม่พบ Zero-Config Block ใน sshd_config</h6>
                        <p class="small text-muted mb-0">
                            ติดตั้งบล็อก <code>Match Group SFTP-Users</code> ลงใน <code>@serviceStatus.ConfigPath</code> เพื่อให้สามารถเพิ่ม/ลดผู้ใช้ได้ทันทีโดยไม่ต้อง Restart Service
                        </p>
                    </div>
                </div>
                <button class="btn btn-warning fw-bold text-dark" @onclick="InstallZeroConfig">
                    <i class="bi bi-lightning-charge-fill"></i>
                    <span>ติดตั้ง Zero-Config ทันที</span>
                </button>
            </div>
        </div>
    }

    <!-- Quick Actions & Recent Audits -->
    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-white border-bottom pt-3 pb-2">
                    <h6 class="fw-bold mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-grid-1x2-fill text-primary"></i>
                        <span>เมนูจัดการด่วน (Quick Actions)</span>
                    </h6>
                </div>
                <div class="card-body d-flex flex-column gap-2">
                    <button class="quick-action-card text-start" @onclick='() => Navigation.NavigateTo("users")'>
                        <div class="d-flex align-items-center gap-2.5">
                            <i class="bi bi-people-fill text-primary fs-5"></i>
                            <div>
                                <div class="fw-bold small">จัดการผู้ใช้งาน (SFTP Users)</div>
                                <small class="text-muted d-block" style="font-size: 0.75rem;">สร้างบัญชี, ตั้งรหัสผ่าน และจัดการ SSH Keys</small>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </button>

                    <button class="quick-action-card text-start" @onclick='() => Navigation.NavigateTo("groups")'>
                        <div class="d-flex align-items-center gap-2.5">
                            <i class="bi bi-collection-fill text-primary fs-5"></i>
                            <div>
                                <div class="fw-bold small">จัดการกลุ่มผู้ใช้ (SFTP Groups)</div>
                                <small class="text-muted d-block" style="font-size: 0.75rem;">กำหนด Shared Folder และ NTFS Junctions</small>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </button>

                    <button class="quick-action-card text-start" @onclick='() => Navigation.NavigateTo("files")'>
                        <div class="d-flex align-items-center gap-2.5">
                            <i class="bi bi-folder2-open text-primary fs-5"></i>
                            <div>
                                <div class="fw-bold small">สำรวจไฟล์ (Web File Browser)</div>
                                <small class="text-muted d-block" style="font-size: 0.75rem;">อัปโหลด ดาวน์โหลด และตรวจสอบไฟล์ใน Chroot</small>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </button>

                    <button class="quick-action-card text-start" @onclick='() => Navigation.NavigateTo("service")'>
                        <div class="d-flex align-items-center gap-2.5">
                            <i class="bi bi-hdd-network-fill text-primary fs-5"></i>
                            <div>
                                <div class="fw-bold small">บริการ OpenSSH & Syntax Check</div>
                                <small class="text-muted d-block" style="font-size: 0.75rem;">ตรวจสอบ sshd.exe -t และควบคุมบริการ</small>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </button>

                    <button class="quick-action-card text-start" @onclick='() => Navigation.NavigateTo("settings")'>
                        <div class="d-flex align-items-center gap-2.5">
                            <i class="bi bi-gear-fill text-primary fs-5"></i>
                            <div>
                                <div class="fw-bold small">ตั้งค่า Active Directory / LDAP</div>
                                <small class="text-muted d-block" style="font-size: 0.75rem;">เชื่อมต่อ Domain Controller และรหัสผ่านฉุกเฉิน</small>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </button>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-white border-bottom pt-3 pb-2 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-clock-history text-primary"></i>
                        <span>ประวัติกิจกรรมล่าสุด (Recent Audit Logs)</span>
                    </h6>
                    <button class="btn btn-outline-primary btn-sm py-0.5 px-2" @onclick='() => Navigation.NavigateTo("audit")'>
                        <span>ดูทั้งหมด</span>
                        <i class="bi bi-arrow-right"></i>
                    </button>
                </div>
                <div class="card-body p-0">
                    @if (recentLogs == null || recentLogs.Count == 0)
                    {
                        <div class="text-center text-muted py-5">
                            <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                            <p class="small mb-0">ยังไม่มีบันทึกประวัติกิจกรรม (Audit Log)</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0 small">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-3">เวลา</th>
                                        <th>Action</th>
                                        <th>ผู้ดำเนินการ</th>
                                        <th>รายละเอียด</th>
                                        <th class="pe-3">สถานะ</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var log in recentLogs)
                                    {
                                        <tr>
                                            <td class="ps-3 text-nowrap text-muted font-monospace">@log.Timestamp.ToLocalTime().ToString("dd/MM HH:mm:ss")</td>
                                            <td><span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle font-monospace">@log.Action</span></td>
                                            <td class="fw-semibold">@log.Operator</td>
                                            <td class="text-truncate" style="max-width: 260px;" title="@log.Details">@log.Details</td>
                                            <td class="pe-3">
                                                @if (log.IsSuccess)
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                        <i class="bi bi-check-circle-fill"></i>
                                                        <span>สำเร็จ</span>
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                                        <i class="bi bi-x-circle-fill"></i>
                                                        <span>ล้มเหลว</span>
                                                    </span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private int usersCount;
    private int activeUsersCount;
    private int keysCount;
    private long totalStorageBytes;
    private ServiceStatusInfo? serviceStatus;
    private List<AuditLog>? recentLogs;
    private string? statusMessage;
    private CancellationTokenSource? _storageCts;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardData();
    }

    private async Task LoadDashboardData()
    {
        try
        {
            var users = await UserService.GetAllUsersAsync();
            var groups = await GroupService.GetAllGroupsAsync();
            usersCount = users.Count;
            activeUsersCount = users.Count(u => u.IsActive);
            keysCount = users.Sum(u => u.PublicKeys.Count);

            serviceStatus = SshManager.GetStatus();
            recentLogs = await AuditService.GetRecentLogsAsync(8);

            // Cancel any in-flight storage calculation before starting a new one
            _storageCts?.Cancel();
            _storageCts?.Dispose();
            _storageCts = new CancellationTokenSource();
            var token = _storageCts.Token;

            // Compute storage asynchronously in background so dashboard renders immediately
            _ = Task.Run(async () =>
            {
                try
                {
                    long total = 0;
                    // 1. Calculate users' storage
                    foreach (var u in users)
                    {
                        token.ThrowIfCancellationRequested();
                        total += await FileBrowser.GetTotalUserStorageBytesAsync(u.Username, token);
                    }
                    // 2. Calculate groups' shared folder storage
                    foreach (var g in groups)
                    {
                        token.ThrowIfCancellationRequested();
                        total += await FileBrowser.GetTotalGroupStorageBytesAsync(g.Name, token);
                    }
                    if (!token.IsCancellationRequested)
                    {
                        totalStorageBytes = total;
                        await InvokeAsync(StateHasChanged);
                    }
                }
                catch (OperationCanceledException)
                {
                    // Cancelled due to refresh or navigation
                }
                catch (ObjectDisposedException)
                {
                    // Component disposed
                }
            }, token);
        }
        catch (Exception ex)
        {
            statusMessage = $"เกิดข้อผิดพลาดในการโหลดข้อมูล: {ex.Message}";
        }
    }

    public void Dispose()
    {
        _storageCts?.Cancel();
        _storageCts?.Dispose();
    }

    private async Task InstallZeroConfig()
    {
        var result = await SshManager.ApplyZeroConfigBlockAsync();
        statusMessage = result.Message;
        await LoadDashboardData();
    }

    private string FormatBytes(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB", "TB" };
        int order = 0;
        double len = bytes;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len /= 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }
}
