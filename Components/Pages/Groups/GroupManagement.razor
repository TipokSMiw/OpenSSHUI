@page "/groups"
@rendermode InteractiveServer
@inject ISftpGroupService GroupService
@inject ISftpUserService UserService
@inject IOpenSshServiceManager SshManager
@inject UserSessionState SessionState
@inject NavigationManager Navigation

<PageTitle>SFTP Groups - OpensshUI</PageTitle>

<div class="container-fluid p-0">
    <!-- Standardized Page Header -->
    <div class="page-header">
        <div>
            <h3 class="page-title">
                <i class="bi bi-collection-fill text-primary"></i>
                <span>จัดการกลุ่มผู้ใช้งาน SFTP (SFTP Groups)</span>
            </h3>
            <p class="text-muted small mb-0">กำหนดโฟลเดอร์แชร์ร่วมกัน (Shared Folders), สิทธิ์ NTFS ACL, NTFS Directory Junctions และสมาชิกในกลุ่ม</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-outline-secondary btn-sm" @onclick="LoadData">
                <i class="bi bi-arrow-clockwise"></i>
                <span>รีเฟรช</span>
            </button>
            @if (SessionState.CanManageSftp)
            {
                <button class="btn btn-primary btn-sm" @onclick="OpenCreateModal">
                    <i class="bi bi-plus-circle-fill"></i>
                    <span>สร้างกลุ่มใหม่</span>
                </button>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_statusMessage))
    {
        <div class="alert @(_isSuccessStatus ? "alert-success" : "alert-danger") alert-dismissible fade show py-2 small d-flex align-items-center gap-2" role="alert">
            <i class="bi @(_isSuccessStatus ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") flex-shrink-0"></i>
            <div>@_statusMessage</div>
            <button type="button" class="btn-close" @onclick="() => _statusMessage = null"></button>
        </div>
    }

    <!-- Search & Filter Bar -->
    <div class="card border-0 shadow-sm rounded-3 mb-3">
        <div class="card-body py-2.5 px-3">
            <div class="row g-2 align-items-end">
                <div class="col-md-5">
                    <label class="form-label small fw-bold mb-1">ค้นหากลุ่มแชร์ไฟล์</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control border-start-0" placeholder="เช่น Marketing, Finance หรือ D:\SFTPShare..." @bind="_searchTerm" @bind:event="oninput" />
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold mb-1">โหมดการเข้าถึง (Access Mode)</label>
                    <select class="form-select form-select-sm" @bind="_modeFilter">
                        <option value="">ทุกโหมดการเข้าถึง (All Modes)</option>
                        <option value="VirtualFolder">Virtual Folder (โฟลเดอร์ย่อยใน Home)</option>
                        <option value="DirectChroot">Direct Chroot (โฟลเดอร์หลักโดยตรง)</option>
                    </select>
                </div>
                <div class="col-md-4 d-flex justify-content-end align-items-center gap-2">
                    @if (!string.IsNullOrWhiteSpace(_searchTerm) || !string.IsNullOrWhiteSpace(_modeFilter))
                    {
                        <button class="btn btn-outline-secondary btn-sm py-0.5 px-2" title="ล้างตัวกรองทั้งหมด" @onclick="ClearFilters">
                            <i class="bi bi-x-circle"></i>
                            <span>ล้างตัวกรอง</span>
                        </button>
                    }
                    <span class="text-muted small text-nowrap">
                        แสดง <strong>@FilteredGroups.Count</strong> รายการ
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Groups Table -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
            @if (_loading)
            {
                <div class="text-center py-5">
                    <span class="spinner-border spinner-border-sm text-primary"></span>
                    <p class="text-muted small mt-2 mb-0">กำลังโหลดข้อมูลกลุ่มผู้ใช้งาน...</p>
                </div>
            }
            else if (FilteredGroups.Count == 0)
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-collection fs-1 d-block mb-2"></i>
                    <p class="mb-0">ไม่พบกลุ่มผู้ใช้งาน SFTP คลิกปุ่ม <strong>สร้างกลุ่มใหม่</strong> เพื่อเริ่มต้นใช้งาน</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small text-muted">
                            <tr>
                                <th class="ps-3">ชื่อกลุ่ม (GROUP)</th>
                                <th>SHARED ROOT PATH</th>
                                <th>ACCESS MODE</th>
                                <th>ระดับสิทธิ์</th>
                                <th>สมาชิก</th>
                                <th>วันที่สร้าง</th>
                                <th class="text-end pe-3">การจัดการ (ACTIONS)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var grp in FilteredGroups)
                            {
                                <tr>
                                    <td class="ps-3">
                                        <div class="fw-bold d-flex align-items-center gap-1.5">
                                            <i class="bi bi-collection text-primary"></i>
                                            <span>@grp.Name</span>
                                        </div>
                                        @if (!string.IsNullOrEmpty(grp.Description))
                                        {
                                            <small class="text-muted">@grp.Description</small>
                                        }
                                    </td>
                                    <td>
                                        <div class="path-badge path-badge-default text-wrap" title="โฟลเดอร์หลักของกลุ่ม: @grp.RootPath">
                                            <i class="bi bi-folder2-open"></i>
                                            <span class="path-text">@grp.RootPath</span>
                                        </div>
                                    </td>
                                    <td>
                                        @if (grp.AccessMode == SftpAccessMode.VirtualFolder)
                                        {
                                            <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle" title="ปรากฏเป็นโฟลเดอร์ย่อยภายใน Home ของผู้ใช้">
                                                <i class="bi bi-folder-symlink"></i>
                                                <span>Virtual Folder</span>
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle" title="เข้าถึงโฟลเดอร์กลุ่มเป็น Chroot หลักโดยตรง">
                                                <i class="bi bi-box-arrow-in-down-right"></i>
                                                <span>Direct Chroot</span>
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (grp.PermissionType == SftpPermissionType.ReadWrite)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                <i class="bi bi-pencil-square"></i>
                                                <span>Read & Write</span>
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle">
                                                <i class="bi bi-eye"></i>
                                                <span>Read-Only</span>
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary py-0.5 px-2.5 rounded-pill" title="คลิกเพื่อดูและจัดการสมาชิกในกลุ่ม" @onclick="() => OpenMembersModal(grp)">
                                            <i class="bi bi-people-fill"></i>
                                            <span>@grp.Members.Count คน</span>
                                        </button>
                                    </td>
                                    <td class="small text-muted text-nowrap font-monospace">
                                        @grp.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")
                                    </td>
                                    <td class="text-end pe-3">
                                        <div class="action-bar">
                                            <button class="btn btn-sm btn-outline-primary" title="เปิดดูและจัดการไฟล์ของกลุ่มนี้ใน Web File Browser" @onclick='() => Navigation.NavigateTo($"files/group/{grp.Name}")'>
                                                <i class="bi bi-folder2-open"></i>
                                                <span>ไฟล์</span>
                                            </button>
                                            @if (SessionState.CanManageSftp)
                                            {
                                                <span class="action-divider"></span>
                                                <button class="btn btn-sm btn-outline-secondary" title="แก้ไขการตั้งค่ากลุ่มและสมาชิก" @onclick="() => OpenEditModal(grp)">
                                                    <i class="bi bi-pencil-square"></i>
                                                    <span>แก้ไข</span>
                                                </button>
                                                <span class="action-divider"></span>
                                                <button class="btn btn-sm btn-outline-danger" title="ลบกลุ่มผู้ใช้งาน" @onclick="() => OpenDeleteModal(grp)">
                                                    <i class="bi bi-trash3"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal: Create Group -->
@if (_showCreateModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title d-flex align-items-center gap-2">
                        <i class="bi bi-collection-fill text-primary"></i>
                        <span>สร้างกลุ่มผู้ใช้งาน SFTP ใหม่ (Guided Setup)</span>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseModals"></button>
                </div>
                <div class="modal-body p-4">
                    @if (!string.IsNullOrEmpty(_modalError))
                    {
                        <div class="alert alert-danger py-2 small d-flex align-items-center gap-2 mb-3">
                            <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                            <div>@_modalError</div>
                        </div>
                    }

                    <!-- Step 1: Identity & Shared Folder -->
                    <div class="form-step-header">
                        <div class="form-step-title">
                            <span class="form-step-badge">1</span>
                            <span>ข้อมูลกลุ่มและโฟลเดอร์หลัก (Group Identity & Shared Path)</span>
                        </div>
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle" style="font-size: 0.7rem;">จำเป็น</span>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label small fw-bold mb-0">ชื่อกลุ่ม (Group Name) <span class="text-danger">*</span></label>
                                @if (!string.IsNullOrWhiteSpace(_createRequest.Name))
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace" style="font-size: 0.7rem;">
                                        OS Group: SFTP-@(_createRequest.Name.Trim())
                                    </span>
                                }
                            </div>
                            <input type="text" class="form-control form-control-sm" placeholder="เช่น Marketing, FinanceTeam, VendorShare" @bind="_createRequest.Name" @bind:event="oninput" />
                        </div>

                        <div class="col-md-6">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label small fw-bold mb-0">คำอธิบาย (Description)</label>
                                <span class="text-muted" style="font-size: 0.75rem;">ไม่บังคับ</span>
                            </div>
                            <input type="text" class="form-control form-control-sm" placeholder="เช่น โฟลเดอร์แลกเปลี่ยนเอกสารฝ่ายการตลาด" @bind="_createRequest.Description" />
                        </div>

                        <div class="col-12">
                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-1 mb-1">
                                <label class="form-label small fw-bold mb-0">โฟลเดอร์หลักของกลุ่ม (Shared Root Path) <span class="text-danger">*</span></label>
                                @if (!string.IsNullOrEmpty(SuggestedCreateGroupPath) && !string.Equals(_createRequest.RootPath, SuggestedCreateGroupPath, StringComparison.OrdinalIgnoreCase))
                                {
                                    <button type="button" class="auto-fill-chip" title="คลิกเพื่อเติม Path มาตรฐานของกลุ่มอัตโนมัติ" @onclick="ApplySuggestedCreateGroupPath">
                                        <i class="bi bi-lightning-charge-fill"></i>
                                        <span>เติมอัตโนมัติ: @SuggestedCreateGroupPath</span>
                                    </button>
                                }
                            </div>
                            <div class="input-group input-group-sm">
                                <input type="text" class="form-control font-monospace" placeholder="เช่น D:\SFTPShare\Marketing (หากยังไม่มี ระบบจะสร้างให้อัตโนมัติ)" @bind="_createRequest.RootPath" @bind:event="oninput" />
                                <button class="btn btn-outline-secondary" type="button" @onclick="OpenFolderBrowserForCreate">
                                    <i class="bi bi-folder2-open"></i>
                                    <span>เลือกโฟลเดอร์...</span>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Step 2: Access Mode & Permissions -->
                    <div class="form-step-header">
                        <div class="form-step-title">
                            <span class="form-step-badge">2</span>
                            <span>โหมดการเข้าถึงและระดับสิทธิ์ (Access Mode &amp; NTFS Permission)</span>
                        </div>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle" style="font-size: 0.72rem;">กรอบสีฟ้า = กำลังเลือกอยู่</span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold mb-2">เลือกรูปแบบการมองเห็นโฟลเดอร์ (Access Mode)</label>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="selection-card @(_createRequest.AccessMode == SftpAccessMode.VirtualFolder ? "active" : "")"
                                     @onclick="() => _createRequest.AccessMode = SftpAccessMode.VirtualFolder">
                                    <div>
                                        <div class="fw-bold small d-flex align-items-center gap-2">
                                            <i class="bi @(_createRequest.AccessMode == SftpAccessMode.VirtualFolder ? "bi-check-circle-fill text-primary" : "bi-circle text-muted") fs-6"></i>
                                            <i class="bi bi-folder-symlink text-primary"></i>
                                            <span>Virtual Folder (NTFS Junction)</span>
                                        </div>
                                        <div class="text-muted small mt-1" style="font-size: 0.78rem;">
                                            ปรากฏเป็นโฟลเดอร์ย่อยใน Home ของสมาชิก อยู่ได้หลายกลุ่มพร้อมกัน
                                        </div>
                                    </div>
                                    @if (_createRequest.AccessMode == SftpAccessMode.VirtualFolder)
                                    {
                                        <span class="badge bg-primary text-white flex-shrink-0"><i class="bi bi-check-lg"></i> เลือกอยู่</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-secondary border flex-shrink-0">คลิกเลือก</span>
                                    }
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="selection-card @(_createRequest.AccessMode == SftpAccessMode.DirectChroot ? "active" : "")"
                                     @onclick="() => _createRequest.AccessMode = SftpAccessMode.DirectChroot">
                                    <div>
                                        <div class="fw-bold small d-flex align-items-center gap-2">
                                            <i class="bi @(_createRequest.AccessMode == SftpAccessMode.DirectChroot ? "bi-check-circle-fill text-primary" : "bi-circle text-muted") fs-6"></i>
                                            <i class="bi bi-box-arrow-in-down-right text-primary"></i>
                                            <span>Direct Chroot</span>
                                        </div>
                                        <div class="text-muted small mt-1" style="font-size: 0.78rem;">
                                            ใช้โฟลเดอร์กลุ่มเป็น Root หลักทันทีเมื่อสมาชิกเชื่อมต่อเข้ามา
                                        </div>
                                    </div>
                                    @if (_createRequest.AccessMode == SftpAccessMode.DirectChroot)
                                    {
                                        <span class="badge bg-primary text-white flex-shrink-0"><i class="bi bi-check-lg"></i> เลือกอยู่</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-secondary border flex-shrink-0">คลิกเลือก</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-bold mb-2">เลือกระดับสิทธิ์ของสมาชิก (Permission Level)</label>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="selection-card @(_createRequest.PermissionType == SftpPermissionType.ReadWrite ? "active" : "")"
                                     @onclick="() => _createRequest.PermissionType = SftpPermissionType.ReadWrite">
                                    <div>
                                        <div class="fw-bold small d-flex align-items-center gap-2">
                                            <i class="bi @(_createRequest.PermissionType == SftpPermissionType.ReadWrite ? "bi-check-circle-fill text-primary" : "bi-circle text-muted") fs-6"></i>
                                            <i class="bi bi-pencil-square text-success"></i>
                                            <span>Read &amp; Write (อ่านและเขียนไฟล์)</span>
                                        </div>
                                        <div class="text-muted small mt-1" style="font-size: 0.78rem;">
                                            อัปโหลด ดาวน์โหลด แก้ไข และลบไฟล์ในกลุ่มได้
                                        </div>
                                    </div>
                                    @if (_createRequest.PermissionType == SftpPermissionType.ReadWrite)
                                    {
                                        <span class="badge bg-primary text-white flex-shrink-0"><i class="bi bi-check-lg"></i> เลือกอยู่</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-secondary border flex-shrink-0">คลิกเลือก</span>
                                    }
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="selection-card @(_createRequest.PermissionType == SftpPermissionType.ReadOnly ? "active" : "")"
                                     @onclick="() => _createRequest.PermissionType = SftpPermissionType.ReadOnly">
                                    <div>
                                        <div class="fw-bold small d-flex align-items-center gap-2">
                                            <i class="bi @(_createRequest.PermissionType == SftpPermissionType.ReadOnly ? "bi-check-circle-fill text-primary" : "bi-circle text-muted") fs-6"></i>
                                            <i class="bi bi-eye text-secondary"></i>
                                            <span>Read-Only (อ่านอย่างเดียว)</span>
                                        </div>
                                        <div class="text-muted small mt-1" style="font-size: 0.78rem;">
                                            เปิดดูและดาวน์โหลดไฟล์ได้อย่างเดียว ห้ามแก้ไขหรือลบ
                                        </div>
                                    </div>
                                    @if (_createRequest.PermissionType == SftpPermissionType.ReadOnly)
                                    {
                                        <span class="badge bg-primary text-white flex-shrink-0"><i class="bi bi-check-lg"></i> เลือกอยู่</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-secondary border flex-shrink-0">คลิกเลือก</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Step 3: Initial Members (Searchable Dropdown + Blue Highlighted Box) -->
                    <div class="form-step-header">
                        <div class="form-step-title">
                            <span class="form-step-badge">3</span>
                            <span>เลือกสมาชิกเริ่มต้น (Initial Members)</span>
                        </div>
                        <span class="badge bg-primary text-white px-2.5 py-1">
                            <i class="bi bi-people-fill"></i>
                            <span>เลือกแล้ว @_createRequest.InitialMembers.Count คน</span>
                        </span>
                    </div>

                    <!-- Blue Highlighted Selected Members Box -->
                    <div class="selected-items-box mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="small fw-bold text-primary-emphasis d-inline-flex align-items-center gap-1.5">
                                <i class="bi bi-check-circle-fill text-primary"></i>
                                <span>รายชื่อสมาชิกที่เลือกอยู่ (@_createRequest.InitialMembers.Count คน):</span>
                            </span>
                            @if (_createRequest.InitialMembers.Count > 0)
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2" style="font-size: 0.75rem;" @onclick="() => _createRequest.InitialMembers.Clear()">
                                    <i class="bi bi-trash3"></i>
                                    <span>ล้างทั้งหมด</span>
                                </button>
                            }
                        </div>
                        @if (_createRequest.InitialMembers.Count == 0)
                        {
                            <div class="small text-secondary">ยังไม่ได้เลือกสมาชิก — พิมพ์ค้นหาและคลิกเลือกรายชื่อจาก Dropdown ด้านล่าง</div>
                        }
                        else
                        {
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var uname in _createRequest.InitialMembers.ToList())
                                {
                                    var uInfo = _allUsers.FirstOrDefault(x => string.Equals(x.Username, uname, StringComparison.OrdinalIgnoreCase));
                                    <span class="selected-item-pill">
                                        <i class="bi bi-person-check-fill"></i>
                                        <span class="font-monospace">@uname</span>
                                        @if (uInfo != null && !string.IsNullOrEmpty(uInfo.DisplayName) && uInfo.DisplayName != uname)
                                        {
                                            <span class="fw-normal opacity-75">(@uInfo.DisplayName)</span>
                                        }
                                        <button type="button" class="selected-item-remove" title="นำผู้ใช้นี้ออก" @onclick="() => ToggleMemberByClick(_createRequest.InitialMembers, uname)">
                                            <i class="bi bi-x"></i>
                                        </button>
                                    </span>
                                }
                            </div>
                        }
                    </div>

                    <!-- Searchable Vertical Dropdown List -->
                    <div class="searchable-dropdown-panel mb-4">
                        <div class="p-2.5 bg-light border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <div class="input-group input-group-sm" style="max-width: 380px;">
                                <span class="input-group-text bg-white text-primary border-primary"><i class="bi bi-search"></i></span>
                                <input type="text" class="form-control border-primary" placeholder="พิมพ์ค้นหา Username หรือชื่อ-นามสกุลเพื่อกรองรายการ..."
                                       @bind="_memberSearchTerm" @bind:event="oninput" @onfocus="() => _isMemberDropdownOpen = true" />
                                @if (!string.IsNullOrWhiteSpace(_memberSearchTerm))
                                {
                                    <button type="button" class="btn btn-outline-secondary" @onclick="() => _memberSearchTerm = string.Empty">
                                        <i class="bi bi-x"></i>
                                    </button>
                                }
                            </div>
                            <div class="d-flex align-items-center gap-1.5">
                                <button type="button" class="btn btn-outline-primary btn-sm py-0.5 px-2" style="font-size: 0.75rem;" @onclick="() => SelectAllMembers(_createRequest.InitialMembers)">
                                    <i class="bi bi-check2-all"></i>
                                    <span>เลือกทั้งหมดที่กรอง (@FilteredMemberCandidates.Count())</span>
                                </button>
                                <button type="button" class="btn btn-outline-secondary btn-sm py-0.5 px-2" style="font-size: 0.75rem;" @onclick="() => _isMemberDropdownOpen = !_isMemberDropdownOpen">
                                    <i class="bi @(_isMemberDropdownOpen ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                    <span>@(_isMemberDropdownOpen ? "พับรายการ" : "กางรายการ")</span>
                                </button>
                            </div>
                        </div>

                        @if (_isMemberDropdownOpen)
                        {
                            <div class="searchable-dropdown-list">
                                @if (_allUsers.Count == 0)
                                {
                                    <div class="text-muted text-center py-3 small">ยังไม่มีผู้ใช้งานในระบบ (สามารถเพิ่มภายหลังได้)</div>
                                }
                                else if (!FilteredMemberCandidates.Any())
                                {
                                    <div class="text-muted text-center py-3 small">ไม่พบรายชื่อผู้ใช้ที่ตรงกับคำค้นหา "@_memberSearchTerm"</div>
                                }
                                else
                                {
                                    @foreach (var user in FilteredMemberCandidates)
                                    {
                                        bool isSelected = _createRequest.InitialMembers.Contains(user.Username);
                                        <button type="button" class="searchable-dropdown-item @(isSelected ? "selected" : "")"
                                                @onclick="() => ToggleMemberByClick(_createRequest.InitialMembers, user.Username)">
                                            <div class="d-flex align-items-center gap-2.5">
                                                <i class="bi @(isSelected ? "bi-check-square-fill text-primary" : "bi-square text-muted") fs-6"></i>
                                                <div>
                                                    <span class="font-monospace fw-bold small text-dark">@user.Username</span>
                                                    @if (!string.IsNullOrEmpty(user.DisplayName) && user.DisplayName != user.Username)
                                                    {
                                                        <span class="text-muted small ms-2">(@user.DisplayName)</span>
                                                    }
                                                </div>
                                            </div>
                                            @if (isSelected)
                                            {
                                                <span class="badge bg-primary text-white"><i class="bi bi-check-lg"></i> เลือกอยู่</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-secondary border">@(user.AccountType == SftpAccountType.LocalWindows ? "Local" : "AD")</span>
                                            }
                                        </button>
                                    }
                                }
                            </div>
                        }
                    </div>

                    <!-- Live Effective Group Summary -->
                    <div class="effective-preview-box d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <div class="small">
                            <div class="fw-bold d-flex align-items-center gap-1.5">
                                <i class="bi bi-check2-circle"></i>
                                <span>สรุปผลลัพธ์การเข้าถึงของกลุ่ม (Effective Group Access):</span>
                            </div>
                            <div class="font-monospace mt-0.5">
                                @if (_createRequest.AccessMode == SftpAccessMode.VirtualFolder)
                                {
                                    <span>สมาชิกจะเห็นโฟลเดอร์ย่อย <strong>/@(string.IsNullOrWhiteSpace(_createRequest.Name) ? "{GroupName}" : _createRequest.Name.Trim())</strong> เชื่อมไปยัง <strong>@(string.IsNullOrWhiteSpace(_createRequest.RootPath) ? "{RootPath}" : _createRequest.RootPath.Trim())</strong></span>
                                }
                                else
                                {
                                    <span>สมาชิกจะเข้าสู่ Chroot หลักที่ <strong>@(string.IsNullOrWhiteSpace(_createRequest.RootPath) ? "{RootPath}" : _createRequest.RootPath.Trim())</strong> โดยตรง</span>
                                }
                            </div>
                        </div>
                        <span class="badge bg-white text-primary border border-primary-subtle">
                            @(_createRequest.PermissionType == SftpPermissionType.ReadWrite ? "สิทธิ์ Read & Write" : "สิทธิ์ Read-Only")
                        </span>
                    </div>
                </div>
                <div class="modal-footer bg-light d-flex justify-content-between align-items-center">
                    <div class="small">
                        @if (IsCreateGroupValid)
                        {
                            <span class="text-success fw-semibold d-inline-flex align-items-center gap-1">
                                <i class="bi bi-check-circle-fill"></i>
                                <span>ข้อมูลครบถ้วน พร้อมสร้างกลุ่มทันที</span>
                            </span>
                        }
                        else
                        {
                            <span class="text-warning-emphasis d-inline-flex align-items-center gap-1">
                                <i class="bi bi-info-circle-fill"></i>
                                <span>กรุณาระบุชื่อกลุ่มและโฟลเดอร์หลัก (*) ให้ครบ</span>
                            </span>
                        }
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CloseModals">ยกเลิก</button>
                        <button type="button" class="btn btn-primary btn-sm px-3" @onclick="SaveCreateGroup" disabled="@(_saving || !IsCreateGroupValid)">
                            @if (_saving)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                                <span>กำลังสร้าง...</span>
                            }
                            else
                            {
                                <i class="bi bi-check-lg"></i>
                                <span>@(IsCreateGroupValid ? $"บันทึกและสร้างกลุ่ม {_createRequest.Name.Trim()}" : "กรุณากรอกข้อมูลให้ครบ")</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal: Edit Group -->
@if (_showEditModal && _selectedGroup != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title d-flex align-items-center gap-2">
                        <i class="bi bi-pencil-square text-primary"></i>
                        <span>แก้ไขกลุ่มผู้ใช้งาน: @_selectedGroup.Name</span>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseModals"></button>
                </div>
                <div class="modal-body p-4">
                    @if (!string.IsNullOrEmpty(_modalError))
                    {
                        <div class="alert alert-danger py-2 small d-flex align-items-center gap-2 mb-3">
                            <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                            <div>@_modalError</div>
                        </div>
                    }

                    <!-- Step 1: Identity & Shared Folder -->
                    <div class="form-step-header">
                        <div class="form-step-title">
                            <span class="form-step-badge">1</span>
                            <span>ข้อมูลกลุ่มและโฟลเดอร์หลัก (Group Identity & Shared Path)</span>
                        </div>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace" style="font-size: 0.7rem;">
                            OS Group: SFTP-@_selectedGroup.Name
                        </span>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold mb-1">ชื่อกลุ่ม (Group Name)</label>
                            <input type="text" class="form-control form-control-sm" value="@_selectedGroup.Name" disabled />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-bold mb-1">คำอธิบาย (Description)</label>
                            <input type="text" class="form-control form-control-sm" placeholder="ระบุคำอธิบายเพิ่มเติมของกลุ่มนี้..." @bind="_editRequest.Description" />
                        </div>

                        <div class="col-12">
                            <label class="form-label small fw-bold mb-1">โฟลเดอร์หลักของกลุ่ม (Shared Root Path) <span class="text-danger">*</span></label>
                            <div class="input-group input-group-sm">
                                <input type="text" class="form-control font-monospace" placeholder="เช่น D:\SFTPShare\Marketing" @bind="_editRequest.RootPath" @bind:event="oninput" />
                                <button class="btn btn-outline-secondary" type="button" @onclick="OpenFolderBrowserForEdit">
                                    <i class="bi bi-folder2-open"></i>
                                    <span>เลือกโฟลเดอร์...</span>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Step 2: Access Mode & Permissions -->
                    <div class="form-step-header">
                        <div class="form-step-title">
                            <span class="form-step-badge">2</span>
                            <span>โหมดการเข้าถึงและระดับสิทธิ์ (Access Mode &amp; NTFS Permission)</span>
                        </div>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle" style="font-size: 0.72rem;">กรอบสีฟ้า = กำลังเลือกอยู่</span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold mb-2">รูปแบบการมองเห็นโฟลเดอร์ (Access Mode)</label>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="selection-card @(_editRequest.AccessMode == SftpAccessMode.VirtualFolder ? "active" : "")"
                                     @onclick="() => _editRequest.AccessMode = SftpAccessMode.VirtualFolder">
                                    <div>
                                        <div class="fw-bold small d-flex align-items-center gap-2">
                                            <i class="bi @(_editRequest.AccessMode == SftpAccessMode.VirtualFolder ? "bi-check-circle-fill text-primary" : "bi-circle text-muted") fs-6"></i>
                                            <i class="bi bi-folder-symlink text-primary"></i>
                                            <span>Virtual Folder (NTFS Junction)</span>
                                        </div>
                                        <div class="text-muted small mt-1" style="font-size: 0.78rem;">
                                            ปรากฏเป็นโฟลเดอร์ย่อยใน Home ของสมาชิก
                                        </div>
                                    </div>
                                    @if (_editRequest.AccessMode == SftpAccessMode.VirtualFolder)
                                    {
                                        <span class="badge bg-primary text-white flex-shrink-0"><i class="bi bi-check-lg"></i> เลือกอยู่</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-secondary border flex-shrink-0">คลิกเลือก</span>
                                    }
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="selection-card @(_editRequest.AccessMode == SftpAccessMode.DirectChroot ? "active" : "")"
                                     @onclick="() => _editRequest.AccessMode = SftpAccessMode.DirectChroot">
                                    <div>
                                        <div class="fw-bold small d-flex align-items-center gap-2">
                                            <i class="bi @(_editRequest.AccessMode == SftpAccessMode.DirectChroot ? "bi-check-circle-fill text-primary" : "bi-circle text-muted") fs-6"></i>
                                            <i class="bi bi-box-arrow-in-down-right text-primary"></i>
                                            <span>Direct Chroot</span>
                                        </div>
                                        <div class="text-muted small mt-1" style="font-size: 0.78rem;">
                                            ใช้โฟลเดอร์กลุ่มเป็น Root หลักโดยตรง
                                        </div>
                                    </div>
                                    @if (_editRequest.AccessMode == SftpAccessMode.DirectChroot)
                                    {
                                        <span class="badge bg-primary text-white flex-shrink-0"><i class="bi bi-check-lg"></i> เลือกอยู่</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-secondary border flex-shrink-0">คลิกเลือก</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-bold mb-2">ระดับสิทธิ์ของสมาชิก (Permission Level)</label>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="selection-card @(_editRequest.PermissionType == SftpPermissionType.ReadWrite ? "active" : "")"
                                     @onclick="() => _editRequest.PermissionType = SftpPermissionType.ReadWrite">
                                    <div>
                                        <div class="fw-bold small d-flex align-items-center gap-2">
                                            <i class="bi @(_editRequest.PermissionType == SftpPermissionType.ReadWrite ? "bi-check-circle-fill text-primary" : "bi-circle text-muted") fs-6"></i>
                                            <i class="bi bi-pencil-square text-success"></i>
                                            <span>Read &amp; Write (อ่านและเขียนไฟล์)</span>
                                        </div>
                                        <div class="text-muted small mt-1" style="font-size: 0.78rem;">
                                            อัปโหลด ดาวน์โหลด แก้ไข และลบไฟล์ได้
                                        </div>
                                    </div>
                                    @if (_editRequest.PermissionType == SftpPermissionType.ReadWrite)
                                    {
                                        <span class="badge bg-primary text-white flex-shrink-0"><i class="bi bi-check-lg"></i> เลือกอยู่</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-secondary border flex-shrink-0">คลิกเลือก</span>
                                    }
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="selection-card @(_editRequest.PermissionType == SftpPermissionType.ReadOnly ? "active" : "")"
                                     @onclick="() => _editRequest.PermissionType = SftpPermissionType.ReadOnly">
                                    <div>
                                        <div class="fw-bold small d-flex align-items-center gap-2">
                                            <i class="bi @(_editRequest.PermissionType == SftpPermissionType.ReadOnly ? "bi-check-circle-fill text-primary" : "bi-circle text-muted") fs-6"></i>
                                            <i class="bi bi-eye text-secondary"></i>
                                            <span>Read-Only (อ่านอย่างเดียว)</span>
                                        </div>
                                        <div class="text-muted small mt-1" style="font-size: 0.78rem;">
                                            เปิดดูและดาวน์โหลดไฟล์ได้อย่างเดียว
                                        </div>
                                    </div>
                                    @if (_editRequest.PermissionType == SftpPermissionType.ReadOnly)
                                    {
                                        <span class="badge bg-primary text-white flex-shrink-0"><i class="bi bi-check-lg"></i> เลือกอยู่</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-secondary border flex-shrink-0">คลิกเลือก</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Step 3: Members (Searchable Dropdown + Blue Highlighted Box) -->
                    <div class="form-step-header">
                        <div class="form-step-title">
                            <span class="form-step-badge">3</span>
                            <span>สมาชิกในกลุ่ม (Group Members)</span>
                        </div>
                        <span class="badge bg-primary text-white px-2.5 py-1">
                            <i class="bi bi-people-fill"></i>
                            <span>เลือกแล้ว @_editRequest.Members.Count คน</span>
                        </span>
                    </div>

                    <!-- Blue Highlighted Selected Members Box -->
                    <div class="selected-items-box mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="small fw-bold text-primary-emphasis d-inline-flex align-items-center gap-1.5">
                                <i class="bi bi-check-circle-fill text-primary"></i>
                                <span>รายชื่อสมาชิกที่เลือกอยู่ (@_editRequest.Members.Count คน):</span>
                            </span>
                            @if (_editRequest.Members.Count > 0)
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2" style="font-size: 0.75rem;" @onclick="() => _editRequest.Members.Clear()">
                                    <i class="bi bi-trash3"></i>
                                    <span>ล้างทั้งหมด</span>
                                </button>
                            }
                        </div>
                        @if (_editRequest.Members.Count == 0)
                        {
                            <div class="small text-secondary">ยังไม่มีสมาชิกในกลุ่มนี้ — พิมพ์ค้นหาและคลิกเลือกรายชื่อจาก Dropdown ด้านล่าง</div>
                        }
                        else
                        {
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var uname in _editRequest.Members.ToList())
                                {
                                    var uInfo = _allUsers.FirstOrDefault(x => string.Equals(x.Username, uname, StringComparison.OrdinalIgnoreCase));
                                    <span class="selected-item-pill">
                                        <i class="bi bi-person-check-fill"></i>
                                        <span class="font-monospace">@uname</span>
                                        @if (uInfo != null && !string.IsNullOrEmpty(uInfo.DisplayName) && uInfo.DisplayName != uname)
                                        {
                                            <span class="fw-normal opacity-75">(@uInfo.DisplayName)</span>
                                        }
                                        <button type="button" class="selected-item-remove" title="นำผู้ใช้นี้ออก" @onclick="() => ToggleMemberByClick(_editRequest.Members, uname)">
                                            <i class="bi bi-x"></i>
                                        </button>
                                    </span>
                                }
                            </div>
                        }
                    </div>

                    <!-- Searchable Vertical Dropdown List -->
                    <div class="searchable-dropdown-panel">
                        <div class="p-2.5 bg-light border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <div class="input-group input-group-sm" style="max-width: 380px;">
                                <span class="input-group-text bg-white text-primary border-primary"><i class="bi bi-search"></i></span>
                                <input type="text" class="form-control border-primary" placeholder="พิมพ์ค้นหา Username หรือชื่อ-นามสกุลเพื่อกรองรายการ..."
                                       @bind="_memberSearchTerm" @bind:event="oninput" @onfocus="() => _isMemberDropdownOpen = true" />
                                @if (!string.IsNullOrWhiteSpace(_memberSearchTerm))
                                {
                                    <button type="button" class="btn btn-outline-secondary" @onclick="() => _memberSearchTerm = string.Empty">
                                        <i class="bi bi-x"></i>
                                    </button>
                                }
                            </div>
                            <div class="d-flex align-items-center gap-1.5">
                                <button type="button" class="btn btn-outline-primary btn-sm py-0.5 px-2" style="font-size: 0.75rem;" @onclick="() => SelectAllMembers(_editRequest.Members)">
                                    <i class="bi bi-check2-all"></i>
                                    <span>เลือกทั้งหมดที่กรอง (@FilteredMemberCandidates.Count())</span>
                                </button>
                                <button type="button" class="btn btn-outline-secondary btn-sm py-0.5 px-2" style="font-size: 0.75rem;" @onclick="() => _isMemberDropdownOpen = !_isMemberDropdownOpen">
                                    <i class="bi @(_isMemberDropdownOpen ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                    <span>@(_isMemberDropdownOpen ? "พับรายการ" : "กางรายการ")</span>
                                </button>
                            </div>
                        </div>

                        @if (_isMemberDropdownOpen)
                        {
                            <div class="searchable-dropdown-list">
                                @if (!FilteredMemberCandidates.Any())
                                {
                                    <div class="text-muted text-center py-3 small">ไม่พบรายชื่อผู้ใช้ที่ตรงกับคำค้นหา "@_memberSearchTerm"</div>
                                }
                                else
                                {
                                    @foreach (var user in FilteredMemberCandidates)
                                    {
                                        bool isSelected = _editRequest.Members.Contains(user.Username);
                                        <button type="button" class="searchable-dropdown-item @(isSelected ? "selected" : "")"
                                                @onclick="() => ToggleMemberByClick(_editRequest.Members, user.Username)">
                                            <div class="d-flex align-items-center gap-2.5">
                                                <i class="bi @(isSelected ? "bi-check-square-fill text-primary" : "bi-square text-muted") fs-6"></i>
                                                <div>
                                                    <span class="font-monospace fw-bold small text-dark">@user.Username</span>
                                                    @if (!string.IsNullOrEmpty(user.DisplayName) && user.DisplayName != user.Username)
                                                    {
                                                        <span class="text-muted small ms-2">(@user.DisplayName)</span>
                                                    }
                                                </div>
                                            </div>
                                            @if (isSelected)
                                            {
                                                <span class="badge bg-primary text-white"><i class="bi bi-check-lg"></i> เลือกอยู่</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-secondary border">@(user.AccountType == SftpAccountType.LocalWindows ? "Local" : "AD")</span>
                                            }
                                        </button>
                                    }
                                }
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer bg-light d-flex justify-content-between align-items-center">
                    <span class="small text-muted">การเปลี่ยนแปลงจะมีผลกับ NTFS ACL และ Junction ของสมาชิกทันที</span>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CloseModals">ยกเลิก</button>
                        <button type="button" class="btn btn-primary btn-sm px-3" @onclick="SaveEditGroup" disabled="@(_saving || string.IsNullOrWhiteSpace(_editRequest.RootPath))">
                            @if (_saving)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                                <span>กำลังบันทึก...</span>
                            }
                            else
                            {
                                <i class="bi bi-check-lg"></i>
                                <span>บันทึกการแก้ไข</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal: View Members -->
@if (_showMembersModal && _selectedGroup != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title d-flex align-items-center gap-2">
                        <i class="bi bi-people-fill text-primary"></i>
                        <span>สมาชิกในกลุ่ม: @_selectedGroup.Name</span>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseModals"></button>
                </div>
                <div class="modal-body p-0">
                    @if (_selectedGroup.Members.Count == 0)
                    {
                        <div class="text-center py-4 text-muted small">ยังไม่มีสมาชิกสังกัดในกลุ่มนี้</div>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var member in _selectedGroup.Members)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center py-2.5 px-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-person-badge text-primary"></i>
                                        <span class="fw-bold">@member.Username</span>
                                    </div>
                                    <span class="small text-muted font-monospace">เข้าร่วม: @member.JoinedAt.ToLocalTime().ToString("dd/MM/yyyy")</span>
                                </li>
                            }
                        </ul>
                    }
                </div>
                <div class="modal-footer bg-light py-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CloseModals">ปิด</button>
                    @if (SessionState.CanManageSftp)
                    {
                        <button type="button" class="btn btn-primary btn-sm" @onclick="() => { var g = _selectedGroup; CloseModals(); if (g != null) OpenEditModal(g); }">
                            <i class="bi bi-person-gear"></i>
                            <span>จัดการสมาชิก</span>
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal: Delete Confirmation -->
@if (_showDeleteModal && _selectedGroup != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title d-flex align-items-center gap-2">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <span>ยืนยันการลบกลุ่ม: @_selectedGroup.Name</span>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseModals"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="mb-3">คุณแน่ใจหรือไม่ว่าต้องการลบกลุ่มผู้ใช้งาน <strong>@_selectedGroup.Name</strong>?</p>
                    <div class="alert alert-info py-2.5 small mb-0 d-flex align-items-start gap-2">
                        <i class="bi bi-shield-check fs-5 flex-shrink-0 mt-0.5"></i>
                        <div>
                            <strong>การคุ้มครองข้อมูล (Data Protection):</strong> โฟลเดอร์แชร์ <code>@_selectedGroup.RootPath</code> และไฟล์ทั้งหมดภายในจะ<strong>ไม่ถูกลบ</strong> ระบบจะถอนเฉพาะสิทธิ์การเข้าถึงและ NTFS Junction เท่านั้น
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CloseModals">ยกเลิก</button>
                    <button type="button" class="btn btn-danger btn-sm" @onclick="ConfirmDeleteGroup" disabled="@_saving">
                        @if (_saving)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                            <span>กำลังลบ...</span>
                        }
                        else
                        {
                            <i class="bi bi-trash3"></i>
                            <span>ยืนยันการลบกลุ่ม</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Shared Folder Browser Modal -->
<FolderPickerModal IsOpen="_showFolderBrowser"
                   CurrentPath="_targetBrowserPath"
                   OnFolderSelected="HandleFolderSelected"
                   OnClosed="() => _showFolderBrowser = false" />

@code {
    private List<SftpGroup> _groups = new();
    private List<SftpUser> _allUsers = new();
    private bool _loading = true;
    private bool _saving = false;
    private string? _statusMessage;
    private bool _isSuccessStatus;
    private string? _modalError;

    private string _searchTerm = string.Empty;
    private string _modeFilter = string.Empty;
    private string _memberSearchTerm = string.Empty;
    private bool _isMemberDropdownOpen = true;

    private void ToggleMemberByClick(List<string> memberList, string username)
    {
        if (memberList.Contains(username))
        {
            memberList.Remove(username);
        }
        else
        {
            memberList.Add(username);
        }
    }

    private bool IsCreateGroupValid =>
        !string.IsNullOrWhiteSpace(_createRequest.Name) &&
        !string.IsNullOrWhiteSpace(_createRequest.RootPath);

    private string SuggestedCreateGroupPath
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_createRequest.Name)) return string.Empty;
            var root = string.IsNullOrWhiteSpace(SshManager.SftpRoot) ? @"C:\SFTPRoot" : SshManager.SftpRoot.TrimEnd('\\', '/');
            return $@"{root}\Groups\{_createRequest.Name.Trim()}";
        }
    }

    private void ApplySuggestedCreateGroupPath()
    {
        if (!string.IsNullOrEmpty(SuggestedCreateGroupPath))
        {
            _createRequest.RootPath = SuggestedCreateGroupPath;
        }
    }

    private IEnumerable<SftpUser> FilteredMemberCandidates =>
        string.IsNullOrWhiteSpace(_memberSearchTerm)
            ? _allUsers
            : _allUsers.Where(u => u.Username.Contains(_memberSearchTerm.Trim(), StringComparison.OrdinalIgnoreCase) ||
                                   (!string.IsNullOrEmpty(u.DisplayName) && u.DisplayName.Contains(_memberSearchTerm.Trim(), StringComparison.OrdinalIgnoreCase)));

    private void SelectAllMembers(List<string> targetList)
    {
        foreach (var u in FilteredMemberCandidates)
        {
            if (!targetList.Contains(u.Username))
            {
                targetList.Add(u.Username);
            }
        }
    }

    // Modals state
    private bool _showCreateModal = false;
    private bool _showEditModal = false;
    private bool _showMembersModal = false;
    private bool _showDeleteModal = false;
    private bool _showFolderBrowser = false;
    private string _folderBrowserTarget = string.Empty; // "create" or "edit"
    private string _targetBrowserPath = string.Empty;

    private SftpGroup? _selectedGroup;
    private CreateGroupRequest _createRequest = new();
    private UpdateGroupRequest _editRequest = new();

    private void ClearFilters()
    {
        _searchTerm = string.Empty;
        _modeFilter = string.Empty;
    }

    private List<SftpGroup> FilteredGroups
    {
        get
        {
            var query = _groups.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                var term = _searchTerm.Trim();
                query = query.Where(g => g.Name.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                                         g.RootPath.Contains(term, StringComparison.OrdinalIgnoreCase));
            }
            if (!string.IsNullOrWhiteSpace(_modeFilter))
            {
                if (Enum.TryParse<SftpAccessMode>(_modeFilter, out var mode))
                {
                    query = query.Where(g => g.AccessMode == mode);
                }
            }
            return query.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            _groups = await GroupService.GetAllGroupsAsync();
            _allUsers = await UserService.GetAllUsersAsync();
        }
        catch (Exception ex)
        {
            _statusMessage = $"เกิดข้อผิดพลาดในการโหลดข้อมูล: {ex.Message}";
            _isSuccessStatus = false;
        }
        finally
        {
            _loading = false;
        }
    }

    private void OpenCreateModal()
    {
        if (!SessionState.CanManageSftp) return;
        _createRequest = new CreateGroupRequest
        {
            AccessMode = SftpAccessMode.VirtualFolder,
            PermissionType = SftpPermissionType.ReadWrite
        };
        _memberSearchTerm = string.Empty;
        _isMemberDropdownOpen = true;
        _modalError = null;
        _showCreateModal = true;
    }

    private void OpenEditModal(SftpGroup group)
    {
        if (!SessionState.CanManageSftp) return;
        _selectedGroup = group;
        _editRequest = new UpdateGroupRequest
        {
            Id = group.Id,
            Description = group.Description,
            RootPath = group.RootPath,
            PermissionType = group.PermissionType,
            AccessMode = group.AccessMode,
            Members = group.Members.Select(m => m.Username).ToList()
        };
        _memberSearchTerm = string.Empty;
        _isMemberDropdownOpen = true;
        _modalError = null;
        _showEditModal = true;
    }

    private void OpenMembersModal(SftpGroup group)
    {
        _selectedGroup = group;
        _showMembersModal = true;
    }

    private void OpenDeleteModal(SftpGroup group)
    {
        if (!SessionState.CanManageSftp) return;
        _selectedGroup = group;
        _showDeleteModal = true;
    }

    private void CloseModals()
    {
        _showCreateModal = false;
        _showEditModal = false;
        _showMembersModal = false;
        _showDeleteModal = false;
        _selectedGroup = null;
        _modalError = null;
    }

    private void OpenFolderBrowserForCreate()
    {
        _folderBrowserTarget = "create";
        _targetBrowserPath = _createRequest.RootPath;
        _showFolderBrowser = true;
    }

    private void OpenFolderBrowserForEdit()
    {
        _folderBrowserTarget = "edit";
        _targetBrowserPath = _editRequest.RootPath;
        _showFolderBrowser = true;
    }

    private void HandleFolderSelected(string path)
    {
        if (_folderBrowserTarget == "create")
        {
            _createRequest.RootPath = path;
        }
        else if (_folderBrowserTarget == "edit")
        {
            _editRequest.RootPath = path;
        }
        _showFolderBrowser = false;
    }

    private void ToggleMemberSelection(List<string> memberList, string username, object? isChecked)
    {
        if (isChecked is bool b && b)
        {
            if (!memberList.Contains(username)) memberList.Add(username);
        }
        else
        {
            memberList.Remove(username);
        }
    }

    private async Task SaveCreateGroup()
    {
        if (!SessionState.CanManageSftp) return;
        if (string.IsNullOrWhiteSpace(_createRequest.Name))
        {
            _modalError = "กรุณาระบุชื่อกลุ่ม (Group Name)";
            return;
        }
        if (string.IsNullOrWhiteSpace(_createRequest.RootPath))
        {
            _modalError = "กรุณาระบุโฟลเดอร์หลัก (Shared Root Path)";
            return;
        }

        _saving = true;
        _modalError = null;
        try
        {
            var op = string.IsNullOrEmpty(SessionState.CurrentUsername) ? "admin" : SessionState.CurrentUsername;
            var (ok, msg, created) = await GroupService.CreateGroupAsync(_createRequest, op);
            if (!ok)
            {
                _modalError = msg;
                return;
            }

            _statusMessage = msg;
            _isSuccessStatus = true;
            CloseModals();
            await LoadData();
        }
        catch (Exception ex)
        {
            _modalError = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SaveEditGroup()
    {
        if (!SessionState.CanManageSftp) return;
        if (string.IsNullOrWhiteSpace(_editRequest.RootPath))
        {
            _modalError = "กรุณาระบุโฟลเดอร์หลัก (Shared Root Path)";
            return;
        }

        _saving = true;
        _modalError = null;
        try
        {
            var op = string.IsNullOrEmpty(SessionState.CurrentUsername) ? "admin" : SessionState.CurrentUsername;
            var (ok, msg) = await GroupService.UpdateGroupAsync(_editRequest, op);
            if (!ok)
            {
                _modalError = msg;
                return;
            }

            _statusMessage = msg;
            _isSuccessStatus = true;
            CloseModals();
            await LoadData();
        }
        catch (Exception ex)
        {
            _modalError = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ConfirmDeleteGroup()
    {
        if (!SessionState.CanManageSftp || _selectedGroup == null) return;

        _saving = true;
        try
        {
            var op = string.IsNullOrEmpty(SessionState.CurrentUsername) ? "admin" : SessionState.CurrentUsername;
            var (ok, msg) = await GroupService.DeleteGroupAsync(_selectedGroup.Id, op);
            _statusMessage = msg;
            _isSuccessStatus = ok;
            CloseModals();
            await LoadData();
        }
        catch (Exception ex)
        {
            _statusMessage = ex.Message;
            _isSuccessStatus = false;
        }
        finally
        {
            _saving = false;
        }
    }
}
