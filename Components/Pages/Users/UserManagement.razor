    private async Task SubmitCreateUser()
    {
        modalErrorMessage = null;
        if (string.IsNullOrWhiteSpace(newUser.Username))
        {
            modalErrorMessage = "กรุณากรอก Username";
            return;
        }

        if (newUser.AccountType == SftpAccountType.LocalWindows)
        {
            if (string.IsNullOrWhiteSpace(newUser.Password))
            {
                modalErrorMessage = "กรุณาระบุรหัสผ่านสำหรับ Local Windows Account";
                return;
            }
            if (newUser.Password != confirmPassword)
            {
                modalErrorMessage = "รหัสผ่านและการยืนยันรหัสผ่านไม่ตรงกัน";
                return;
            }
        }

        if (!useCustomRootCreate)
        {
            newUser.CustomRootPath = null;
        }

        isSubmitting = true;
        var op = string.IsNullOrEmpty(SessionState.CurrentUsername) ? "admin" : SessionState.CurrentUsername;
        var result = await UserService.CreateUserAsync(newUser, op);
        isSubmitting = false;

        if (result.Success)
        {
            SetAlert(result.Message, true);
            isCreateModalOpen = false;
            await LoadData();
        }
        else
        {
            modalErrorMessage = result.Message;
        }
    }

    private async Task SubmitEditUser()
    {
        if (editUserRequest == null) return;
        modalErrorMessage = null;

        if (!useCustomRootEdit)
        {
            editUserRequest.CustomRootPath = null;
        }

        isSubmitting = true;
        var op = string.IsNullOrEmpty(SessionState.CurrentUsername) ? "admin" : SessionState.CurrentUsername;
        var result = await UserService.UpdateUserAsync(editUserRequest, op);
        isSubmitting = false;

        if (result.Success)
        {
            SetAlert(result.Message, true);
            isEditModalOpen = false;
            await LoadData();
        }
        else
        {
            modalErrorMessage = result.Message;
        }
    }

