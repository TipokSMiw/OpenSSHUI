                </div>
                <div class="modal-body p-4">
                    <div class="alert alert-info py-2 small mb-3 d-flex align-items-center gap-2">
                        <i class="bi bi-info-circle-fill flex-shrink-0"></i>
                        <div>@L.Get("Users.KeysInfoBanner", selectedUser.Username)</div>
                    </div>

                    <!-- Navigation Tabs -->
                    <ul class="nav nav-tabs mb-3">
                        <li class="nav-item">
                            <button class="nav-link @(activeKeyTab == "list" ? "active fw-bold" : "text-muted")" @onclick='() => SwitchKeyTab("list")'>
                                <i class="bi bi-list-ul"></i>
                                <span>@L["Users.KeysTabList"]</span>
                                <span class="badge bg-secondary ms-1">@selectedUser.PublicKeys.Count</span>
                            </button>
                        </li>
                        @if (SessionState.CanManageSftp)
                        {
                            <li class="nav-item">
                                <button class="nav-link @(activeKeyTab == "generate" ? "active fw-bold text-primary" : "text-muted")" @onclick='() => SwitchKeyTab("generate")'>
                                    <i class="bi bi-lightning-charge-fill text-warning"></i>
                                    <span>@L["Users.KeysTabGen"]</span>
                                    <span class="badge bg-primary ms-1">NEW</span>
                                </button>
                            </li>
                            <li class="nav-item">
                                <button class="nav-link @(activeKeyTab == "paste" ? "active fw-bold" : "text-muted")" @onclick='() => SwitchKeyTab("paste")'>
                                    <i class="bi bi-clipboard-plus"></i>
                                    <span>@L["Users.KeysTabPaste"]</span>
                                </button>
                            </li>
                        }
                    </ul>

                    @if (activeKeyTab == "list")
                    {
                        <!-- Current Keys List -->
                        <h6 class="fw-bold mb-2">@L.Get("Users.ActiveKeysHeading", selectedUser.PublicKeys.Count)</h6>
                        @if (!selectedUser.PublicKeys.Any())
                        {
                            <div class="text-center text-muted py-4 bg-light rounded mb-3">
                                <i class="bi bi-key fs-3 d-block text-secondary mb-1"></i>
                                <small>@L["Users.NoKeysYet"]</small>
                                @if (SessionState.CanManageSftp)
                                {
                                    <div class="mt-2">
                                        <button class="btn btn-sm btn-outline-primary" @onclick='() => SwitchKeyTab("generate")'>
                                            <i class="bi bi-lightning-charge-fill text-warning"></i>
                                            <span>@L["Users.KeysTabGen"]</span>
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="list-group mb-3">
                                @foreach (var key in selectedUser.PublicKeys)
                                {
                                    bool isAuto = !string.IsNullOrWhiteSpace(key.Comment) && key.Comment.Contains("automation", StringComparison.OrdinalIgnoreCase);
                                    <div class="list-group-item d-flex justify-content-between align-items-center py-2.5">
                                        <div class="space-y-1">
                                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                                <span class="badge bg-secondary font-monospace">@key.KeyType</span>
                                                @if (isAuto)
                                                {
                                                    <span class="badge bg-warning text-dark d-flex align-items-center gap-1">
                                                        <i class="bi bi-robot"></i>
                                                        <span>Automation</span>
                                                    </span>
                                                }
                                                <span class="fw-bold font-monospace small">@key.FingerprintSha256</span>
                                            </div>
                                            <div class="text-muted small">
                                                <span>Comment: <strong>@(key.Comment ?? "-")</strong></span>
                                                <span class="mx-1">•</span>
                                                <span>@L.Get("Users.AddedAt", key.AddedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))</span>
                                            </div>
                                        </div>
                                        <div class="d-flex align-items-center gap-1">
                                            <button class="btn btn-outline-secondary btn-sm" title="@L["Users.SnippetTooltip"]" @onclick="() => OpenQuickSnippet(key)">
                                                <i class="bi bi-code-slash"></i>
                                                <span>@L["Users.SnippetBtn"]</span>
                                            </button>
                                            @if (SessionState.CanManageSftp)
                                            {
                                                <button class="btn btn-outline-danger btn-sm" title="@L["Users.RevokeTooltip"]" @onclick="() => DeletePublicKey(key.Id)">
                                                    <i class="bi bi-trash3"></i>
                                                    <span>@L["Common.Delete"]</span>
                                                </button>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    }
                    else if (activeKeyTab == "generate")
                    {
                        @if (generatedResult == null)
                        {
                            <!-- Generate Key Form -->
                            <div class="card border rounded-3 p-3 bg-light">
                                <h6 class="fw-bold mb-1 d-flex align-items-center gap-2">
                                    <i class="bi bi-lightning-charge-fill text-warning"></i>
                                    <span>@L["Users.GenTitle"]</span>
                                </h6>
                                <p class="text-muted small mb-3">
                                    @L["Users.GenDesc"]
                                </p>

                                @if (!string.IsNullOrWhiteSpace(genErrorMessage))
                                {
                                    <div class="alert alert-danger py-2 small mb-3 d-flex align-items-center gap-2">
                                        <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                                        <div>@genErrorMessage</div>
                                    </div>
                                }

                                <div class="mb-3">
                                    <label class="form-label-std mb-1.5">@L["Users.SelectAlgo"]</label>
                                    <div class="row g-3">
                                        <div class="col-sm-6">
                                            <div class="selection-card @(genKeyType == "ed25519" ? "active" : "")"
                                                 @onclick='() => genKeyType = "ed25519"'>
                                                <div>
                                                    <div class="d-flex align-items-center gap-2 mb-1">
                                                        <i class="bi @(genKeyType == "ed25519" ? "bi-check-circle-fill text-primary" : "bi-circle text-muted") fs-6"></i>
                                                        <span class="fw-bold small">Ed25519</span>
                                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace" style="font-size: 10px;">@L["Users.Recommended"]</span>
                                                    </div>
                                                    <div class="form-hint" style="padding-left: 1.6rem;">
                                                        @L["Users.Ed25519Desc"]
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-sm-6">
                                            <div class="selection-card @(genKeyType == "rsa" ? "active" : "")"
                                                 @onclick='() => genKeyType = "rsa"'>
                                                <div>
                                                    <div class="d-flex align-items-center gap-2 mb-1">
                                                        <i class="bi @(genKeyType == "rsa" ? "bi-check-circle-fill text-primary" : "bi-circle text-muted") fs-6"></i>
                                                        <span class="fw-bold small">RSA 4096-bit</span>
                                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle font-monospace" style="font-size: 10px;">Compatibility</span>
                                                    </div>
                                                    <div class="form-hint" style="padding-left: 1.6rem;">
                                                        @L["Users.RsaDesc"]
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label small fw-bold mb-1">
                                        @L["Users.GenCommentLabel"]
                                        <span class="text-danger">*</span>
                                    </label>
                                    <input type="text" class="form-control form-control-sm font-monospace" placeholder="@L["Users.GenCommentPlaceholder"]" @bind="genComment" @bind:event="oninput" />
                                    <div class="form-text small" style="font-size: 11px;">
                                        @L["Users.GenCommentHelp"]
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <label class="form-label small fw-bold mb-0">@L["Users.GenPassphraseLabel"]</label>
                                        <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle" style="font-size: 10px;">@L["Users.OptionalBlank"]</span>
                                    </div>
                                    <input type="password" class="form-control form-control-sm" placeholder="@L["Users.GenPassphrasePlaceholder"]" @bind="genPassphrase" />
                                </div>

                                <div class="alert alert-warning py-2 small mb-3 d-flex align-items-start gap-2">
                                    <i class="bi bi-shield-lock-fill text-warning flex-shrink-0 mt-0.5"></i>
                                    <div>
                                        <strong>@L["Users.ZeroKnowledgeTitle"]</strong> @L["Users.ZeroKnowledgeDesc"]
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="small d-inline-flex align-items-center gap-1 @(string.IsNullOrWhiteSpace(genComment) ? "text-warning-emphasis" : "text-success fw-semibold")">
                                        <i class="bi @(string.IsNullOrWhiteSpace(genComment) ? "bi-info-circle-fill" : "bi-check-circle-fill")"></i>
                                        <span>@(string.IsNullOrWhiteSpace(genComment) ? L["Users.GenMissingComment"] : L["Users.GenReady"])</span>
                                    </span>
                                    <button type="button" class="btn btn-primary btn-sm d-flex align-items-center gap-1.5" @onclick="HandleGenerateKey" disabled="@(isGeneratingKey || string.IsNullOrWhiteSpace(genComment))">
                                        @if (isGeneratingKey)
                                        {
                                            <span class="spinner-border spinner-border-sm"></span>
                                            <span>@L["Users.GeneratingKey"]</span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-lightning-charge-fill"></i>
                                            <span>@L["Users.GenerateKeyBtn"]</span>
                                        }
                                    </button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <!-- One-Time Private Key Delivery View -->
                            <div class="space-y-3">
                                <div class="alert alert-danger py-2.5 small mb-3 border-danger d-flex align-items-start gap-2.5">
                                    <i class="bi bi-exclamation-octagon-fill fs-5 text-danger flex-shrink-0"></i>
                                    <div>
                                        <div class="fw-bold uppercase">@L["Users.OneTimeWarningTitle"]</div>
                                        <div>@L["Users.OneTimeWarningDesc"]</div>
                                    </div>
                                </div>

                                <!-- Action Toolbar -->
                                <div class="card p-2.5 bg-light border mb-3">
                                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                                        <div class="small">
                                            <span class="text-muted">@L["Users.FileNameLabel"] </span>
                                            <code class="fw-bold">@GetPemFileName()</code>
                                        </div>
                                        <div class="d-flex gap-2">
                                            <button class="btn btn-success btn-sm d-flex align-items-center gap-1" @onclick="DownloadPrivateKeyPem">
                                                <i class="bi bi-download"></i>
                                                <span>@L["Users.DownloadPemBtn"]</span>
                                            </button>
                                            <button class="btn btn-outline-primary btn-sm d-flex align-items-center gap-1" @onclick="CopyPrivateKeyToClipboard">
                                                <i class="bi bi-clipboard-check"></i>
                                                <span>@copyKeyBtnText</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <!-- Private Key Readonly Textarea -->
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <label class="form-label small fw-bold mb-0">@L["Users.PrivateKeyContentLabel"]</label>
                                        <span class="text-muted small" style="font-size: 11px;">@generatedResult.KeyType (@generatedResult.FingerprintSha256)</span>
                                    </div>
                                    <textarea class="form-control form-control-sm font-monospace bg-dark text-white" rows="6" readonly>@generatedResult.PrivateKeyPem</textarea>
                                </div>

                                <!-- Code Snippets Section -->
                                <div class="card border rounded-3 mb-3 overflow-hidden">
                                    <div class="card-header bg-light py-1.5 px-3 d-flex justify-content-between align-items-center">
                                        <span class="small fw-bold d-flex align-items-center gap-1">
                                            <i class="bi bi-code-slash text-primary"></i>
                                            <span>@L["Users.SnippetAccordionTitle"]</span>
                                        </span>
                                        <ul class="nav nav-pills" style="font-size: 11px;">
                                            <li class="nav-item">
                                                <button class="nav-link py-0.5 px-2 @(activeSnippetTab == "cli" ? "active" : "")" @onclick='() => activeSnippetTab = "cli"'>OpenSSH CLI</button>
                                            </li>
                                            <li class="nav-item">
                                                <button class="nav-link py-0.5 px-2 @(activeSnippetTab == "ps" ? "active" : "")" @onclick='() => activeSnippetTab = "ps"'>PowerShell</button>
                                            </li>
                                        </ul>
                                    </div>
                                    <div class="card-body p-2 bg-dark text-white font-monospace small" style="font-size: 11px;">
                                        @if (activeSnippetTab == "cli")
                                        {
                                            <pre class="mb-0 text-white"># 1. Test SFTP connection
sftp -i ./@GetPemFileName() -P 22 @selectedUser.Username@@localhost

# 2. Sample automated upload (Batch Mode)
echo "put sales_data_*.csv /files/" | sftp -b - -i ./@GetPemFileName() @selectedUser.Username@@localhost</pre>
                                        }
                                        else
                                        {
                                            <pre class="mb-0 text-white"># PowerShell Automation Script (Windows Task Scheduler)
$KeyPath = "$PSScriptRoot\@GetPemFileName()"

# Restrict NTFS permissions to current user only (OpenSSH requirement)
icacls.exe $KeyPath /inheritance:r /grant:r "$($env:USERNAME):(R)"

# Run SFTP Batch upload to Chroot Directory
$Batch = "put C:\Data\export_*.csv /files/`nbye"
$Batch | & sftp.exe -i $KeyPath -b - "@(selectedUser.Username)@@localhost"</pre>
                                        }
                                    </div>
                                </div>

                                <!-- Safety Gate Checkbox before Close -->
                                <div class="card p-3 border-secondary bg-light mb-2">
                                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
                                        <div class="form-check mb-0">
                                            <input class="form-check-input" type="checkbox" id="chkConfirmed" @bind="hasConfirmedKeySaved" />
                                            <label class="form-check-label small fw-bold" for="chkConfirmed">
                                                @L["Users.OneTimeAck"]
                                            </label>
                                        </div>
                                        <button class="btn btn-primary btn-sm d-flex align-items-center gap-1" disabled="@(!hasConfirmedKeySaved)" @onclick="CloseKeyGenerationResult">
                                            <i class="bi bi-check2-circle"></i>
                                            <span>@L["Users.FinishSavedBtn"]</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else if (activeKeyTab == "paste")
                    {
                        <!-- Add New Key Form (Existing Paste) -->
                        <div class="card border rounded-3 p-3 bg-light">
                            <h6 class="fw-bold mb-2">@L["Users.PasteTitle"]</h6>
                            <div class="mb-2">
                                <label class="form-label small fw-bold mb-1">@L["Users.PasteLabel"]</label>
                                <textarea class="form-control form-control-sm font-monospace" rows="3" placeholder="ssh-rsa AAAAB3... / ---- BEGIN SSH2 PUBLIC KEY ----" @bind="newRawKey" @bind:event="oninput" @bind:after="PreviewParsedKey"></textarea>
                            </div>

                            @if (keyParsePreview != null)
                            {
                                @if (keyParsePreview.IsSuccess)
                                {
                                    <div class="alert alert-success py-2 small mb-2">
                                        <div><strong>Key Type:</strong> @keyParsePreview.KeyType</div>
                                        <div><strong>SHA-256 Fingerprint:</strong> <code>@keyParsePreview.FingerprintSha256</code></div>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label small fw-bold mb-1">@L["Users.PasteCommentLabel"]</label>
                                        <input type="text" class="form-control form-control-sm font-monospace" placeholder="@L["Users.PasteCommentPlaceholder"]" @bind="customPasteComment" />
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-danger py-2 small mb-2 d-flex align-items-center gap-2">
                                        <i class="bi bi-exclamation-circle-fill flex-shrink-0"></i>
                                        <div>@keyParsePreview.ErrorMessage</div>
                                    </div>
                                }
                            }

                            <div class="d-flex justify-content-end">
                                <button type="button" class="btn btn-primary btn-sm" @onclick="SubmitAddKey" disabled="@(keyParsePreview?.IsSuccess != true || isAddingKey)">
                                    @if (isAddingKey)
                                    {
                                        <span class="spinner-border spinner-border-sm"></span>
                                        <span>@L["Common.Saving"]</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-plus-lg"></i>
                                        <span>@L["Users.AddPublicKeyBtn"]</span>
                                    }
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal: Quick Snippet View -->
