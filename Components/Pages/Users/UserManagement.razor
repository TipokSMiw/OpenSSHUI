                                    <div class="input-group input-group-sm">
                                        <input type="text" class="form-control font-monospace" placeholder="@L["Users.CustomRootPlaceholder"]" @bind="editUserRequest.CustomRootPath" @bind:event="oninput" />
                                        <button class="btn btn-outline-secondary" type="button" @onclick="OpenFolderBrowserForEdit">
