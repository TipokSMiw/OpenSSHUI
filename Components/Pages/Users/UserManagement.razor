    private string GetCreateEffectivePathPreview()
    {
        if (useCustomRootCreate && !string.IsNullOrWhiteSpace(newUser.CustomRootPath))
        {
            return newUser.CustomRootPath.Trim();
        }
        var u = string.IsNullOrWhiteSpace(newUser.Username) ? "{username}" : newUser.Username.Trim();
        return $"{SshManager.SftpRoot}\\{u}";
    }

    private string GetEditEffectivePathPreview()
    {
        if (editUserRequest == null) return "-";
        if (useCustomRootEdit && !string.IsNullOrWhiteSpace(editUserRequest.CustomRootPath))
        {
            return editUserRequest.CustomRootPath.Trim();
        }
        return $"{SshManager.SftpRoot}\\{editUserRequest.Username}";
    }

