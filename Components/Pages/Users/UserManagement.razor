<!-- Modal: Reset Password -->
@if (isResetPasswordModalOpen && selectedUser != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title d-flex align-items-center gap-2">
                        <i class="bi bi-shield-lock-fill text-primary"></i>
                        <span>เปลี่ยนรหัสผ่าน Windows: @selectedUser.Username</span>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => isResetPasswordModalOpen = false"></button>
                </div>
                <div class="modal-body p-4">
                    @if (!string.IsNullOrEmpty(resetPasswordError))
                    {
                        <div class="alert alert-danger py-2 small d-flex align-items-center gap-2 mb-3">
                            <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                            <div>@resetPasswordError</div>
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label fw-bold small mb-1">รหัสผ่านใหม่ (New Password) <span class="text-danger">*</span></label>
                        <div class="input-group input-group-sm">
                            <input type="@(showResetPassword ? "text" : "password")" class="form-control" @bind="newResetPassword" @bind:event="oninput" placeholder="ระบุรหัสผ่านใหม่ของ Windows User" autofocus />
                            <button class="btn btn-outline-secondary" type="button" title="@(showResetPassword ? "ซ่อนรหัสผ่าน" : "แสดงรหัสผ่าน")" @onclick="() => showResetPassword = !showResetPassword">
                                <i class="bi @(showResetPassword ? "bi-eye-slash" : "bi-eye")"></i>
                            </button>
                        </div>
                    </div>

                    <div class="mb-1">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label fw-bold small mb-0">ยืนยันรหัสผ่านใหม่ (Confirm Password) <span class="text-danger">*</span></label>
                            @if (!string.IsNullOrEmpty(newResetPassword) || !string.IsNullOrEmpty(confirmResetPassword))
                            {
                                @if (IsResetPasswordValid)
                                {
                                    <span class="text-success small fw-bold d-inline-flex align-items-center gap-1" style="font-size: 0.75rem;">
                                        <i class="bi bi-check-circle-fill"></i>
                                        <span>รหัสผ่านตรงกัน</span>
                                    </span>
                                }
                                else
                                {
                                    <span class="text-danger small fw-bold d-inline-flex align-items-center gap-1" style="font-size: 0.75rem;">
                                        <i class="bi bi-x-circle-fill"></i>
                                        <span>รหัสผ่านไม่ตรงกัน</span>
                                    </span>
                                }
                            }
                        </div>
                        <input type="@(showResetPassword ? "text" : "password")" class="form-control form-control-sm" @bind="confirmResetPassword" @bind:event="oninput" placeholder="พิมพ์รหัสผ่านใหม่อีกครั้ง" />
                    </div>
                </div>
                <div class="modal-footer bg-light d-flex justify-content-between align-items-center">
                    <span class="small text-muted">มีผลกับบัญชี Windows ทันที</span>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => isResetPasswordModalOpen = false">ยกเลิก</button>
                        <button type="button" class="btn btn-primary btn-sm px-3" @onclick="SubmitResetPassword" disabled="@(!IsResetPasswordValid)">
                            <i class="bi bi-check-lg"></i>
                            <span>@(IsResetPasswordValid ? "บันทึกรหัสผ่านใหม่" : "กรอกรหัสผ่านให้ตรงกัน")</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal: Delete User -->
