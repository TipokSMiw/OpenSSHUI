                                <div class="fw-bold small text-dark d-flex align-items-center gap-1.5">
                                    <i class="bi @(useCustomRootEdit ? "bi-check-circle-fill text-primary" : "bi-folder-symlink text-primary")"></i>
                                    <span>@L["Users.CustomRootTitle"]</span>
                                    @if (useCustomRootEdit)
                                    {
                                        <span class="badge bg-primary text-white ms-1" style="font-size: 0.68rem;">@L["Users.EnabledBadge"]</span>
                                    }
                                </div>
                                <div class="text-muted mt-0.5" style="font-size: 0.76rem;">
                                    @L["Users.CustomRootDesc"] (<code>@($"{SshManager.SftpRoot}\\{editUserRequest.Username}")</code>)
