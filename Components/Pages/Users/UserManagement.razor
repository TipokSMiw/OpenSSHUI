    private void OpenEditUserModal(SftpUser user)
    {
        if (!SessionState.CanManageSftp) return;
        selectedUser = user;
        editUserRequest = new UpdateUserRequest
        {
            Username = user.Username,
            DisplayName = user.DisplayName,
            Notes = user.Notes,
            CustomRootPath = user.CustomRootPath,
            CustomPermissionType = user.CustomPermissionType,
            AccessMode = user.AccessMode,
            GroupIds = user.UserGroups.Select(ug => ug.GroupId).ToList()
        };
        useCustomRootEdit = !string.IsNullOrWhiteSpace(user.CustomRootPath);
        groupSearchTerm = "";
        isGroupDropdownOpen = true;
        modalErrorMessage = null;
        isEditModalOpen = true;
    }

    private IEnumerable<SftpGroup> FilteredGroupCandidates
    {
        get
        {
            if (availableGroups == null || availableGroups.Count == 0)
            {
                return Enumerable.Empty<SftpGroup>();
            }
            if (string.IsNullOrWhiteSpace(groupSearchTerm))
            {
                return availableGroups;
            }
            return availableGroups.Where(g =>
                g.Name.Contains(groupSearchTerm, StringComparison.OrdinalIgnoreCase) ||
                g.RootPath.Contains(groupSearchTerm, StringComparison.OrdinalIgnoreCase) ||
                (!string.IsNullOrWhiteSpace(g.Description) && g.Description.Contains(groupSearchTerm, StringComparison.OrdinalIgnoreCase)));
        }
    }

    private void ToggleGroupByClick(List<string> groupList, string groupId)
    {
        if (groupList.Contains(groupId))
        {
            groupList.Remove(groupId);
        }
        else
        {
            groupList.Add(groupId);
        }
    }

    private void SelectAllFilteredGroups(List<string> groupList)
    {
        foreach (var g in FilteredGroupCandidates)
        {
            if (!groupList.Contains(g.Id))
            {
                groupList.Add(g.Id);
            }
        }
    }

    private void ToggleGroupSelection(List<string> groupList, string groupId, object? isChecked)
    {
        if (isChecked is bool b && b)
        {
            if (!groupList.Contains(groupId)) groupList.Add(groupId);
        }
        else
        {
            groupList.Remove(groupId);
        }
    }

