                                        <option value="@SftpAccessMode.DirectChroot">@L["Users.ModeChrootOption"]</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold mb-1">@L["Groups.ColPermission"] (Permission)</label>
                                    <select class="form-select form-select-sm" @bind="editUserRequest.CustomPermissionType">
                                        <option value="@SftpPermissionType.ReadWrite">@L["Users.PermRwOption"]</option>
                                        <option value="@SftpPermissionType.ReadOnly">@L["Users.PermRoOption"]</option>
