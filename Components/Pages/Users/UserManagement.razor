                        <span>@(deleteUserFiles ? "ยืนยันลบบัญชีและทำลายไฟล์ถาวร" : "ลบเฉพาะบัญชีผู้ใช้ (เก็บไฟล์ไว้)")</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
}

