    private void PreviewParsedKey()
    {
        if (string.IsNullOrWhiteSpace(newRawKey))
        {
            keyParsePreview = null;
            customPasteComment = "";
            return;
        }
        keyParsePreview = SshKeyConverter.ParseAndNormalizeKey(newRawKey);
        if (keyParsePreview.IsSuccess)
        {
            customPasteComment = keyParsePreview.Comment ?? "";
        }
    }

    private async Task SubmitAddKey()
    {
        if (selectedUser == null || keyParsePreview?.IsSuccess != true) return;

        isAddingKey = true;
        var op = string.IsNullOrEmpty(SessionState.CurrentUsername) ? "admin" : SessionState.CurrentUsername;
        var finalComment = string.IsNullOrWhiteSpace(customPasteComment) ? keyParsePreview.Comment : customPasteComment.Trim();
        var result = await UserService.AddPublicKeyAsync(selectedUser.Username, keyParsePreview.RawPublicKey, finalComment, op);
        isAddingKey = false;

        if (result.Success)
        {
            newRawKey = "";
            customPasteComment = "";
            keyParsePreview = null;
            await LoadData();
            selectedUser = users?.FirstOrDefault(u => u.Username == selectedUser.Username);
            SetAlert("เพิ่ม SSH Key สำเร็จ", true);
        }
        else
        {
            SetAlert(result.Message, false);
        }
    }

    private async Task DeletePublicKey(int keyId)
    {
        if (selectedUser == null) return;
        var op = string.IsNullOrEmpty(SessionState.CurrentUsername) ? "admin" : SessionState.CurrentUsername;
        var result = await UserService.DeletePublicKeyAsync(keyId, op);
        if (result.Success)
        {
            await LoadData();
            selectedUser = users?.FirstOrDefault(u => u.Username == selectedUser.Username);
            SetAlert("ลบ SSH Key เรียบร้อย", true);
        }
        else
        {
            SetAlert(result.Message, false);
        }
    }

