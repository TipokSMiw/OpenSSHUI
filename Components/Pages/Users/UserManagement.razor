    private async Task HandleGenerateKey()
    {
        if (selectedUser == null) return;

        isGeneratingKey = true;
        genErrorMessage = null;

        var op = string.IsNullOrEmpty(SessionState.CurrentUsername) ? "admin" : SessionState.CurrentUsername;
        var request = new GenerateAutomationKeyRequest
        {
            Username = selectedUser.Username,
            KeyType = genKeyType,
            Comment = genComment,
            Passphrase = string.IsNullOrWhiteSpace(genPassphrase) ? null : genPassphrase
        };

        var (success, message, result) = await UserService.GenerateAutomationKeyAsync(request, op);
        isGeneratingKey = false;

        if (success && result != null)
        {
            generatedResult = result;
            hasConfirmedKeySaved = false;
            await LoadData();
            selectedUser = users?.FirstOrDefault(u => u.Username == selectedUser.Username);
        }
        else
        {
            genErrorMessage = message;
        }
    }

    private async Task DownloadPrivateKeyPem()
    {
        if (generatedResult == null || selectedUser == null) return;

        var comment = string.IsNullOrWhiteSpace(generatedResult.Comment) ? "automation" : generatedResult.Comment;
        var fileName = $"{selectedUser.Username}_{comment}_id_{genKeyType}.pem";
        foreach (var c in Path.GetInvalidFileNameChars())
        {
            fileName = fileName.Replace(c, '_');
        }

        var bytes = System.Text.Encoding.UTF8.GetBytes(generatedResult.PrivateKeyPem);
        using var stream = new MemoryStream(bytes);
        using var streamRef = new DotNetStreamReference(stream);
        await JSRuntime.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
    }

    private async Task CopyPrivateKeyToClipboard()
    {
        if (generatedResult == null) return;
        await JSRuntime.InvokeVoidAsync("copyTextToClipboard", generatedResult.PrivateKeyPem);
        copyKeyBtnText = "คัดลอกเรียบร้อยแล้ว!";
        StateHasChanged();
        await Task.Delay(2000);
        copyKeyBtnText = "คัดลอก Private Key";
        StateHasChanged();
    }

    private string GetPemFileName()
    {
        if (selectedUser == null) return "id_automation.pem";
        var comment = string.IsNullOrWhiteSpace(genComment) ? "automation" : genComment;
        return $"{selectedUser.Username}_{comment}_id_{genKeyType}.pem";
    }

