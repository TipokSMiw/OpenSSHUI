    // Storage cache (thread-safe ConcurrentDictionary to prevent race conditions during background calculation)
    private ConcurrentDictionary<string, long> userStorageMap = new(StringComparer.OrdinalIgnoreCase);
    private CancellationTokenSource? _storageCts;

    private bool HasActiveFilter =>
        !string.IsNullOrWhiteSpace(searchTerm) ||
        !string.IsNullOrWhiteSpace(accountTypeFilter) ||
        !string.IsNullOrWhiteSpace(statusFilter) ||
        !string.IsNullOrWhiteSpace(groupFilter);

