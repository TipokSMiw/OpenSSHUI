        }
        var op = string.IsNullOrEmpty(SessionState.CurrentUsername) ? "admin" : SessionState.CurrentUsername;
        var res = await UserService.ResetPasswordAsync(selectedUser.Username, newResetPassword, op);
        if (res.Success)
        {
            isResetPasswordModalOpen = false;
            SetAlert(res.Message, true);
        }
        else
        {
            resetPasswordError = res.Message;
        }
    }

