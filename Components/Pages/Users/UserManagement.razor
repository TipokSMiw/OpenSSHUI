@page "/users"
@rendermode InteractiveServer
@using System.Collections.Concurrent
@inject ISftpUserService UserService
@inject ISftpGroupService GroupService
@inject ILdapAuthService LdapAuth
@inject ISecureFileBrowserService FileBrowser
@inject IOpenSshServiceManager SshManager
@inject UserSessionState SessionState
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject ILocalizationService L
@implements IDisposable

<PageTitle>SFTP Users - OpensshUI</PageTitle>

<div class="container-fluid p-0">
    <!-- Standardized Page Header -->
    <div class="page-header">
        <div>
            <h3 class="page-title">
                <i class="bi bi-people-fill text-primary"></i>
                <span>@L["Users.Title"]</span>
            </h3>
            <p class="text-muted small mb-0">@L["Users.Subtitle"]</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-outline-secondary btn-sm" @onclick="LoadData">
                <i class="bi bi-arrow-clockwise"></i>
                <span>@L["Common.Refresh"]</span>
            </button>
            @if (SessionState.CanManageSftp)
            {
                <button class="btn btn-primary btn-sm" @onclick="OpenCreateUserModal">
                    <i class="bi bi-person-plus-fill"></i>
                    <span>@L["Users.AddBtn"]</span>
                </button>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(alertMessage))
    {
        <div class="alert @(isAlertSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show py-2 small d-flex align-items-center gap-2" role="alert">
            <i class="bi @(isAlertSuccess ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") flex-shrink-0"></i>
            <div>@alertMessage</div>
            <button type="button" class="btn-close" @onclick="() => alertMessage = null"></button>
        </div>
    }

    <!-- Search & Filter Bar -->
    <div class="card border-0 shadow-sm rounded-3 mb-3">
        <div class="card-body py-2.5 px-3">
            <div class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label small fw-bold mb-1">@L["Users.SearchLabel"]</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control border-start-0" placeholder="@L["Users.SearchPlaceholder"]" @bind="searchTerm" @bind:event="oninput" />
                    </div>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold mb-1">@L["Users.AccountTypeLabel"]</label>
                    <select class="form-select form-select-sm" @bind="accountTypeFilter">
                        <option value="">@L["Users.AllAccountTypes"]</option>
                        <option value="LocalWindows">Local Windows</option>
                        <option value="ActiveDirectory">Active Directory</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold mb-1">@L["Users.StatusLabel"]</label>
                    <select class="form-select form-select-sm" @bind="statusFilter">
                        <option value="">@L["Users.AllStatuses"]</option>
                        <option value="Active">@L["Users.StatusActiveOption"]</option>
                        <option value="Disabled">@L["Users.StatusDisabledOption"]</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold mb-1">@L["Users.GroupFilterLabel"]</label>
                    <select class="form-select form-select-sm" @bind="groupFilter">
                        <option value="">@L["Users.AllGroups"]</option>
                        @foreach (var g in availableGroups)
                        {
                            <option value="@g.Id">@g.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-2 d-flex justify-content-end align-items-center gap-2">
                    @if (HasActiveFilter)
                    {
                        <button class="btn btn-outline-secondary btn-sm py-0.5 px-2" title="@L["Groups.ClearAllFiltersTooltip"]" @onclick="ClearFilters">
                            <i class="bi bi-x-circle"></i>
                            <span>@L["Users.ClearBtn"]</span>
                        </button>
                    }
                    <span class="text-muted small text-nowrap">
                        @L.Get("Users.ShowingCount", users == null ? 0 : FilteredUsers.Count())
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Users Table -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
            @if (users == null)
            {
                <div class="text-center py-5">
                    <span class="spinner-border spinner-border-sm text-primary"></span>
                    <p class="text-muted small mt-2 mb-0">@L["Users.Loading"]</p>
                </div>
            }
            else if (!FilteredUsers.Any())
            {
                <div class="text-center text-muted py-5">
                    <i class="bi bi-person-x fs-1 d-block mb-2"></i>
                    <p class="mb-0">@L["Users.Empty"]</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small text-muted">
                            <tr>
                                <th class="ps-3">@L["Users.ColUser"]</th>
                                <th>@L["Users.ColGroups"]</th>
                                <th>EFFECTIVE ROOT PATH</th>
                                <th>SSH KEYS</th>
                                <th>@L["Users.ColStorage"]</th>
                                <th>@L["Common.Status"]</th>
                                <th>@L["Groups.ColCreated"]</th>
                                <th class="text-end pe-3">@L["Files.ColActions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in FilteredUsers)
                            {
                                <tr>
                                    <td class="ps-3">
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="bi @(user.AccountType == SftpAccountType.LocalWindows ? "bi-person-badge text-primary" : "bi-diagram-3 text-info") fs-5"></i>
                                            <div>
                                                <div class="fw-bold">@user.Username</div>
                                                <small class="text-muted">
                                                    @(string.IsNullOrEmpty(user.DisplayName) ? "-" : user.DisplayName)
                                                    <span class="text-secondary">(@(user.AccountType == SftpAccountType.LocalWindows ? "Local" : "AD"))</span>
                                                </small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @if (user.UserGroups.Count == 0)
                                        {
                                            <span class="text-muted small">-</span>
                                        }
                                        else
                                        {
                                            <div class="d-flex flex-wrap gap-1">
                                                @foreach (var ug in user.UserGroups)
                                                {
                                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle small">
                                                        <i class="bi bi-collection"></i>
                                                        <span>@(ug.Group?.Name ?? ug.GroupId)</span>
                                                    </span>
                                                }
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(user.CustomRootPath))
                                        {
                                            <div class="path-badge path-badge-custom" title="@L.Get("Users.CustomRootTooltip", user.CustomRootPath)">
                                                <i class="bi bi-folder-symlink-fill"></i>
                                                <span class="path-text">@user.CustomRootPath</span>
                                                <span class="badge bg-primary text-white ms-1 px-1.5 py-0.5" style="font-size: 0.65rem;">CUSTOM</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="path-badge path-badge-default" title="@L.Get("Users.DefaultRootTooltip", user.HomeDirectory)">
                                                <i class="bi bi-folder2-open"></i>
                                                <span class="path-text">@user.HomeDirectory</span>
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary py-0.5 px-2.5 rounded-pill" title="@L["Users.KeysTooltip"]" @onclick="() => OpenKeyManagerModal(user)">
                                            <i class="bi bi-key-fill"></i>
                                            <span>@user.PublicKeys.Count</span>
                                        </button>
                                    </td>
                                    <td class="small text-muted font-monospace">
                                        @if (userStorageMap.TryGetValue(user.Username, out var bytes))
                                        {
                                            @FormatBytes(bytes)
                                        }
                                        else
                                        {
                                            <span class="text-muted" title="@L["Users.CalculatingStorage"]">...</span>
                                        }
                                    </td>
                                    <td>
                                        @if (user.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                <i class="bi bi-check-circle-fill"></i>
                                                <span>Active</span>
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                                <i class="bi bi-pause-circle-fill"></i>
                                                <span>Disabled</span>
                                            </span>
                                        }
                                    </td>
                                    <td class="small text-muted text-nowrap font-monospace">@user.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                    <td class="text-end pe-3">
                                        <div class="action-bar">
                                            @if (SessionState.CanManageSftp)
                                            {
                                                <button class="btn btn-sm btn-outline-secondary" title="@L["Users.EditUserTooltip"]" @onclick="() => OpenEditUserModal(user)">
                                                    <i class="bi bi-pencil-square"></i>
                                                    <span>@L["Common.Edit"]</span>
                                                </button>
                                            }
                                            <button class="btn btn-sm btn-outline-primary" title="@L["Users.BrowseFilesTooltip"]" @onclick='() => Navigation.NavigateTo($"files/{user.Username}")'>
                                                <i class="bi bi-folder2-open"></i>
                                                <span>@L["Groups.FilesBtn"]</span>
                                            </button>
                                            @if (SessionState.CanManageSftp)
                                            {
                                                @if (user.AccountType == SftpAccountType.LocalWindows)
                                                {
                                                    <button class="btn btn-sm btn-outline-secondary" title="@L["Users.ResetPwdTooltip"]" @onclick="() => OpenResetPasswordModal(user)">
                                                        <i class="bi bi-shield-lock"></i>
                                                    </button>
                                                }
                                                <button class="btn btn-sm @(user.IsActive ? "btn-outline-warning" : "btn-outline-success")"
                                                        title="@(user.IsActive ? L["Users.SuspendTooltip"] : L["Users.ActivateTooltip"])"
                                                        @onclick="() => ToggleUserStatus(user)">
                                                    <i class="bi @(user.IsActive ? "bi-pause-fill" : "bi-play-fill")"></i>
                                                </button>
                                                <span class="action-divider"></span>
                                                <button class="btn btn-sm btn-outline-danger" title="@L["Users.DeleteUserTooltip"]" @onclick="() => OpenDeleteUserModal(user)">
                                                    <i class="bi bi-trash3"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal: Create SFTP User -->
@if (isCreateModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title d-flex align-items-center gap-2">
                        <i class="bi bi-person-plus-fill text-primary"></i>
                        <span>@L["Users.CreateModalTitle"]</span>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => isCreateModalOpen = false"></button>
                </div>
                <div class="modal-body p-4">
                    @if (!string.IsNullOrEmpty(modalErrorMessage))
                    {
                        <div class="alert alert-danger py-2 small d-flex align-items-center gap-2 mb-3">
                            <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                            <div>@modalErrorMessage</div>
                        </div>
                    }

                    <!-- Step 1: Account Type & Identity -->
                    <div class="form-step-header">
                        <div class="form-step-title">
                            <span class="form-step-badge">1</span>
                            <span>@L["Users.CreateStep1Title"]</span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <div class="selection-card @(newUser.AccountType == SftpAccountType.LocalWindows ? "active" : "")"
                                 @onclick="OnSelectLocalAccountType">
                                <div>
                                    <div class="fw-bold small d-flex align-items-center gap-2">
                                        <i class="bi @(newUser.AccountType == SftpAccountType.LocalWindows ? "bi-check-circle-fill text-primary" : "bi-circle text-muted") fs-6"></i>
                                        <i class="bi bi-person-badge text-primary"></i>
                                        <span>Local Windows User</span>
                                    </div>
                                    <div class="form-hint mt-1" style="padding-left: 1.6rem;">
                                        @L["Users.LocalUserDesc"]
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="selection-card @(newUser.AccountType == SftpAccountType.ActiveDirectory ? "active" : "")"
                                 @onclick="OnSelectAdAccountType">
                                <div>
                                    <div class="fw-bold small d-flex align-items-center gap-2">
                                        <i class="bi @(newUser.AccountType == SftpAccountType.ActiveDirectory ? "bi-check-circle-fill text-primary" : "bi-circle text-muted") fs-6"></i>
                                        <i class="bi bi-diagram-3 text-info"></i>
                                        <span>Active Directory (LDAP)</span>
                                    </div>
                                    <div class="form-hint mt-1" style="padding-left: 1.6rem;">
                                        @L["Users.AdUserDesc"]
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (newUser.AccountType == SftpAccountType.ActiveDirectory)
                    {
                        @if (!isLdapEnabledInConfig)
                        {
                            <div class="alert alert-warning py-2 px-3 small d-flex align-items-center gap-2 mb-3" role="alert">
                                <i class="bi bi-exclamation-triangle-fill text-warning flex-shrink-0"></i>
                                <div>
                                    <strong>@L["Users.LdapDisabledTitle"]</strong>
                                    @L["Users.LdapDisabledDesc"]
                                    <a href="/settings" class="alert-link">@L["Users.LdapDisabledLink"]</a> @L["Users.LdapDisabledSuffix"]
                                </div>
                            </div>
                        }

                        <div class="p-3 mb-3 bg-light rounded border">
                            <label class="form-label fw-bold small d-flex align-items-center gap-1.5 mb-2">
                                <i class="bi bi-diagram-3-fill text-primary"></i>
                                <span>@L["Users.AdSearchTitle"]</span>
                            </label>

                            <div class="input-group input-group-sm mb-2">
                                <input type="text" class="form-control" placeholder="@L["Users.AdSearchPlaceholder"]"
                                       @bind="adSearchQuery" @bind:event="oninput" @onkeydown="HandleAdSearchKeyDown" disabled="@isSearchingAd" />
                                <button class="btn btn-primary" type="button" @onclick="SearchActiveDirectory" disabled="@isSearchingAd">
                                    @if (isSearchingAd)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                        <span>@L["Users.Searching"]</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-search me-1"></i>
                                        <span>@L["WebAdmins.AdSearchBtn"]</span>
                                    }
                                </button>
                            </div>

                            @if (!string.IsNullOrEmpty(adSearchError))
                            {
                                <div class="alert alert-danger py-1.5 px-2.5 small mb-2 d-flex align-items-center gap-2">
                                    <i class="bi bi-exclamation-circle-fill flex-shrink-0"></i>
                                    <div>@adSearchError</div>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(adSearchInfo))
                            {
                                <div class="text-muted small py-1.5 px-2 bg-white rounded border d-flex align-items-center gap-2">
                                    <i class="bi bi-info-circle text-primary"></i>
                                    <span>@adSearchInfo</span>
                                </div>
                            }

                            @if (adSearchResults.Any())
                            {
                                <div class="list-group list-group-flush border rounded bg-white shadow-sm mt-2" style="max-height: 180px; overflow-y: auto;">
                                    @foreach (var adUser in adSearchResults)
                                    {
                                        bool isAlreadyAdded = users != null && users.Any(u => string.Equals(u.Username, adUser.SamAccountName, StringComparison.OrdinalIgnoreCase));
                                        <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-2 px-3 @(isAlreadyAdded ? "bg-light opacity-75" : "")">
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="bi bi-person-badge text-primary fs-5"></i>
                                                <div>
                                                    <strong class="font-monospace">@adUser.SamAccountName</strong>
                                                    <span class="text-muted small ms-2">(@adUser.DisplayName)</span>
                                                    @if (!string.IsNullOrWhiteSpace(adUser.Email))
                                                    {
                                                        <div class="small text-muted font-monospace"><i class="bi bi-envelope"></i> @adUser.Email</div>
                                                    }
                                                </div>
                                            </div>
                                            <div>
                                                @if (isAlreadyAdded)
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle small">
                                                        <i class="bi bi-check2"></i> @L["Users.AlreadyAdded"]
                                                    </span>
                                                }
                                                else
                                                {
                                                    <button type="button" class="btn btn-sm btn-primary py-0.5 px-2.5" @onclick="() => SelectAdUser(adUser)">
                                                        <i class="bi bi-check-lg"></i> @L["Users.SelectThisUser"]
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        @if (selectedAdUser != null)
                        {
                            <div class="card border border-primary-subtle bg-primary-subtle rounded-3 p-3 mb-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="d-flex align-items-center gap-2.5">
                                        <i class="bi bi-check-circle-fill text-success fs-4"></i>
                                        <div>
                                            <div class="fw-bold small text-primary">@L["Users.SelectedAdAccount"]</div>
                                            <div class="font-monospace fw-bold fs-6">
                                                @selectedAdUser.SamAccountName
                                                <span class="badge bg-primary ms-1 small">AD Account</span>
                                            </div>
                                            <div class="small text-muted">
                                                @selectedAdUser.DisplayName
                                                @if (!string.IsNullOrEmpty(selectedAdUser.Email))
                                                {
                                                    <span class="text-secondary font-monospace ms-1">(@selectedAdUser.Email)</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ClearSelectedAdUser">
                                        <i class="bi bi-x-circle"></i>
                                        <span>@L["Users.ChangeUserBtn"]</span>
                                    </button>
                                </div>
                            </div>
                        }
                    }

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label fw-bold small mb-0">
                                    Username <span class="text-danger">*</span>
                                </label>
                                <span class="text-muted" style="font-size: 0.72rem;">
                                    @(newUser.AccountType == SftpAccountType.ActiveDirectory ? L["Users.AdSamHint"] : "a-z, 0-9, _, -")
                                </span>
                            </div>
                            <input type="text" class="form-control form-control-sm font-monospace" @bind="newUser.Username" @bind:event="oninput" placeholder="@L["Users.UsernamePlaceholder"]" disabled="@(selectedAdUser != null)" />
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label fw-bold small mb-0">@L["Users.DisplayNameLabel"]</label>
                                <span class="text-muted" style="font-size: 0.72rem;">@L["Settings.Optional"]</span>
                            </div>
                            <input type="text" class="form-control form-control-sm" @bind="newUser.DisplayName" placeholder="@L["Users.DisplayNamePlaceholder"]" />
                        </div>
                    </div>

                    @if (newUser.AccountType == SftpAccountType.LocalWindows)
                    {
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold small mb-1">Password <span class="text-danger">*</span></label>
                                <div class="input-group input-group-sm">
                                    <input type="@(showCreatePassword ? "text" : "password")" class="form-control" @bind="newUser.Password" @bind:event="oninput" placeholder="@L["Users.LocalPwdPlaceholder"]" />
                                    <button class="btn btn-outline-secondary" type="button" title="@(showCreatePassword ? L["Common.HidePassword"] : L["Common.ShowPassword"])" @onclick="() => showCreatePassword = !showCreatePassword">
                                        <i class="bi @(showCreatePassword ? "bi-eye-slash" : "bi-eye")"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <label class="form-label fw-bold small mb-0">Confirm Password <span class="text-danger">*</span></label>
                                    @if (!string.IsNullOrEmpty(newUser.Password) || !string.IsNullOrEmpty(confirmPassword))
                                    {
                                        @if (IsCreatePasswordMatch)
                                        {
                                            <span class="text-success small fw-bold d-inline-flex align-items-center gap-1" style="font-size: 0.75rem;">
                                                <i class="bi bi-check-circle-fill"></i>
                                                <span>@L["Settings.PwdMatch"]</span>
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-danger small fw-bold d-inline-flex align-items-center gap-1" style="font-size: 0.75rem;">
                                                <i class="bi bi-x-circle-fill"></i>
                                                <span>@L["Settings.PwdMismatch"]</span>
                                            </span>
                                        }
                                    }
                                </div>
                                <input type="@(showCreatePassword ? "text" : "password")" class="form-control form-control-sm" @bind="confirmPassword" @bind:event="oninput" placeholder="@L["Users.RetypePwdPlaceholder"]" />
                            </div>
                        </div>
                    }

                    <!-- Step 2: Group Assignment & Folder Access -->
                    <div class="form-step-header">
                        <div class="form-step-title">
                            <span class="form-step-badge">2</span>
                            <span>@L["Users.Step2Title"]</span>
                        </div>
                        <span class="badge bg-primary text-white" style="font-size: 0.72rem;">
                            <i class="bi bi-collection-fill"></i> @L.Get("Users.SelectedGroupsCount", newUser.GroupIds.Count)
                        </span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small mb-1.5">@L["Users.AssignGroupsLabel"]</label>

                        <!-- Blue Highlighted Selected Groups Box -->
                        <div class="selected-items-box mb-2.5">
                            <div class="d-flex justify-content-between align-items-center mb-1.5">
                                <span class="small fw-bold text-primary d-flex align-items-center gap-1.5">
                                    <i class="bi bi-check2-square"></i>
                                    <span>@L.Get("Users.SelectedGroupsBox", newUser.GroupIds.Count)</span>
                                </span>
                                @if (newUser.GroupIds.Count > 0)
                                {
                                    <button type="button" class="btn btn-link btn-sm text-danger text-decoration-none p-0 small"
                                            @onclick="() => newUser.GroupIds.Clear()">
                                        <i class="bi bi-x-circle"></i> @L["Groups.ClearAll"]
                                    </button>
                                }
                            </div>
                            @if (newUser.GroupIds.Count == 0)
                            {
                                <div class="text-muted small py-1">
                                    @L["Users.NoGroupsSelected"]
                                </div>
                            }
                            else
                            {
                                <div class="d-flex flex-wrap gap-1.5">
                                    @foreach (var gid in newUser.GroupIds.ToList())
                                    {
                                        var grpObj = availableGroups.FirstOrDefault(g => g.Id == gid);
                                        if (grpObj != null)
                                        {
                                            <span class="selected-item-pill">
                                                <i class="bi bi-folder-symlink text-primary"></i>
                                                <span>@grpObj.Name</span>
                                                <span class="text-muted font-monospace" style="font-size: 0.7rem;">(@grpObj.RootPath)</span>
                                                <button type="button" class="selected-item-remove" title="@L["Users.RemoveGroupTooltip"]"
                                                        @onclick="() => newUser.GroupIds.Remove(gid)">
                                                    <i class="bi bi-x"></i>
                                                </button>
                                            </span>
                                        }
                                    }
                                </div>
                            }
                        </div>

                        <!-- Searchable Vertical Dropdown List (1-Column) -->
                        <div class="searchable-dropdown-panel">
                            <div class="p-2 bg-light border-bottom d-flex flex-wrap align-items-center gap-2">
                                <div class="input-group input-group-sm flex-grow-1">
                                    <span class="input-group-text bg-white text-muted"><i class="bi bi-search"></i></span>
                                    <input type="text" class="form-control" placeholder="@L["Users.GroupSearchPlaceholder"]"
                                           @bind="groupSearchTerm" @bind:event="oninput"
                                           @onfocus="() => isGroupDropdownOpen = true" />
                                    @if (!string.IsNullOrEmpty(groupSearchTerm))
                                    {
                                        <button class="btn btn-outline-secondary" type="button" @onclick='() => groupSearchTerm = ""'>
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    }
                                </div>
                                <div class="d-flex align-items-center gap-1.5">
                                    @if (FilteredGroupCandidates.Any())
                                    {
                                        <button type="button" class="btn btn-outline-primary btn-sm py-0.5 px-2"
                                                @onclick="() => SelectAllFilteredGroups(newUser.GroupIds)">
                                            <i class="bi bi-check-all"></i> @L["Users.SelectAllFilteredGroups"]
                                        </button>
                                    }
                                    <button type="button" class="btn btn-outline-secondary btn-sm py-0.5 px-2"
                                            @onclick="() => isGroupDropdownOpen = !isGroupDropdownOpen">
                                        <i class="bi @(isGroupDropdownOpen ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                        <span>@(isGroupDropdownOpen ? L["Groups.CollapseList"] : L.Get("Users.ExpandGroupsCount", FilteredGroupCandidates.Count()))</span>
                                    </button>
                                </div>
                            </div>

                            @if (isGroupDropdownOpen)
                            {
                                <div class="searchable-dropdown-list">
                                    @if (availableGroups.Count == 0)
                                    {
                                        <div class="text-muted small text-center py-3">@L["Users.NoGroupsInSystem"]</div>
                                    }
                                    else if (!FilteredGroupCandidates.Any())
                                    {
                                        <div class="text-muted small text-center py-3">@L.Get("Users.NoGroupMatches", groupSearchTerm)</div>
                                    }
                                    else
                                    {
                                        @foreach (var g in FilteredGroupCandidates)
                                        {
                                            bool isSelected = newUser.GroupIds.Contains(g.Id);
                                            <button type="button"
                                                    class="searchable-dropdown-item @(isSelected ? "selected" : "")"
                                                    @onclick="() => ToggleGroupByClick(newUser.GroupIds, g.Id)">
                                                <div class="d-flex align-items-center gap-2.5">
                                                    <i class="bi @(isSelected ? "bi-check-square-fill text-primary" : "bi-square text-muted") fs-6"></i>
                                                    <div class="text-start">
                                                        <span class="fw-bold small @(isSelected ? "text-primary" : "text-dark")">@g.Name</span>
                                                        <span class="text-muted font-monospace small ms-1.5">(@g.RootPath)</span>
                                                    </div>
                                                </div>
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="badge @(g.PermissionType == SftpPermissionType.ReadWrite ? "bg-success-subtle text-success border border-success-subtle" : "bg-secondary-subtle text-secondary border border-secondary-subtle")" style="font-size: 0.68rem;">
                                                        @(g.PermissionType == SftpPermissionType.ReadWrite ? "Read/Write" : "Read-Only")
                                                    </span>
                                                    @if (isSelected)
                                                    {
                                                        <span class="badge bg-primary text-white" style="font-size: 0.7rem;">
                                                            <i class="bi bi-check-lg"></i> @L["Groups.SelectedBadge"]
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted small" style="font-size: 0.72rem;">@L["Users.ClickToSelect"]</span>
                                                    }
                                                </div>
                                            </button>
                                        }
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Progressive Disclosure: Custom Root Path Override -->
                    <div class="card rounded-3 p-3 mb-3 @(useCustomRootCreate ? "border-primary border-2 bg-primary-subtle bg-opacity-10" : "border bg-light")">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="fw-bold small text-dark d-flex align-items-center gap-1.5">
                                    <i class="bi @(useCustomRootCreate ? "bi-check-circle-fill text-primary" : "bi-folder-symlink text-primary")"></i>
                                    <span>@L["Users.CustomRootTitle"]</span>
                                    @if (useCustomRootCreate)
                                    {
                                        <span class="badge bg-primary text-white ms-1" style="font-size: 0.68rem;">@L["Users.EnabledBadge"]</span>
                                    }
                                </div>
                                <div class="text-muted mt-0.5" style="font-size: 0.76rem;">
                                    @L["Users.CustomRootDesc"] (<code>@($"{SshManager.SftpRoot}\\{{username}}")</code>)
                                </div>
                            </div>
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" id="chkCustomRootCreate" @bind="useCustomRootCreate" @bind:after="OnToggleCustomRootCreate" />
                            </div>
                        </div>

                        @if (useCustomRootCreate)
                        {
                            <div class="row g-2 mt-2 pt-2 border-top">
                                <div class="col-12">
                                    <label class="form-label small fw-bold mb-1">Custom Root Path</label>
                                    <div class="input-group input-group-sm">
                                        <input type="text" class="form-control font-monospace" placeholder="@L["Users.CustomRootPlaceholder"]" @bind="newUser.CustomRootPath" @bind:event="oninput" />
                                        <button class="btn btn-outline-secondary" type="button" @onclick="OpenFolderBrowserForCreate">
                                            <i class="bi bi-folder2-open"></i>
                                            <span>@L["Groups.BrowseFolderBtn"]</span>
                                        </button>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold mb-1">Access Mode</label>
                                    <select class="form-select form-select-sm" @bind="newUser.AccessMode">
                                        <option value="@SftpAccessMode.VirtualFolder">@L["Users.ModeVirtualOption"]</option>
                                        <option value="@SftpAccessMode.DirectChroot">@L["Users.ModeChrootOption"]</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold mb-1">@L["Groups.ColPermission"] (Permission)</label>
                                    <select class="form-select form-select-sm" @bind="newUser.CustomPermissionType">
                                        <option value="@SftpPermissionType.ReadWrite">@L["Users.PermRwOption"]</option>
                                        <option value="@SftpPermissionType.ReadOnly">@L["Users.PermRoOption"]</option>
                                    </select>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Live Effective Path Preview -->
                    <div class="effective-preview-box mb-4 d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <div class="small">
                            <div class="fw-bold d-flex align-items-center gap-1.5">
                                <i class="bi bi-folder-check"></i>
                                <span>@L["Users.EffectivePreviewTitle"]</span>
                            </div>
                            <div class="font-monospace fw-bold mt-0.5">
                                @GetCreateEffectivePathPreview()
                            </div>
                        </div>
                        <span class="badge bg-white text-primary border border-primary-subtle">
                            @(newUser.GroupIds.Count > 0 ? L.Get("Users.LinkedGroupsBadge", newUser.GroupIds.Count) : L["Users.PersonalFolderBadge"])
                        </span>
                    </div>

                    <!-- Step 3: Optional Key & Notes -->
                    <div class="form-step-header">
                        <div class="form-step-title">
                            <span class="form-step-badge">3</span>
                            <span>@L["Users.Step3Title"]</span>
                        </div>
                        <span class="text-muted" style="font-size: 0.72rem;">@L["Users.OptionalLater"]</span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small mb-1">@L["Users.SshKeyLabel"]</label>
                        <textarea class="form-control form-control-sm font-monospace" rows="2" placeholder="ssh-ed25519 AAAAC3NzaC1lZDI1NTE5... / ---- BEGIN SSH2 PUBLIC KEY ----" @bind="newUser.SshPublicKey"></textarea>
                    </div>

                    <div class="mb-0">
                        <label class="form-label fw-bold small mb-1">@L["Users.NotesLabel"]</label>
                        <input type="text" class="form-control form-control-sm" @bind="newUser.Notes" placeholder="@L["Users.NotesPlaceholder"]" />
                    </div>
                </div>
                <div class="modal-footer bg-light d-flex justify-content-between align-items-center">
                    <div class="small">
                        @if (IsCreateUserFormValid)
                        {
                            <span class="text-success fw-semibold d-inline-flex align-items-center gap-1">
                                <i class="bi bi-check-circle-fill"></i>
                                <span>@L["Users.CreateReady"]</span>
                            </span>
                        }
                        else
                        {
                            <span class="text-warning-emphasis d-inline-flex align-items-center gap-1">
                                <i class="bi bi-info-circle-fill"></i>
                                <span>@L["Users.CreateMissing"]</span>
                            </span>
                        }
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => isCreateModalOpen = false">@L["Common.Cancel"]</button>
                        <button type="button" class="btn btn-primary btn-sm px-3" @onclick="SubmitCreateUser" disabled="@(isSubmitting || !IsCreateUserFormValid)">
                            @if (isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                                <span>@L["Groups.Creating"]</span>
                            }
                            else
                            {
                                <i class="bi bi-check-lg"></i>
                                <span>@(IsCreateUserFormValid ? L.Get("Users.CreateSubmitBtn", newUser.Username.Trim()) : L["WebAdmins.FillComplete"])</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal: Edit User -->
@if (isEditModalOpen && editUserRequest != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title d-flex align-items-center gap-2">
                        <i class="bi bi-pencil-square text-primary"></i>
                        <span>@L.Get("Users.EditModalTitle", editUserRequest.Username)</span>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => isEditModalOpen = false"></button>
                </div>
                <div class="modal-body p-4">
                    @if (!string.IsNullOrEmpty(modalErrorMessage))
                    {
                        <div class="alert alert-danger py-2 small d-flex align-items-center gap-2 mb-3">
                            <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                            <div>@modalErrorMessage</div>
                        </div>
                    }

                    <!-- Step 1: Identity -->
                    <div class="form-step-header">
                        <div class="form-step-title">
                            <span class="form-step-badge">1</span>
                            <span>@L["Users.EditStep1Title"]</span>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small mb-1">Username</label>
                            <input type="text" class="form-control form-control-sm font-monospace" value="@editUserRequest.Username" disabled />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small mb-1">@L["Users.DisplayNameLabel"]</label>
                            <input type="text" class="form-control form-control-sm" placeholder="@L["Users.DisplayNamePlaceholder"]" @bind="editUserRequest.DisplayName" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold small mb-1">@L["Users.NotesLabel"]</label>
                            <input type="text" class="form-control form-control-sm" placeholder="@L["Users.EditNotesPlaceholder"]" @bind="editUserRequest.Notes" />
                        </div>
                    </div>

                    <!-- Step 2: Groups & Folder Access -->
                    <div class="form-step-header">
                        <div class="form-step-title">
                            <span class="form-step-badge">2</span>
                            <span>@L["Users.Step2Title"]</span>
                        </div>
                        <span class="badge bg-primary text-white" style="font-size: 0.72rem;">
                            <i class="bi bi-collection-fill"></i> @L.Get("Users.SelectedGroupsCount", editUserRequest.GroupIds.Count)
                        </span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small mb-1.5">@L["Users.AssignGroupsEditLabel"]</label>

                        <!-- Blue Highlighted Selected Groups Box -->
                        <div class="selected-items-box mb-2.5">
                            <div class="d-flex justify-content-between align-items-center mb-1.5">
                                <span class="small fw-bold text-primary d-flex align-items-center gap-1.5">
                                    <i class="bi bi-check2-square"></i>
                                    <span>@L.Get("Users.SelectedGroupsBox", editUserRequest.GroupIds.Count)</span>
                                </span>
                                @if (editUserRequest.GroupIds.Count > 0)
                                {
                                    <button type="button" class="btn btn-link btn-sm text-danger text-decoration-none p-0 small"
                                            @onclick="() => editUserRequest.GroupIds.Clear()">
                                        <i class="bi bi-x-circle"></i> @L["Groups.ClearAll"]
                                    </button>
                                }
                            </div>
                            @if (editUserRequest.GroupIds.Count == 0)
                            {
                                <div class="text-muted small py-1">
                                    @L["Users.NoGroupsSelected"]
                                </div>
                            }
                            else
                            {
                                <div class="d-flex flex-wrap gap-1.5">
                                    @foreach (var gid in editUserRequest.GroupIds.ToList())
                                    {
                                        var grpObj = availableGroups.FirstOrDefault(g => g.Id == gid);
                                        if (grpObj != null)
                                        {
                                            <span class="selected-item-pill">
                                                <i class="bi bi-folder-symlink text-primary"></i>
                                                <span>@grpObj.Name</span>
                                                <span class="text-muted font-monospace" style="font-size: 0.7rem;">(@grpObj.RootPath)</span>
                                                <button type="button" class="selected-item-remove" title="@L["Users.RemoveGroupTooltip"]"
                                                        @onclick="() => editUserRequest.GroupIds.Remove(gid)">
                                                    <i class="bi bi-x"></i>
                                                </button>
                                            </span>
                                        }
                                    }
                                </div>
                            }
