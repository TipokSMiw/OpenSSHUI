@code {
    private List<SftpUser>? users;
    private List<SftpGroup> availableGroups = new();

    private string searchTerm = "";
    private string accountTypeFilter = "";
    private string statusFilter = "";
    private string groupFilter = "";

    private string? alertMessage;
    private bool isAlertSuccess;
    private string? modalErrorMessage;

    // Create Modal state
    private bool isCreateModalOpen;
    private CreateUserRequest newUser = new();
    private string confirmPassword = "";
    private bool showCreatePassword;
    private bool useCustomRootCreate;
    private bool isSubmitting;
    private string adSearchQuery = "";
