    private async Task HandleAdSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchActiveDirectory();
        }
    }

    private async Task SearchActiveDirectory()
    {
        if (isSearchingAd) return;

        isSearchingAd = true;
        adSearchError = null;
        adSearchInfo = null;
        adSearchResults.Clear();

        try
        {
            var result = await LdapAuth.SearchAdUsersAsync(adSearchQuery);
            if (result.Success)
            {
                adSearchResults = result.Users;
                if (!adSearchResults.Any())
                {
                    adSearchInfo = result.Message;
                }
            }
            else
            {
                adSearchError = result.Message;
            }
        }
        catch (Exception ex)
        {
            adSearchError = $"เกิดข้อผิดพลาดในการค้นหา: {ex.Message}";
        }
        finally
        {
            isSearchingAd = false;
        }
    }

