        groupFilter = "";
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        users = await UserService.GetAllUsersAsync();
        availableGroups = await GroupService.GetAllGroupsAsync();

        _storageCts?.Cancel();
        _storageCts?.Dispose();
        _storageCts = new CancellationTokenSource();
        _ = LoadUserStorageAsync(users, _storageCts.Token);
    }

    private async Task LoadUserStorageAsync(List<SftpUser> userList, CancellationToken cancellationToken)
    {
        try
        {
            foreach (var u in userList)
            {
                cancellationToken.ThrowIfCancellationRequested();
                var bytes = await FileBrowser.GetTotalUserStorageBytesAsync(u.Username, cancellationToken);
                userStorageMap[u.Username] = bytes;
            }

            if (!cancellationToken.IsCancellationRequested)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Cancelled by newer LoadData or Dispose
        }
        catch (ObjectDisposedException)
        {
            // Component disposed
        }
    }

    public void Dispose()
    {
        _storageCts?.Cancel();
        _storageCts?.Dispose();
    }

    private IEnumerable<SftpUser> FilteredUsers
    {
        get
        {
            if (users == null) return Enumerable.Empty<SftpUser>();
            var q = users.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                q = q.Where(u => u.Username.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                                 u.DisplayName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(accountTypeFilter))
            {
                if (Enum.TryParse<SftpAccountType>(accountTypeFilter, out var at))
                {
                    q = q.Where(u => u.AccountType == at);
                }
            }

            if (!string.IsNullOrWhiteSpace(statusFilter))
            {
                bool active = statusFilter == "Active";
                q = q.Where(u => u.IsActive == active);
            }

            if (!string.IsNullOrWhiteSpace(groupFilter))
            {
                q = q.Where(u => u.UserGroups.Any(ug => ug.GroupId == groupFilter));
            }

            return q;
        }
    }

    private bool IsCreatePasswordMatch =>
        !string.IsNullOrWhiteSpace(newUser.Password) &&
        newUser.Password == confirmPassword;

    private bool IsCreateUserFormValid =>
        !string.IsNullOrWhiteSpace(newUser.Username) &&
        (newUser.AccountType == SftpAccountType.ActiveDirectory || IsCreatePasswordMatch);

    private bool IsResetPasswordValid =>
        !string.IsNullOrWhiteSpace(newResetPassword) &&
        newResetPassword == confirmResetPassword;

