                    </div>
                </div>
                <div class="modal-footer bg-light d-flex justify-content-between align-items-center">
                    <span class="small text-muted">@L["Users.EditImmediateNote"]</span>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => isEditModalOpen = false">@L["Common.Cancel"]</button>
                        <button type="button" class="btn btn-primary btn-sm px-3" @onclick="SubmitEditUser" disabled="@isSubmitting">
                            @if (isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                                <span>@L["Common.Saving"]</span>
                            }
                            else
                            {
                                <i class="bi bi-check-lg"></i>
                                <span>@L["Groups.SaveChangesBtn"]</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal: SSH Keys Manager -->
@if (isKeyModalOpen && selectedUser != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
