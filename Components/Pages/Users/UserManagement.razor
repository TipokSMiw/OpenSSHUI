        newUser.Username = info.SamAccountName;
        newUser.DisplayName = !string.IsNullOrWhiteSpace(info.DisplayName) ? info.DisplayName : info.SamAccountName;
        adSearchResults.Clear();
        adSearchError = null;
        adSearchInfo = null;
    }

