@page "/Error"
@using System.Diagnostics

<PageTitle>Error - OpensshUI</PageTitle>

<div class="container-fluid p-0">
    <div class="card border-danger shadow-sm rounded-3">
        <div class="card-header bg-danger text-white d-flex align-items-center gap-2">
            <i class="bi bi-exclamation-octagon-fill fs-5"></i>
            <h3 class="h5 fw-bold mb-0">เกิดข้อผิดพลาดในระบบ (System Error)</h3>
        </div>
        <div class="card-body">
            <p class="text-danger fw-semibold mb-3">ไม่สามารถประมวลผลคำขอของคุณได้ในขณะนี้ (An error occurred while processing your request.)</p>

            @if (ShowRequestId)
            {
                <p class="small mb-3">
                    <strong>Request ID:</strong> <code>@RequestId</code>
                </p>
            }

            <div class="alert alert-light border small mb-0">
                <strong class="d-block mb-1">คำแนะนำสำหรับผู้ดูแลระบบ (Development Mode):</strong>
                การสลับไปใช้โหมด <strong>Development</strong> จะแสดงรายละเอียดของข้อผิดพลาดที่ชัดเจนยิ่งขึ้นสำหรับการตรวจสอบปัญหา ทั้งนี้ไม่ควรเปิดโหมด Development ทิ้งไว้บนเซิร์ฟเวอร์ใช้งานจริง (Production)
            </div>
        </div>
    </div>
</div>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
