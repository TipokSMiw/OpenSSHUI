@page "/settings"
@rendermode InteractiveServer
@inject ILdapAuthService LdapAuth
@inject IAuditService AuditService
@inject UserSessionState SessionState

<PageTitle>Settings - OpensshUI</PageTitle>

<div class="container-fluid p-0">
    <!-- Standardized Page Header -->
    <div class="page-header">
        <div>
            <h3 class="page-title">
                <i class="bi bi-gear-fill text-primary"></i>
                <span>ตั้งค่าระบบ (System & AD/LDAP Settings)</span>
            </h3>
            <p class="text-muted small mb-0">กำหนดค่าการเชื่อมต่อ Active Directory (LDAP) และบัญชีผู้ดูแลระบบสำรอง (Fallback Local Admin)</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            @if (SessionState.CanManageSystem)
            {
                <button class="btn btn-outline-secondary btn-sm" @onclick="LoadConfig">
                    <i class="bi bi-arrow-clockwise"></i>
                    <span>รีเฟรชการตั้งค่า</span>
                </button>
            }
        </div>
    </div>

    @if (!SessionState.CanManageSystem)
    {
        <div class="alert alert-danger d-flex align-items-center gap-3 py-3 shadow-sm">
            <i class="bi bi-lock-fill fs-3"></i>
            <div>
                <h6 class="fw-bold mb-1">ปฏิเสธการเข้าถึง (Access Denied)</h6>
                <p class="small mb-0">เฉพาะผู้ดูแลระบบระดับ <strong>SuperAdmin</strong> เท่านั้นที่สามารถจัดการการตั้งค่า Active Directory (LDAP) และบัญชี Local Admin ฉุกเฉินได้ (สิทธิ์ปัจจุบันของคุณ: <strong>@SessionState.Role</strong>)</p>
            </div>
        </div>
    }
    else
    {
    @if (isUsingDefaultAdminPassword)
    {
        <div class="alert alert-warning border-warning shadow-sm d-flex align-items-center gap-3 py-3 mb-4" role="alert">
            <i class="bi bi-shield-exclamation text-warning fs-3 flex-shrink-0"></i>
            <div>
                <strong class="d-block mb-1">คำเตือนด้านความปลอดภัย: ระบบกำลังใช้รหัสผ่าน Local Admin เริ่มต้น (Default Password)</strong>
                <span class="small text-muted">เพื่อความปลอดภัยสูงสุดของเซิร์ฟเวอร์ กรุณาเปลี่ยนรหัสผ่าน Fallback Local Administrator ในการ์ดด้านขวามือทันที</span>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(alertMessage))
    {
        <div class="alert @(isAlertSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show py-2 small d-flex align-items-center gap-2" role="alert">
            <i class="bi @(isAlertSuccess ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") flex-shrink-0"></i>
            <div>@alertMessage</div>
            <button type="button" class="btn-close" @onclick="() => alertMessage = null"></button>
        </div>
    }

    @if (config == null)
    {
        <div class="text-center py-5">
            <span class="spinner-border spinner-border-sm text-primary"></span>
            <p class="text-muted small mt-2 mb-0">กำลังโหลดการตั้งค่า...</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- Active Directory / LDAP Settings -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-header bg-white border-bottom pt-3 pb-2 d-flex justify-content-between align-items-center">
                        <h6 class="fw-bold mb-0 d-flex align-items-center gap-2">
                            <i class="bi bi-diagram-3-fill text-primary"></i>
                            <span>การเชื่อมต่อ Active Directory / LDAP Server</span>
                        </h6>
                        <div class="form-check form-switch mb-0 d-flex align-items-center gap-2">
                            <input class="form-check-input mt-0" type="checkbox" id="ldapSwitch" @bind="config.IsLdapEnabled" />
                            <label class="form-check-label fw-bold small" for="ldapSwitch">เปิดใช้งาน AD</label>
                        </div>
                    </div>
                    <div class="card-body">
                        @if (!config.IsLdapEnabled)
                        {
                            <div class="alert alert-secondary py-2 px-3 small d-flex align-items-center justify-content-between gap-2 mb-3">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-info-circle-fill text-secondary"></i>
                                    <span>ขณะนี้<strong>ปิดใช้งาน Active Directory</strong> ระบบจะอนุญาตเฉพาะบัญชี <strong>Local Admin ฉุกเฉิน</strong> ด้านขวามือเท่านั้น</span>
                                </div>
                                <button type="button" class="btn btn-sm btn-outline-primary py-0.5 px-2 text-nowrap" @onclick="() => config.IsLdapEnabled = true">
                                    เปิดใช้งาน AD
                                </button>
                            </div>
                        }

                        <div class="@(!config.IsLdapEnabled ? "form-section-dimmed" : "")">
                            <!-- Step 1: Host & SSL -->
                            <div class="form-step-header">
                                <div class="form-step-title">
                                    <span class="form-step-badge">1</span>
                                    <span>เซิร์ฟเวอร์และความปลอดภัย (Domain Controller & SSL)</span>
                                </div>
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle" style="font-size: 0.7rem;">การเชื่อมต่อเครือข่าย</span>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-8">
                                    <label class="form-label small fw-bold mb-1">LDAP / Domain Controller Host <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control form-control-sm font-monospace" placeholder="เช่น 192.168.1.10 หรือ dc01.corp.local" @bind="config.Server" @bind:event="oninput" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-bold mb-1">Port <span class="text-danger">*</span></label>
                                    <input type="number" class="form-control form-control-sm font-monospace" placeholder="389 หรือ 636" @bind="config.Port" />
                                </div>
                            </div>

                            <div class="mb-4 p-2.5 bg-light rounded border">
                                <div class="form-check mb-1">
                                    <input class="form-check-input" type="checkbox" id="sslCheck" @bind="config.UseSsl" />
                                    <label class="form-check-label small fw-bold" for="sslCheck">
                                        ใช้งาน SSL/TLS (LDAPS - แนะนำสำหรับ Port 636)
                                    </label>
                                </div>
                                @if (config.UseSsl)
                                {
                                    <div class="form-check ms-3 mt-1">
                                        <input class="form-check-input" type="checkbox" id="trustCertCheck" @bind="config.TrustSslCertificates" />
                                        <label class="form-check-label small text-muted" for="trustCertCheck">
                                            ยอมรับใบรับรอง SSL ภายในโดเมน (Enterprise CA / Self-Signed Certificate)
                                        </label>
                                    </div>
                                }
                                @if (config.UseSsl && config.Port == 389)
                                {
                                    <div class="small text-warning-emphasis mt-1.5 d-flex align-items-center gap-1.5 ms-1">
                                        <i class="bi bi-exclamation-triangle-fill"></i>
                                        <span>เปิดใช้ SSL แต่เลือกพอร์ต 389:</span>
                                        <button type="button" class="auto-fill-chip" @onclick="() => config.Port = 636">
                                            <i class="bi bi-magic"></i>
                                            <span>สลับเป็นพอร์ต 636</span>
                                        </button>
                                    </div>
                                }
                                else if (!config.UseSsl && config.Port == 636)
                                {
                                    <div class="small text-warning-emphasis mt-1.5 d-flex align-items-center gap-1.5 ms-1">
                                        <i class="bi bi-exclamation-triangle-fill"></i>
                                        <span>ปิด SSL แต่เลือกพอร์ต 636:</span>
                                        <button type="button" class="auto-fill-chip" @onclick="() => config.Port = 389">
                                            <i class="bi bi-magic"></i>
                                            <span>สลับเป็นพอร์ต 389</span>
                                        </button>
                                    </div>
                                }
                            </div>

                            <!-- Step 2: Domain & Base DN -->
                            <div class="form-step-header">
                                <div class="form-step-title">
                                    <span class="form-step-badge">2</span>
                                    <span>ชื่อโดเมนและโครงสร้างค้นหา (Domain & Base DN)</span>
                                </div>
                                <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle" style="font-size: 0.7rem;">ตัวช่วยสร้าง Base DN อัตโนมัติ</span>
                            </div>

                            <div class="row g-3 mb-4">
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold mb-1">Domain Name <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control form-control-sm font-monospace" placeholder="เช่น corp.local หรือ example.com" @bind="config.Domain" @bind:event="oninput" />
                                </div>
                                <div class="col-md-6">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <label class="form-label small fw-bold mb-0">Base DN <span class="text-danger">*</span></label>
                                        @if (!string.IsNullOrEmpty(SuggestedBaseDn) && !string.Equals(config.BaseDn, SuggestedBaseDn, StringComparison.OrdinalIgnoreCase))
                                        {
                                            <button type="button" class="auto-fill-chip" title="คลิกเพื่อเติมค่า Base DN จากชื่อ Domain อัตโนมัติ" @onclick="ApplySuggestedBaseDn">
                                                <i class="bi bi-lightning-charge-fill"></i>
                                                <span>เติม: @SuggestedBaseDn</span>
                                            </button>
                                        }
                                    </div>
                                    <input type="text" class="form-control form-control-sm font-monospace" placeholder="เช่น DC=corp,DC=local" @bind="config.BaseDn" @bind:event="oninput" />
                                </div>
                            </div>

                            <!-- Step 3: Bind Account & Admin Group -->
                            <div class="form-step-header">
                                <div class="form-step-title">
                                    <span class="form-step-badge">3</span>
                                    <span>บัญชีสำหรับค้นหา AD และกลุ่มผู้ดูแลระบบ (Service Bind & Admin Role)</span>
                                </div>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold mb-1">Admin Bind Account (DN หรือ user@domain)</label>
                                    <input type="text" class="form-control form-control-sm font-monospace" placeholder="เช่น sftp_svc@corp.local" @bind="config.EncryptedBindDn" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold d-flex align-items-center justify-content-between mb-1">
                                        <span>Bind Account Password</span>
                                        @if (hasSavedBindPassword)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle font-monospace" style="font-size: 0.7rem;">
                                                <i class="bi bi-shield-check"></i> มีรหัสผ่านในระบบแล้ว
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle font-monospace" style="font-size: 0.7rem;">
                                                <i class="bi bi-shield-slash"></i> ยังไม่ได้ตั้งรหัสผ่าน
                                            </span>
                                        }
                                    </label>
                                    <div class="input-group input-group-sm">
                                        <input type="@(showBindPassword ? "text" : "password")" class="form-control" placeholder="@(hasSavedBindPassword ? "เว้นว่างไว้หากใช้รหัสผ่านเดิมที่บันทึกอยู่" : "ระบุรหัสผ่านของ Bind Account")" @bind="newBindPassword" @bind:event="oninput" />
                                        <button class="btn btn-outline-secondary" type="button" title="@(showBindPassword ? "ซ่อนรหัสผ่าน" : "แสดงรหัสผ่าน")" @onclick="() => showBindPassword = !showBindPassword">
                                            <i class="bi @(showBindPassword ? "bi-eye-slash" : "bi-eye")"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-4">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <label class="form-label small fw-bold mb-0">Allowed Admin Group Name (Active Directory)</label>
                                    <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle" style="font-size: 0.7rem;">ไม่บังคับ</span>
                                </div>
                                <input type="text" class="form-control form-control-sm" placeholder="เช่น Domain Admins หรือ SFTP-Admins (เว้นว่างไว้เพื่ออนุญาตทุกคนใน AD)" @bind="config.AdminGroup" />
                                <small class="text-muted">เฉพาะสมาชิกใน Group นี้เท่านั้นที่จะมีสิทธิ์เข้าสู่ระบบ Web UI เพื่อจัดการ SFTP</small>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 pt-3 border-top">
                            <div class="small">
                                @if (testResult?.Success == true)
                                {
                                    <span class="text-success fw-bold d-inline-flex align-items-center gap-1">
                                        <i class="bi bi-check-circle-fill"></i>
                                        <span>ตรวจสอบการเชื่อมต่อผ่านแล้ว พร้อมบันทึกการตั้งค่า</span>
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted d-inline-flex align-items-center gap-1">
                                        <i class="bi bi-lightbulb text-warning"></i>
                                        <span>แนะนำ: กด <strong>ขั้นที่ 1: ทดสอบเชื่อมต่อ</strong> ก่อนบันทึก</span>
                                    </span>
                                }
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <button class="btn btn-outline-primary btn-sm" @onclick="TestLdapConnection" disabled="@(isTesting || string.IsNullOrWhiteSpace(config.Server))">
                                    @if (isTesting)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                        <span>กำลังตรวจสอบ...</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-broadcast me-1"></i>
                                        <span>ขั้นที่ 1: ทดสอบเชื่อมต่อ LDAP</span>
                                    }
                                </button>
                                <button class="btn @(testResult?.Success == true ? "btn-success" : "btn-primary") btn-sm px-3" @onclick="SaveSettings" disabled="@isSaving">
                                    @if (isSaving)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                        <span>กำลังบันทึก...</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-check-lg me-1"></i>
                                        <span>ขั้นที่ 2: บันทึกการตั้งค่า</span>
                                    }
                                </button>
                            </div>
                        </div>

                        @if (testResult != null)
                        {
                            <div class="card border rounded-3 mt-3 shadow-sm @(testResult.Success ? "border-success-subtle bg-success-subtle bg-opacity-10" : "border-danger-subtle bg-danger-subtle bg-opacity-10")">
                                <div class="card-body p-3">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <h6 class="fw-bold mb-0 d-flex align-items-center gap-2 @(testResult.Success ? "text-success" : "text-danger")">
                                            <i class="bi @(testResult.Success ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill")"></i>
                                            <span>ผลการตรวจสอบการเชื่อมต่อ (Connection Diagnostics)</span>
                                        </h6>
                                        <button type="button" class="btn-close btn-sm" @onclick="() => testResult = null"></button>
                                    </div>
                                    <p class="small mb-3 @(testResult.Success ? "text-success-emphasis" : "text-danger-emphasis")">@testResult.Message</p>

                                    <div class="row g-2 mb-2">
                                        <div class="col-6 col-md-3">
                                            <div class="border rounded p-2 text-center bg-white shadow-xs">
                                                <small class="text-muted d-block mb-1">Host & Port (TCP)</small>
                                                @if (testResult.HostReachable)
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle small"><i class="bi bi-check-lg"></i> เข้าถึงได้</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle small"><i class="bi bi-x-lg"></i> ล้มเหลว</span>
                                                }
                                            </div>
                                        </div>
                                        <div class="col-6 col-md-3">
                                            <div class="border rounded p-2 text-center bg-white shadow-xs">
                                                <small class="text-muted d-block mb-1">Bind Authentication</small>
                                                @if (testResult.BindSuccessful)
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle small"><i class="bi bi-check-lg"></i> สำเร็จ</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle small"><i class="bi bi-x-lg"></i> ล้มเหลว</span>
                                                }
                                            </div>
                                        </div>
                                        <div class="col-6 col-md-3">
                                            <div class="border rounded p-2 text-center bg-white shadow-xs">
                                                <small class="text-muted d-block mb-1">Base DN</small>
                                                @if (testResult.BaseDnVerified == true)
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle small"><i class="bi bi-check-lg"></i> ตรวจพบ</span>
                                                }
                                                else if (testResult.BaseDnVerified == false)
                                                {
                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle small"><i class="bi bi-x-lg"></i> ไม่พบ</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle small">- ไม่ได้ระบุ -</span>
                                                }
                                            </div>
                                        </div>
                                        <div class="col-6 col-md-3">
                                            <div class="border rounded p-2 text-center bg-white shadow-xs">
                                                <small class="text-muted d-block mb-1">Admin Group</small>
                                                @if (testResult.AdminGroupVerified == true)
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle small"><i class="bi bi-check-lg"></i> พบกลุ่มใน AD</span>
                                                }
                                                else if (testResult.AdminGroupVerified == false)
                                                {
                                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle small"><i class="bi bi-exclamation-triangle"></i> ไม่พบกลุ่ม</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle small">- ไม่ได้ระบุ -</span>
                                                }
                                            </div>
                                        </div>
                                    </div>

                                    @if (testResult.Details.Any())
                                    {
                                        <div class="bg-white border rounded p-2 small mt-2">
                                            <div class="fw-bold text-muted mb-1 font-monospace" style="font-size: 0.75rem;">ขั้นตอนการตรวจสอบ (Diagnostic Details):</div>
                                            <ul class="mb-0 ps-3 font-monospace" style="font-size: 0.75rem;">
                                                @foreach (var detail in testResult.Details)
                                                {
                                                    <li>@detail</li>
                                                }
                                            </ul>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Fallback Local Admin Settings -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-header bg-white border-bottom pt-3 pb-2">
                        <h6 class="fw-bold mb-0 d-flex align-items-center gap-2">
                            <i class="bi bi-shield-lock-fill text-primary"></i>
                            <span>บัญชี Local Admin ฉุกเฉิน</span>
                        </h6>
                    </div>
                    <div class="card-body">
                        <p class="small text-muted mb-3">
                            บัญชีนี้ใช้สำหรับกรณีฉุกเฉินเมื่อเซิร์ฟเวอร์ Active Directory ออฟไลน์ หรือยังไม่ได้ตั้งค่า AD
                        </p>

                        <div class="mb-3">
                            <label class="form-label small fw-bold mb-1">Admin Username <span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-sm font-monospace" placeholder="เช่น admin" @bind="config.FallbackAdminUsername" @bind:event="oninput" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold mb-1">ตั้งรหัสผ่านใหม่ (PBKDF2 SHA-256) <span class="text-danger">*</span></label>
                            <div class="input-group input-group-sm">
                                <input type="@(showFallbackPassword ? "text" : "password")" class="form-control" placeholder="ระบุรหัสผ่านใหม่..." @bind="newFallbackAdminPassword" @bind:event="oninput" />
                                <button class="btn btn-outline-secondary" type="button" title="@(showFallbackPassword ? "ซ่อนรหัสผ่าน" : "แสดงรหัสผ่าน")" @onclick="() => showFallbackPassword = !showFallbackPassword">
                                    <i class="bi @(showFallbackPassword ? "bi-eye-slash" : "bi-eye")"></i>
                                </button>
                            </div>
                        </div>

                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label small fw-bold mb-0">ยืนยันรหัสผ่านใหม่ <span class="text-danger">*</span></label>
                                @if (!string.IsNullOrEmpty(newFallbackAdminPassword) || !string.IsNullOrEmpty(confirmFallbackAdminPassword))
                                {
                                    @if (IsFallbackPasswordValid)
                                    {
                                        <span class="text-success small fw-bold d-inline-flex align-items-center gap-1">
                                            <i class="bi bi-check-circle-fill"></i>
                                            <span>รหัสผ่านตรงกัน</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-danger small fw-bold d-inline-flex align-items-center gap-1">
                                            <i class="bi bi-x-circle-fill"></i>
                                            <span>รหัสผ่านไม่ตรงกัน</span>
                                        </span>
                                    }
                                }
                            </div>
                            <input type="@(showFallbackPassword ? "text" : "password")" class="form-control form-control-sm" placeholder="พิมพ์รหัสผ่านใหม่อีกครั้ง..." @bind="confirmFallbackAdminPassword" @bind:event="oninput" />
                        </div>

                        <button class="btn btn-primary btn-sm w-100 fw-bold justify-content-center" @onclick="ChangeFallbackAdminPassword" disabled="@(!IsFallbackPasswordValid)">
                            <i class="bi bi-key-fill"></i>
                            <span>@(IsFallbackPasswordValid ? "บันทึกรหัสผ่าน Local Admin ใหม่" : "กรอกรหัสผ่านให้ตรงกันเพื่อบันทึก")</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
    }
</div>

@code {
    private LdapConfig? config;
    private string newBindPassword = "";
    private string newFallbackAdminPassword = "";
    private string confirmFallbackAdminPassword = "";

    private bool isTesting;
    private bool isSaving;
    private bool showBindPassword;
    private bool showFallbackPassword;
    private string? alertMessage;
    private bool isAlertSuccess;
    private bool isUsingDefaultAdminPassword;
    private bool hasSavedBindPassword;
    private LdapConnectionTestResult? testResult;

    private bool IsFallbackPasswordValid =>
        !string.IsNullOrWhiteSpace(newFallbackAdminPassword) &&
        newFallbackAdminPassword == confirmFallbackAdminPassword;

    private string SuggestedBaseDn
    {
        get
        {
            if (config == null || string.IsNullOrWhiteSpace(config.Domain)) return string.Empty;
            var parts = config.Domain.Trim().Split('.', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            if (parts.Length == 0) return string.Empty;
            return string.Join(",", parts.Select(p => $"DC={p}"));
        }
    }

    private void ApplySuggestedBaseDn()
    {
        if (config != null && !string.IsNullOrEmpty(SuggestedBaseDn))
        {
            config.BaseDn = SuggestedBaseDn;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadConfig();
    }

    private async Task LoadConfig()
    {
        if (!SessionState.CanManageSystem) return;
        config = await LdapAuth.GetConfigAsync();
        isUsingDefaultAdminPassword = await LdapAuth.IsUsingDefaultFallbackPasswordAsync();
        hasSavedBindPassword = config != null && !string.IsNullOrEmpty(config.EncryptedBindPassword);
    }

    private async Task TestLdapConnection()
    {
        if (!SessionState.CanManageSystem || config == null) return;
        isTesting = true;
        alertMessage = null;
        testResult = null;

        testResult = await LdapAuth.TestConnectionAsync(config, string.IsNullOrEmpty(newBindPassword) ? null : newBindPassword);
        isTesting = false;
        SetAlert(testResult.Message, testResult.Success);
    }

    private async Task SaveSettings()
    {
        if (!SessionState.CanManageSystem || config == null) return;
        isSaving = true;

        var op = string.IsNullOrEmpty(SessionState.CurrentUsername) ? "admin" : SessionState.CurrentUsername;
        await LdapAuth.SaveConfigAsync(config, string.IsNullOrEmpty(newBindPassword) ? null : newBindPassword);
        await AuditService.LogAsync("CONFIG_UPDATE", "Updated LDAP and system settings", true, op);

        newBindPassword = "";
        isSaving = false;
        SetAlert("บันทึกการตั้งค่าระบบเรียบร้อยแล้ว", true);
        await LoadConfig();
    }

    private async Task ChangeFallbackAdminPassword()
    {
        if (!SessionState.CanManageSystem || config == null) return;

        if (string.IsNullOrWhiteSpace(newFallbackAdminPassword))
        {
            SetAlert("กรุณาระบุรหัสผ่านใหม่", false);
            return;
        }

        if (newFallbackAdminPassword != confirmFallbackAdminPassword)
        {
            SetAlert("รหัสผ่านใหม่และการยืนยันไม่ตรงกัน", false);
            return;
        }

        var op = string.IsNullOrEmpty(SessionState.CurrentUsername) ? "admin" : SessionState.CurrentUsername;
        await LdapAuth.SaveConfigAsync(config, newFallbackAdminPassword: newFallbackAdminPassword);
        await AuditService.LogAsync("ADMIN_PASSWORD_CHANGE", "Changed fallback local administrator password", true, op);

        newFallbackAdminPassword = "";
        confirmFallbackAdminPassword = "";
        SetAlert("เปลี่ยนรหัสผ่าน Local Admin เรียบร้อยแล้ว", true);
        isUsingDefaultAdminPassword = await LdapAuth.IsUsingDefaultFallbackPasswordAsync();
    }

    private void SetAlert(string msg, bool success)
    {
        alertMessage = msg;
        isAlertSuccess = success;
    }
}
