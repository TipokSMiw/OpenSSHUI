@page "/settings"
@rendermode InteractiveServer
@inject ILdapAuthService LdapAuth
@inject IAuditService AuditService
@inject UserSessionState SessionState

<PageTitle>Settings - OpensshUI</PageTitle>

<div class="container-fluid p-0">
    <!-- Standardized Page Header -->
    <div class="page-header">
        <div>
            <h3 class="page-title">
                <i class="bi bi-gear-fill text-primary"></i>
                <span>ตั้งค่าระบบ (System & AD/LDAP Settings)</span>
            </h3>
            <p class="text-muted small mb-0">กำหนดค่าการเชื่อมต่อ Active Directory (LDAP) และบัญชีผู้ดูแลระบบสำรอง (Fallback Local Admin)</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-outline-secondary btn-sm" @onclick="LoadConfig">
                <i class="bi bi-arrow-clockwise"></i>
                <span>รีเฟรชการตั้งค่า</span>
            </button>
        </div>
    </div>

    @if (isUsingDefaultAdminPassword)
    {
        <div class="alert alert-warning border-warning shadow-sm d-flex align-items-center gap-3 py-3 mb-4" role="alert">
            <i class="bi bi-shield-exclamation text-warning fs-3 flex-shrink-0"></i>
            <div>
                <strong class="d-block mb-1">คำเตือนด้านความปลอดภัย: ระบบกำลังใช้รหัสผ่าน Local Admin เริ่มต้น (Default Password)</strong>
                <span class="small text-muted">เพื่อความปลอดภัยสูงสุดของเซิร์ฟเวอร์ กรุณาเปลี่ยนรหัสผ่าน Fallback Local Administrator ในการ์ดด้านขวามือทันที</span>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(alertMessage))
    {
        <div class="alert @(isAlertSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show py-2 small d-flex align-items-center gap-2" role="alert">
            <i class="bi @(isAlertSuccess ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") flex-shrink-0"></i>
            <div>@alertMessage</div>
            <button type="button" class="btn-close" @onclick="() => alertMessage = null"></button>
        </div>
    }

    @if (config == null)
    {
        <div class="text-center py-5">
            <span class="spinner-border spinner-border-sm text-primary"></span>
            <p class="text-muted small mt-2 mb-0">กำลังโหลดการตั้งค่า...</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- Active Directory / LDAP Settings -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-header bg-white border-bottom pt-3 pb-2 d-flex justify-content-between align-items-center">
                        <h6 class="fw-bold mb-0 d-flex align-items-center gap-2">
                            <i class="bi bi-diagram-3-fill text-primary"></i>
                            <span>การเชื่อมต่อ Active Directory / LDAP Server</span>
                        </h6>
                        <div class="form-check form-switch mb-0 d-flex align-items-center gap-2">
                            <input class="form-check-input mt-0" type="checkbox" id="ldapSwitch" @bind="config.IsLdapEnabled" />
                            <label class="form-check-label fw-bold small" for="ldapSwitch">เปิดใช้งาน AD</label>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row g-3 mb-3">
                            <div class="col-md-8">
                                <label class="form-label small fw-bold">LDAP / Domain Controller Host</label>
                                <input type="text" class="form-control form-control-sm" placeholder="เช่น 192.168.1.10 หรือ dc01.corp.local" @bind="config.Server" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Port</label>
                                <input type="number" class="form-control form-control-sm" placeholder="389 หรือ 636" @bind="config.Port" />
                            </div>
                        </div>

                        <div class="mb-3 p-2.5 bg-light rounded border">
                            <div class="form-check mb-1">
                                <input class="form-check-input" type="checkbox" id="sslCheck" @bind="config.UseSsl" />
                                <label class="form-check-label small fw-bold" for="sslCheck">
                                    ใช้งาน SSL/TLS (LDAPS - แนะนำสำหรับ Port 636)
                                </label>
                            </div>
                            @if (config.UseSsl)
                            {
                                <div class="form-check ms-3 mt-1">
                                    <input class="form-check-input" type="checkbox" id="trustCertCheck" @bind="config.TrustSslCertificates" />
                                    <label class="form-check-label small text-muted" for="trustCertCheck">
                                        ยอมรับใบรับรอง SSL ภายในโดเมน (Enterprise CA / Self-Signed Certificate)
                                    </label>
                                </div>
                            }
                            @if (config.UseSsl && config.Port == 389)
                            {
                                <div class="small text-warning-emphasis mt-1.5 d-flex align-items-center gap-1.5 ms-1">
                                    <i class="bi bi-exclamation-triangle-fill"></i>
                                    <span>เปิดใช้ SSL แต่เลือกพอร์ต 389:</span>
                                    <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none" @onclick="() => config.Port = 636">สลับเป็นพอร์ต 636</button>
                                </div>
                            }
                            else if (!config.UseSsl && config.Port == 636)
                            {
                                <div class="small text-warning-emphasis mt-1.5 d-flex align-items-center gap-1.5 ms-1">
                                    <i class="bi bi-exclamation-triangle-fill"></i>
                                    <span>ปิด SSL แต่เลือกพอร์ต 636:</span>
                                    <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none" @onclick="() => config.Port = 389">สลับเป็นพอร์ต 389</button>
                                </div>
                            }
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Domain Name</label>
                                <input type="text" class="form-control form-control-sm" placeholder="เช่น corp.local หรือ example.com" @bind="config.Domain" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Base DN</label>
                                <input type="text" class="form-control form-control-sm" placeholder="เช่น DC=corp,DC=local" @bind="config.BaseDn" />
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Admin Bind Account (DN หรือ username@domain)</label>
                                <input type="text" class="form-control form-control-sm" placeholder="เช่น sftp_svc@corp.local" @bind="config.EncryptedBindDn" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold d-flex align-items-center justify-content-between">
                                    <span>Bind Account Password</span>
                                    @if (hasSavedBindPassword)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle font-monospace" style="font-size: 0.7rem;">
                                            <i class="bi bi-shield-check"></i> บันทึกรหัสผ่านแล้ว
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle font-monospace" style="font-size: 0.7rem;">
                                            <i class="bi bi-shield-slash"></i> ยังไม่มีรหัสผ่านในระบบ
                                        </span>
                                    }
                                </label>
                                <input type="password" class="form-control form-control-sm" placeholder="กรอกเฉพาะเมื่อต้องการตั้ง/เปลี่ยนรหัสผ่าน" @bind="newBindPassword" />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label small fw-bold">Allowed Admin Group Name (Active Directory)</label>
                            <input type="text" class="form-control form-control-sm" placeholder="เช่น Domain Admins หรือ SFTP-Admins (เว้นว่างไว้เพื่ออนุญาตทุกคนใน AD)" @bind="config.AdminGroup" />
                            <small class="text-muted">เฉพาะสมาชิกใน Group นี้เท่านั้นที่จะมีสิทธิ์เข้าสู่ระบบ Web UI เพื่อจัดการ SFTP</small>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <button class="btn btn-outline-primary btn-sm" @onclick="TestLdapConnection" disabled="@isTesting">
                                @if (isTesting)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                    <span>กำลังตรวจสอบ...</span>
                                }
                                else
                                {
                                    <i class="bi bi-broadcast me-1"></i>
                                    <span>ทดสอบเชื่อมต่อ LDAP</span>
                                }
                            </button>
                            <button class="btn btn-primary btn-sm" @onclick="SaveSettings" disabled="@isSaving">
                                @if (isSaving)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                    <span>กำลังบันทึก...</span>
                                }
                                else
                                {
                                    <i class="bi bi-check-lg me-1"></i>
                                    <span>บันทึกการตั้งค่า</span>
                                }
                            </button>
                        </div>

                        @if (testResult != null)
                        {
                            <div class="card border rounded-3 mt-3 shadow-sm @(testResult.Success ? "border-success-subtle bg-success-subtle bg-opacity-10" : "border-danger-subtle bg-danger-subtle bg-opacity-10")">
                                <div class="card-body p-3">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <h6 class="fw-bold mb-0 d-flex align-items-center gap-2 @(testResult.Success ? "text-success" : "text-danger")">
                                            <i class="bi @(testResult.Success ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill")"></i>
                                            <span>ผลการตรวจสอบการเชื่อมต่อ (Connection Diagnostics)</span>
                                        </h6>
                                        <button type="button" class="btn-close btn-sm" @onclick="() => testResult = null"></button>
                                    </div>
                                    <p class="small mb-3 @(testResult.Success ? "text-success-emphasis" : "text-danger-emphasis")">@testResult.Message</p>

                                    <div class="row g-2 mb-2">
                                        <div class="col-6 col-md-3">
                                            <div class="border rounded p-2 text-center bg-white shadow-xs">
                                                <small class="text-muted d-block mb-1">Host & Port (TCP)</small>
                                                @if (testResult.HostReachable)
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle small"><i class="bi bi-check-lg"></i> เข้าถึงได้</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle small"><i class="bi bi-x-lg"></i> ล้มเหลว</span>
                                                }
                                            </div>
                                        </div>
                                        <div class="col-6 col-md-3">
                                            <div class="border rounded p-2 text-center bg-white shadow-xs">
                                                <small class="text-muted d-block mb-1">Bind Authentication</small>
                                                @if (testResult.BindSuccessful)
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle small"><i class="bi bi-check-lg"></i> สำเร็จ</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle small"><i class="bi bi-x-lg"></i> ล้มเหลว</span>
                                                }
                                            </div>
                                        </div>
                                        <div class="col-6 col-md-3">
                                            <div class="border rounded p-2 text-center bg-white shadow-xs">
                                                <small class="text-muted d-block mb-1">Base DN</small>
                                                @if (testResult.BaseDnVerified == true)
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle small"><i class="bi bi-check-lg"></i> ตรวจพบ</span>
                                                }
                                                else if (testResult.BaseDnVerified == false)
                                                {
                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle small"><i class="bi bi-x-lg"></i> ไม่พบ</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle small">- ไม่ได้ระบุ -</span>
                                                }
                                            </div>
                                        </div>
                                        <div class="col-6 col-md-3">
                                            <div class="border rounded p-2 text-center bg-white shadow-xs">
                                                <small class="text-muted d-block mb-1">Admin Group</small>
                                                @if (testResult.AdminGroupVerified == true)
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle small"><i class="bi bi-check-lg"></i> พบกลุ่มใน AD</span>
                                                }
                                                else if (testResult.AdminGroupVerified == false)
                                                {
                                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle small"><i class="bi bi-exclamation-triangle"></i> ไม่พบกลุ่ม</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle small">- ไม่ได้ระบุ -</span>
                                                }
                                            </div>
                                        </div>
                                    </div>

                                    @if (testResult.Details.Any())
                                    {
                                        <div class="bg-white border rounded p-2 small mt-2">
                                            <div class="fw-bold text-muted mb-1 font-monospace" style="font-size: 0.75rem;">ขั้นตอนการตรวจสอบ (Diagnostic Details):</div>
                                            <ul class="mb-0 ps-3 font-monospace" style="font-size: 0.75rem;">
                                                @foreach (var detail in testResult.Details)
                                                {
                                                    <li>@detail</li>
                                                }
                                            </ul>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Fallback Local Admin Settings -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-header bg-white border-bottom pt-3 pb-2">
                        <h6 class="fw-bold mb-0 d-flex align-items-center gap-2">
                            <i class="bi bi-shield-lock-fill text-primary"></i>
                            <span>บัญชี Local Admin ฉุกเฉิน</span>
                        </h6>
                    </div>
                    <div class="card-body">
                        <p class="small text-muted mb-3">
                            บัญชีนี้ใช้สำหรับกรณีฉุกเฉินเมื่อเซิร์ฟเวอร์ Active Directory ออฟไลน์ หรือยังไม่ได้ตั้งค่า AD
                        </p>

                        <div class="mb-3">
                            <label class="form-label small fw-bold">Admin Username</label>
                            <input type="text" class="form-control form-control-sm" @bind="config.FallbackAdminUsername" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold">ตั้งรหัสผ่านใหม่ (PBKDF2 SHA-256)</label>
                            <input type="password" class="form-control form-control-sm" placeholder="รหัสผ่านใหม่" @bind="newFallbackAdminPassword" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold">ยืนยันรหัสผ่านใหม่</label>
                            <input type="password" class="form-control form-control-sm" placeholder="ยืนยันรหัสผ่าน" @bind="confirmFallbackAdminPassword" />
                        </div>

                        <button class="btn btn-warning btn-sm w-100 fw-bold text-dark justify-content-center" @onclick="ChangeFallbackAdminPassword">
                            <i class="bi bi-key-fill"></i>
                            <span>เปลี่ยนรหัสผ่าน Local Admin</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private LdapConfig? config;
    private string newBindPassword = "";
    private string newFallbackAdminPassword = "";
    private string confirmFallbackAdminPassword = "";

    private bool isTesting;
    private bool isSaving;
    private string? alertMessage;
    private bool isAlertSuccess;
    private bool isUsingDefaultAdminPassword;
    private bool hasSavedBindPassword;
    private LdapConnectionTestResult? testResult;

    protected override async Task OnInitializedAsync()
    {
        await LoadConfig();
    }

    private async Task LoadConfig()
    {
        config = await LdapAuth.GetConfigAsync();
        isUsingDefaultAdminPassword = await LdapAuth.IsUsingDefaultFallbackPasswordAsync();
        hasSavedBindPassword = config != null && !string.IsNullOrEmpty(config.EncryptedBindPassword);
    }

    private async Task TestLdapConnection()
    {
        if (config == null) return;
        isTesting = true;
        alertMessage = null;
        testResult = null;

        testResult = await LdapAuth.TestConnectionAsync(config, string.IsNullOrEmpty(newBindPassword) ? null : newBindPassword);
        isTesting = false;
        SetAlert(testResult.Message, testResult.Success);
    }

    private async Task SaveSettings()
    {
        if (config == null) return;
        isSaving = true;

        var op = string.IsNullOrEmpty(SessionState.CurrentUsername) ? "admin" : SessionState.CurrentUsername;
        await LdapAuth.SaveConfigAsync(config, string.IsNullOrEmpty(newBindPassword) ? null : newBindPassword);
        await AuditService.LogAsync("CONFIG_UPDATE", "Updated LDAP and system settings", true, op);

        newBindPassword = "";
        isSaving = false;
        SetAlert("บันทึกการตั้งค่าระบบเรียบร้อยแล้ว", true);
        await LoadConfig();
    }

    private async Task ChangeFallbackAdminPassword()
    {
        if (config == null) return;

        if (string.IsNullOrWhiteSpace(newFallbackAdminPassword))
        {
            SetAlert("กรุณาระบุรหัสผ่านใหม่", false);
            return;
        }

        if (newFallbackAdminPassword != confirmFallbackAdminPassword)
        {
            SetAlert("รหัสผ่านใหม่และการยืนยันไม่ตรงกัน", false);
            return;
        }

        var op = string.IsNullOrEmpty(SessionState.CurrentUsername) ? "admin" : SessionState.CurrentUsername;
        await LdapAuth.SaveConfigAsync(config, newFallbackAdminPassword: newFallbackAdminPassword);
        await AuditService.LogAsync("ADMIN_PASSWORD_CHANGE", "Changed fallback local administrator password", true, op);

        newFallbackAdminPassword = "";
        confirmFallbackAdminPassword = "";
        SetAlert("เปลี่ยนรหัสผ่าน Local Admin เรียบร้อยแล้ว", true);
        isUsingDefaultAdminPassword = await LdapAuth.IsUsingDefaultFallbackPasswordAsync();
    }

    private void SetAlert(string msg, bool success)
    {
        alertMessage = msg;
        isAlertSuccess = success;
    }
}
